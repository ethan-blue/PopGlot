<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PopGlot.Windows.CliTests</AssemblyName>
    <RustTestProfile>debug</RustTestProfile>
    <RustTestProfile Condition="'$(Configuration)' == 'Release'">release</RustTestProfile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../apps/PopGlot.Windows/PopGlot.Windows.csproj" /></ItemGroup>
  <Target Name="CopyCore" AfterTargets="Build">
    <Copy SourceFiles="../../target/$(RustTestProfile)/popglot_ffi.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
