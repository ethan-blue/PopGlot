<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType>
  <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  <UseWPF>true</UseWPF>
  <AssemblyName>PopGlot.Windows.LiveChecks</AssemblyName>
 </PropertyGroup>
 <ItemGroup><ProjectReference Include="../../apps/PopGlot.Windows/PopGlot.Windows.csproj"/></ItemGroup>
 <Target Name="CopyNativeCore" AfterTargets="Build">
  <Copy SourceFiles="../../target/$(Configuration.ToLower())/popglot_ffi.dll" DestinationFolder="$(OutDir)" Condition="Exists('../../target/$(Configuration.ToLower())/popglot_ffi.dll')"/>
 </Target>
</Project>
