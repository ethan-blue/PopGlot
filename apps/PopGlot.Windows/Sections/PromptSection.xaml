<UserControl x:Class="PopGlot.Windows.Sections.PromptSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">
    <UserControl.Resources>
        <!-- 行卡片列表项：内容自绘，这里只提供键盘焦点与悬停反馈。 -->
        <Style x:Key="PromptListItem" TargetType="Border">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
        </Style>
        <Style x:Key="PromptSectionCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="PromptTextField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PromptSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CounterText" TargetType="TextBlock" BasedOn="{StaticResource Metadata}">
            <Setter Property="Margin" Value="2,5,0,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="AutomationProperties.Name" Value="字段用量计数" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="翻译与提示词" Style="{StaticResource PageTitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- ==================== 模板列表 ==================== -->
            <Border x:Name="ListHost" Padding="0" Background="Transparent" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 当前生效模板卡 -->
                    <Border Grid.Row="0" Style="{StaticResource InlineCard}" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="当前翻译风格" Style="{StaticResource PromptSectionTitle}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="ActiveKindBadge" HorizontalAlignment="Right"
                                        Style="{StaticResource StatusPill}" Padding="6,1"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActiveKindText" Text="内置" FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="ActiveTemplateName" FontSize="15" FontWeight="SemiBold"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       AutomationProperties.Name="当前生效的模板名称" />
                            <TextBlock x:Name="ActiveTemplateDescription" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />
                            <TextBlock x:Name="ActiveTemplateMeta" Style="{StaticResource Metadata}"
                                       Margin="0,5,0,0"
                                       AutomationProperties.Name="当前生效模板的版本信息" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,8">
                        <StackPanel>
                            <!-- 内置模板（只读） -->
                            <TextBlock Text="内置模板" Style="{StaticResource PromptSectionTitle}" Margin="0,0,0,10" />
                            <ItemsControl x:Name="BuiltinsList" IsTabStop="False" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PromptListItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DisplayName}" />
                                                        <Border Grid.Column="1" Visibility="{Binding ActiveBadge}"
                                                                Style="{StaticResource StatusPill}" Padding="6,1"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentSoftBrush}"
                                                                BorderBrush="{DynamicResource AccentBorderBrush}">
                                                            <TextBlock Text="使用中" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DisplayDescription}" Style="{StaticResource Caption}"
                                                               Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Metadata}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Content="查看" Padding="10,5" Tag="{Binding Id}"
                                                            Style="{StaticResource GhostButton}"
                                                            AutomationProperties.Name="查看内置模板详情"
                                                            Visibility="{Binding ViewButtonVisibility}"
                                                            Click="ViewTemplate_Click" />
                                                    <Button Content="复制为自定义" Padding="10,5" Tag="{Binding Id}"
                                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                            AutomationProperties.Name="复制为自定义模板"
                                                            Click="CopyTemplate_Click" />
                                                    <Button Content="设为默认" Padding="10,5" Tag="{Binding Id}"
                                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                            AutomationProperties.Name="设为当前翻译风格"
                                                            Visibility="{Binding ActivateButtonVisibility}"
                                                            Click="ActivateTemplate_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 自定义模板（可增删改） -->
                            <Grid Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="自定义模板" Style="{StaticResource PromptSectionTitle}" />
                                    <TextBlock x:Name="CustomQuotaText" Text="0/50" Style="{StaticResource Metadata}"
                                               Margin="0,3,0,0"
                                               AutomationProperties.Name="自定义模板数量配额" />
                                </StackPanel>
                                <Button x:Name="AddTemplateButton" Content="新建自定义模板" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" Padding="14,6"
                                        AutomationProperties.Name="新建自定义模板" Click="AddTemplate_Click" />
                            </Grid>

                            <ItemsControl x:Name="CustomsList" IsTabStop="False" Focusable="False"
                                          Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PromptListItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DisplayName}" />
                                                        <Border Grid.Column="1" Visibility="{Binding ActiveBadge}"
                                                                Style="{StaticResource StatusPill}" Padding="6,1"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentSoftBrush}"
                                                                BorderBrush="{DynamicResource AccentBorderBrush}">
                                                            <TextBlock Text="使用中" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DisplayDescription}" Style="{StaticResource Caption}"
                                                               Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Metadata}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Content="编辑" Padding="10,5" Tag="{Binding Id}"
                                                            Style="{StaticResource GhostButton}"
                                                            AutomationProperties.Name="编辑自定义模板"
                                                            Click="EditTemplate_Click" />
                                                    <Button Content="设为默认" Padding="10,5" Tag="{Binding Id}"
                                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                            AutomationProperties.Name="设为当前翻译风格"
                                                            Visibility="{Binding ActivateButtonVisibility}"
                                                            Click="ActivateTemplate_Click" />
                                                    <Button Content="删除" Padding="10,5"
                                                            Tag="{Binding Id}" Style="{StaticResource GhostButton}"
                                                            Margin="8,0,0,0"
                                                            AutomationProperties.Name="删除自定义模板"
                                                            ToolTip="点击两次确认"
                                                            Click="DeleteTemplate_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="CustomsEmptyPanel" Margin="8,16,8,20" HorizontalAlignment="Center">
                                <Border Width="44" Height="44" CornerRadius="13" Margin="0,0,0,12"
                                        Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconSparkles}" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="还没有自定义模板" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <Button Content="新建第一个模板" Style="{StaticResource PrimaryButton}" Padding="16,7"
                                        AutomationProperties.Name="新建第一个自定义模板" Click="AddTemplate_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 读取失败的内联错误态：模板列表内容不可信，绝不与「还没有
                 自定义模板」的正常空态混用；重试成功后由代码恢复列表。 -->
            <Border x:Name="LoadErrorPanel" Visibility="Collapsed" Padding="24,20"
                    CornerRadius="{DynamicResource CardRadius}" Margin="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                <StackPanel MaxWidth="420" HorizontalAlignment="Center">
                    <TextBlock Text="提示词模板读取失败" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoadErrorText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                               AutomationProperties.LiveSetting="Assertive"
                               AutomationProperties.Name="提示词模板读取失败原因" />
                    <Button x:Name="RetryLoadButton" Content="重试" Style="{StaticResource PrimaryButton}"
                            Padding="16,7" Margin="0,14,0,0" HorizontalAlignment="Center"
                            AutomationProperties.Name="重新读取提示词模板"
                            Click="RetryLoad_Click" />
                </StackPanel>
            </Border>

            <!-- ==================== 聚焦编辑器 ==================== -->
            <Border x:Name="EditorForm" Visibility="Collapsed" Padding="0" Background="Transparent"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="← 返回模板列表" Style="{StaticResource GhostButton}" Padding="8,5"
                                HorizontalAlignment="Left" AutomationProperties.Name="返回模板列表"
                                Click="BackToList_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Margin="2,0,2,14">
                                <TextBlock x:Name="EditorTitleText" Text="新建自定义模板" FontSize="18"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Border x:Name="ReadOnlyBadge" Style="{StaticResource StatusPill}" Padding="6,1"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <TextBlock Text="只读" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="EditorMetaText" Style="{StaticResource Caption}" Margin="2,0,2,14"
                                       AutomationProperties.Name="模板编辑状态说明" />

                            <StackPanel x:Name="EditorFieldsPanel">
                                <!-- 模板信息 -->
                                <Border Style="{StaticResource PromptSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="模板信息" Style="{StaticResource PromptSectionTitle}" Margin="0,0,0,12" />
                                        <Grid x:Name="NameDescriptionGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="0" />
                                            </Grid.RowDefinitions>
                                            <StackPanel x:Name="NamePanel">
                                                <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="NameTextBox" Style="{StaticResource PromptTextField}"
                                                         MaxLength="64" MaxLines="1"
                                                         local:Ui.Placeholder="例如：技术文档翻译"
                                                         AutomationProperties.Name="模板名称"
                                                         TextChanged="EditorField_Changed" />
                                                <TextBlock x:Name="NameCounterText" Style="{StaticResource CounterText}"
                                                           AutomationProperties.Name="模板名称用量计数"
                                                           Text="0/64" />
                                            </StackPanel>
                                            <StackPanel x:Name="DescriptionPanel" Grid.Column="2">
                                                <TextBlock Text="说明" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="DescriptionTextBox"
                                                         Style="{StaticResource PromptTextField}"
                                                         MaxLength="256" MaxLines="1"
                                                         local:Ui.Placeholder="描述模板用途"
                                                         AutomationProperties.Name="模板说明"
                                                         TextChanged="EditorField_Changed" />
                                                <TextBlock x:Name="DescriptionCounterText" Style="{StaticResource CounterText}"
                                                           AutomationProperties.Name="模板说明用量计数"
                                                           Text="0/256" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="EnabledPanel" Orientation="Horizontal"
                                                    Margin="0,14,0,0" Visibility="Collapsed">
                                            <ToggleButton x:Name="EnabledToggle" VerticalAlignment="Center"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          AutomationProperties.Name="启用此模板"
                                                          Checked="EnabledToggle_Changed"
                                                          Unchecked="EnabledToggle_Changed" />
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="启用此模板" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="EnabledHintText" Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 指令正文 -->
                                <Border Style="{StaticResource PromptSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="指令正文" Style="{StaticResource PromptSectionTitle}" />
                                        <TextBlock Text="占位符发送前由本机展开；\{{ 表示字面 {{"
                                                   Style="{StaticResource Caption}" Margin="0,4,0,10" />
                                        <TextBox x:Name="InstructionTextBox" MinHeight="150"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                 VerticalAlignment="Stretch"
                                                 local:Ui.Placeholder="例如：使用自然的目标语言，保持术语一致，不增补原文没有的内容。"
                                                 AutomationProperties.Name="指令正文"
                                                 TextChanged="EditorField_Changed" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Caption}"
                                                       Text="上限 8192 字节（UTF-8）" />
                                            <TextBlock x:Name="InstructionCounterText" Grid.Column="1"
                                                       Style="{StaticResource CounterText}" Margin="0"
                                                       AutomationProperties.Name="指令正文用量计数"
                                                       Text="0 字符 · 0/8192 字节" />
                                        </Grid>
                                        <TextBlock Text="插入变量：" Style="{StaticResource FieldLabel}"
                                                   Margin="0,12,0,0" />
                                        <WrapPanel x:Name="VariableChipsPanel" Margin="0,2,0,0">
                                            <Button Style="{StaticResource TokenChipButton}" Content="{}{{source_language}}"
                                                    AutomationProperties.Name="插入变量 source_language"
                                                    ToolTip="插入源语言变量（自动识别时展开为“自动识别”）"
                                                    Click="VariableChip_Click" />
                                            <Button Style="{StaticResource TokenChipButton}" Content="{}{{target_language}}"
                                                    AutomationProperties.Name="插入变量 target_language"
                                                    ToolTip="插入目标语言变量"
                                                    Click="VariableChip_Click" />
                                            <Button Style="{StaticResource TokenChipButton}" Content="{}{{domain}}"
                                                    AutomationProperties.Name="插入变量 domain"
                                                    ToolTip="插入领域变量（留空时使用默认值）"
                                                    Click="VariableChip_Click" />
                                            <Button Style="{StaticResource TokenChipButton}" Content="{}{{audience}}"
                                                    AutomationProperties.Name="插入变量 audience"
                                                    ToolTip="插入受众变量（留空时使用默认值）"
                                                    Click="VariableChip_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 默认领域与受众 -->
                                <Border Style="{StaticResource PromptSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="默认领域与受众" Style="{StaticResource PromptSectionTitle}" />
                                        <TextBlock Text="模板留空时使用；上限 256 字符"
                                                   Style="{StaticResource Caption}" Margin="0,4,0,12" />
                                        <Grid x:Name="DomainAudienceGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition x:Name="DomainAudienceRow1" Height="0" />
                                            </Grid.RowDefinitions>
                                            <StackPanel x:Name="DomainPanel">
                                                <TextBlock Text="领域" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="DomainTextBox" Style="{StaticResource PromptTextField}"
                                                         MaxLength="256" MaxLines="1"
                                                         local:Ui.Placeholder="例如：计算机科学"
                                                         AutomationProperties.Name="默认领域"
                                                         TextChanged="EditorField_Changed" />
                                                <TextBlock x:Name="DomainCounterText" Style="{StaticResource CounterText}"
                                                           AutomationProperties.Name="默认领域用量计数"
                                                           Text="0 字符 · 0/1024 字节" />
                                            </StackPanel>
                                            <StackPanel x:Name="AudiencePanel" Grid.Column="2">
                                                <TextBlock Text="受众" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="AudienceTextBox" Style="{StaticResource PromptTextField}"
                                                         MaxLength="256" MaxLines="1"
                                                         local:Ui.Placeholder="例如：软件工程师"
                                                         AutomationProperties.Name="默认受众"
                                                         TextChanged="EditorField_Changed" />
                                                <TextBlock x:Name="AudienceCounterText" Style="{StaticResource CounterText}"
                                                           AutomationProperties.Name="默认受众用量计数"
                                                           Text="0 字符 · 0/1024 字节" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 编译预览 -->
                                <Border Style="{StaticResource PromptSectionCard}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="效果预览" Style="{StaticResource PromptSectionTitle}" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                           Text="本地展开占位符，不联网；目标语言默认 zh-CN" />
                                            </StackPanel>
                                            <Button x:Name="CopyPreviewButton" Content="复制" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Style="{StaticResource GhostButton}"
                                                    Padding="10,5" AutomationProperties.Name="复制效果预览结果"
                                                    Click="CopyPreview_Click" />
                                        </Grid>
                                        <TextBox x:Name="PreviewTextBox" Height="132" Margin="0,12,0,0"
                                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                 TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Auto" FontSize="12.5"
                                                 AutomationProperties.Name="效果预览结果" />
                                        <TextBlock x:Name="PreviewStatusText" Style="{StaticResource Caption}"
                                                   Margin="2,8,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.Name="效果预览状态" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 脏草稿导航守卫：返回列表/切页/关窗前在这里解决草稿 -->
                    <Border x:Name="DraftGuardBar" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"
                            Padding="12,10" CornerRadius="{DynamicResource CardRadius}"
                            Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock x:Name="DraftGuardText" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="DraftCancelButton" Content="取消" Style="{StaticResource GhostButton}"
                                        AutomationProperties.Name="取消返回，留在编辑器" Click="DraftCancel_Click" />
                                <Button x:Name="DraftDiscardButton" Content="放弃修改" Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" AutomationProperties.Name="放弃未保存的模板修改"
                                        Click="DraftDiscard_Click" />
                                <Button x:Name="DraftSaveButton" Content="保存并继续" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" AutomationProperties.Name="保存模板并继续"
                                        Click="DraftSave_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 编辑器操作栏 -->
                    <Border x:Name="EditorActionBar" Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Button x:Name="DeleteTemplateButton" Content="删除模板" HorizontalAlignment="Left"
                                    Style="{StaticResource DangerButton}" Padding="12,6"
                                    AutomationProperties.Name="删除自定义模板"
                                    ToolTip="点击两次确认"
                                    Click="DeleteTemplate_Click" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CopyBuiltinButton" Content="复制为自定义" Style="{StaticResource PrimaryButton}"
                                        Padding="14,6" Margin="0,0,8,0" Visibility="Collapsed"
                                        AutomationProperties.Name="复制为自定义模板" Click="CopyBuiltinEditor_Click" />
                                <Border x:Name="EditorDirtyBadge" Visibility="Collapsed" Style="{StaticResource StatusPill}"
                                        Background="{DynamicResource WarningSoftBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}" Padding="8,3"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="未保存的修改" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                                <Button x:Name="CancelEditButton" Content="取消" Style="{StaticResource GhostButton}"
                                        Padding="12,6" AutomationProperties.Name="取消编辑并返回模板列表"
                                        Click="CancelEdit_Click" />
                                <Button x:Name="SaveTemplateButton" Content="保存" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}" Padding="16,6"
                                        AutomationProperties.Name="保存模板"
                                        Click="SaveTemplate_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
