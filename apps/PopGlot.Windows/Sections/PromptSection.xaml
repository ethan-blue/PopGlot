<UserControl x:Class="PopGlot.Windows.Sections.PromptSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows"
             KeyDown="PromptSection_KeyDown">
    <UserControl.Resources>
        <Style x:Key="PromptListItem" TargetType="Border">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="PromptSectionCard" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="PromptTextField" TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="PromptSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CounterText" TargetType="TextBlock" BasedOn="{StaticResource Metadata}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="AutomationProperties.Name" Value="字段用量计数" />
        </Style>
        <Style x:Key="PromptChoiceItem" TargetType="RadioButton" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
    </UserControl.Resources>

        <Grid>
            <!-- ==================== 模板列表 ==================== -->
            <Border x:Name="ListHost" Padding="0" Background="Transparent" BorderThickness="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,8">
                    <StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="风格" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="BuiltinsList" IsTabStop="False" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Tag="{Binding Id}"
                                                 GroupName="PromptBuiltinStyle"
                                                 Style="{StaticResource PromptChoiceItem}"
                                                 IsChecked="{Binding IsActive, Mode=OneWay}"
                                                 ToolTip="{Binding DisplayDescription}"
                                                 AutomationProperties.Name="{Binding DisplayName}"
                                                 Checked="BuiltinChoice_Checked">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 当前指令始终可读、可选择和复制；只保留编辑区自身的边框。 -->
                        <Border x:Name="ActivePromptCard" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock x:Name="ActiveTemplateName" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" MaxWidth="360" />
                                    <Path Data="{StaticResource IconInfo}" Width="12" Height="12" Stretch="Uniform"
                                          Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource TextTertiaryBrush}">
                                        <Path.ToolTip>
                                            <ToolTip>
                                                <StackPanel MaxWidth="320">
                                                    <TextBlock x:Name="ActiveTemplateDescription" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="ActiveTemplateMeta" Style="{StaticResource Metadata}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Path.ToolTip>
                                    </Path>
                                </StackPanel>
                                    <TextBox x:Name="ActiveTemplateInstruction"
                                             Style="{StaticResource FormTextArea}"
                                             local:Ui.ContentPadding="8,6"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             TextWrapping="Wrap" MinHeight="0" MaxHeight="140"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="12" FontFamily="{StaticResource MonoFontFamily}"
                                             AutomationProperties.Name="当前生效的提示词完整指令" />
                                <StackPanel x:Name="ActiveDomainAudiencePanel" Margin="0,6,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="ActiveDomainText" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="ActiveAudienceText" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <!-- 底部操作栏：独立占行自适应流动，确保窄窗口下多操作与长规则名互不挤占 -->
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="ActiveResetDefaultButton" Style="{StaticResource GhostButton}"
                                            Padding="10,4" Margin="0,0,8,4" Visibility="Collapsed"
                                            Content="恢复默认" ToolTip="恢复使用系统默认提示词（准确）"
                                            AutomationProperties.Name="恢复系统默认提示词"
                                            Click="ActiveResetDefault_Click" />
                                    <Button x:Name="ActiveCopyButton" Style="{StaticResource GhostButton}"
                                            Padding="10,4" Margin="0,0,8,4"
                                            Content="复制指令" ToolTip="复制当前提示词指令到剪贴板"
                                            AutomationProperties.Name="复制当前提示词指令"
                                            Click="ActiveCopy_Click" />
                                    <Button x:Name="ActiveForkButton" Style="{StaticResource GhostButton}"
                                            Padding="10,4" Margin="0,0,8,4"
                                            Content="新建副本" ToolTip="以此模板为起点创建自定义规则"
                                            AutomationProperties.Name="基于此规则新建"
                                            Click="ActiveFork_Click" />
                                    <Button x:Name="ActiveEditButton" Style="{StaticResource GhostButton}"
                                            Padding="10,4" Margin="0,0,8,4" Visibility="Collapsed"
                                            Content="编辑规则" ToolTip="编辑此自定义规则"
                                            AutomationProperties.Name="编辑当前自定义规则"
                                            Click="ActiveEdit_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                            <!-- 自定义模板（可增删改） -->
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="自定义" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="CustomQuotaText" Text="0/50" Style="{StaticResource Metadata}"
                                               Margin="0,3,0,0"
                                               AutomationProperties.Name="自定义模板数量配额" />
                                </StackPanel>
                                <Button x:Name="AddTemplateButton" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Style="{StaticResource IconButton}"
                                        local:Ui.Icon="{StaticResource IconAdd}" ToolTip="添加规则"
                                        AutomationProperties.Name="添加翻译规则" Click="AddTemplate_Click" />
                            </Grid>

                            <ItemsControl x:Name="CustomsList" IsTabStop="False" Focusable="False"
                                          Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PromptListItem}" Tag="{Binding Id}" Cursor="Hand"
                                                MouseLeftButtonUp="CustomRow_MouseLeftButtonUp">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="0" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding DisplayName}" />
                                                            <TextBlock Grid.Column="1" Visibility="{Binding ActiveBadge}"
                                                                       Text="使用中" FontSize="11" Margin="8,0,0,0"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <!-- 说明最多两行（12/17 行高）：超出省略；完整说明在
                                                             编辑器里始终可读（键盘可达），悬停与读屏另有全文。 -->
                                                        <TextBlock Text="{Binding DisplayDescription}" Style="{StaticResource Caption}"
                                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                                   LineHeight="17" MaxHeight="34"
                                                                   ToolTip="{Binding DisplayDescription}"
                                                                   AutomationProperties.HelpText="{Binding DisplayDescription}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="10,0,0,0"
                                                                Visibility="{Binding ActionsVisibility}">
                                                        <Button Tag="{Binding Id}" Style="{StaticResource IconButton}"
                                                                local:Ui.Icon="{StaticResource IconEdit}" ToolTip="编辑"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=编辑规则：{0}}"
                                                                Click="EditTemplate_Click" />
                                                        <Button Tag="{Binding Id}" Style="{StaticResource IconButton}"
                                                                local:Ui.Icon="{StaticResource IconCopy}" Margin="4,0,0,0"
                                                                ToolTip="复制为新规则"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=复制规则：{0}}"
                                                                Click="CopyTemplate_Click" />
                                                        <Button Tag="{Binding Id}" Style="{StaticResource IconButton}"
                                                                local:Ui.Icon="{StaticResource IconCheck}" Margin="4,0,0,0"
                                                                ToolTip="使用这条规则"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=使用规则：{0}}"
                                                                Visibility="{Binding ActivateButtonVisibility}"
                                                                Click="ActivateTemplate_Click" />
                                                        <Button Tag="{Binding Id}" Style="{StaticResource IconButton}"
                                                                local:Ui.Icon="{StaticResource IconDelete}" Margin="4,0,0,0"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=删除规则：{0}}"
                                                                ToolTip="删除规则"
                                                                Loaded="RowDeleteButton_Loaded"
                                                                Click="DeleteTemplate_Click" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- 删除确认内联区：第一次点删除后出现在行内，
                                                     操作按钮位置固定、无 3 秒限时；Esc 或「取消」
                                                     解除。删除范围（历史修订一并删除）如实说明。 -->
                                                <Border Grid.Row="1" Margin="0,8,0,0" Padding="10,8"
                                                        CornerRadius="{StaticResource ControlRadius}"
                                                        Background="{DynamicResource DangerSoftBrush}"
                                                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                                        Visibility="{Binding ConfirmDeleteVisibility}"
                                                        AutomationProperties.Name="{Binding DeleteConfirmText}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DeleteConfirmText}" FontSize="12"
                                                                   Foreground="{DynamicResource DangerBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                            <Button Tag="{Binding Id}" Content="取消" Style="{StaticResource GhostButton}"
                                                                    Padding="12,4" AutomationProperties.Name="取消删除规则"
                                                                    Click="CancelDeleteConfirm_Click" />
                                                            <Button Tag="{Binding Id}" Content="删除" Style="{StaticResource DangerButton}"
                                                                    Padding="12,4" Margin="8,0,0,0"
                                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat=确认删除规则：{0}}"
                                                                    Click="DeleteConfirmed_Click"
                                                                    Loaded="DeleteConfirmButton_Loaded" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="CustomsEmptyPanel" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="暂无自定义规则"
                                           Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 读取失败的内联错误态：模板列表内容不可信，绝不与「还没有
                 自定义模板」的正常空态混用；重试成功后由代码恢复列表。 -->
            <Border x:Name="LoadErrorPanel" Visibility="Collapsed" Padding="24,20"
                    CornerRadius="{DynamicResource CardRadius}" Margin="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                <StackPanel MaxWidth="420" HorizontalAlignment="Center">
                    <TextBlock Text="提示词模板读取失败" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoadErrorText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                               AutomationProperties.LiveSetting="Assertive"
                               AutomationProperties.Name="提示词模板读取失败原因" />
                    <Button x:Name="RetryLoadButton" Content="重试" Style="{StaticResource PrimaryButton}"
                            Padding="16,7" Margin="0,14,0,0" HorizontalAlignment="Center"
                            AutomationProperties.Name="重新读取提示词模板"
                            Click="RetryLoad_Click" />
                </StackPanel>
            </Border>

            <!-- ==================== 聚焦编辑器 ==================== -->
            <Border x:Name="EditorForm" Visibility="Collapsed" Padding="0" Background="Transparent"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="返回" Style="{StaticResource GhostButton}" Padding="8,5"
                                HorizontalAlignment="Left" AutomationProperties.Name="返回模板列表"
                                Click="BackToList_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <!-- 宽度上限与引擎编辑器（900）一致：同一设置窗内两个
                             编辑器的可用宽度同宽，双列字段不再挤在窄列里。 -->
                        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="EditorTitleText" Text="添加翻译规则" Style="{StaticResource PageTitle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Border x:Name="ReadOnlyBadge" Grid.Column="1"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="系统预置" Style="{StaticResource Metadata}" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="EditorMetaText" Style="{StaticResource Caption}" Margin="0,0,0,10"
                                       AutomationProperties.Name="模板编辑状态说明" />

                            <StackPanel x:Name="EditorFieldsPanel">
                                <!-- 模板信息 -->
                                <Border Style="{StaticResource PromptSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="基本信息" Style="{StaticResource PromptSectionTitle}" Margin="0,0,0,8" />
                                        <Grid x:Name="NameDescriptionGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="0" />
                                            </Grid.RowDefinitions>
                                            <StackPanel x:Name="NamePanel">
                                                <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="NameTextBox" Style="{StaticResource PromptTextField}"
                                                         MaxLength="64" MaxLines="1"
                                                         local:Ui.Placeholder="例如：技术文档翻译"
                                                         AutomationProperties.Name="模板名称"
                                                         TextChanged="EditorField_Changed" />
                                                <TextBlock x:Name="NameCounterText" Style="{StaticResource CounterText}"
                                                           AutomationProperties.Name="模板名称用量计数"
                                                           Text="0/64" />
                                            </StackPanel>
                                            <StackPanel x:Name="DescriptionPanel" Grid.Column="2">
                                                <TextBlock Text="说明" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="DescriptionTextBox"
                                                         Style="{StaticResource PromptTextField}"
                                                         MaxLength="256" MaxLines="1"
                                                         local:Ui.Placeholder="例如：地道自然，适合日常对话与阅读"
                                                         AutomationProperties.Name="模板说明"
                                                         TextChanged="EditorField_Changed" />
                                                <TextBlock x:Name="DescriptionCounterText" Style="{StaticResource CounterText}"
                                                           AutomationProperties.Name="模板说明用量计数"
                                                           Text="0/256" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid x:Name="EnabledPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="EnabledToggle" Grid.Column="1" VerticalAlignment="Center"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          AutomationProperties.Name="启用此模板"
                                                          Checked="EnabledToggle_Changed"
                                                          Unchecked="EnabledToggle_Changed" />
                                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="启用此模板" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="EnabledHintText" Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 指令正文 -->
                                <Border Style="{StaticResource PromptSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="指令正文" Style="{StaticResource PromptSectionTitle}" />
                                        <TextBlock Text="支持动态变量；如需输入字面花括号，请使用 \{{ "
                                                   Style="{StaticResource Caption}" Margin="0,4,0,10" />
                                        <TextBox x:Name="InstructionTextBox" Style="{StaticResource FormTextArea}"
                                                 MinHeight="150" VerticalAlignment="Stretch"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="12.5"
                                                 local:Ui.Placeholder="例如：请将原文准确翻译为 {{target_language}}，保持专业术语严谨与文意通顺。"
                                                 AutomationProperties.Name="指令正文"
                                                 TextChanged="EditorField_Changed" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,12,0"
                                                       Text="上限 8192 UTF-8 字节" />
                                            <TextBlock x:Name="InstructionCounterText"
                                                       Style="{StaticResource CounterText}" Margin="0"
                                                       AutomationProperties.Name="指令正文用量计数"
                                                       Text="0 字符 · 0/8192 字节" />
                                        </WrapPanel>
                                        <TextBlock Text="插入变量：" Style="{StaticResource FieldLabel}"
                                                   Margin="0,12,0,0" />
                                        <WrapPanel x:Name="VariableChipsPanel" Margin="0,2,0,0">
                                            <Button Style="{StaticResource TokenChipButton}" Content="{}{{source_language}}"
                                                    AutomationProperties.Name="插入变量 source_language"
                                                    ToolTip="插入源语言变量（自动识别时展开为“自动识别”）"
                                                    Click="VariableChip_Click" />
                                            <Button Style="{StaticResource TokenChipButton}" Content="{}{{target_language}}"
                                                    AutomationProperties.Name="插入变量 target_language"
                                                    ToolTip="插入目标语言变量"
                                                    Click="VariableChip_Click" />
                                            <Button Style="{StaticResource TokenChipButton}" Content="{}{{domain}}"
                                                    AutomationProperties.Name="插入变量 domain"
                                                    ToolTip="插入领域变量（留空时使用默认值）"
                                                    Click="VariableChip_Click" />
                                            <Button Style="{StaticResource TokenChipButton}" Content="{}{{audience}}"
                                                    AutomationProperties.Name="插入变量 audience"
                                                    ToolTip="插入受众变量（留空时使用默认值）"
                                                    Click="VariableChip_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 默认领域与受众 -->
                                <Border Style="{StaticResource PromptSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="默认领域与受众" Style="{StaticResource PromptSectionTitle}" />
                                        <TextBlock Text="模板留空时使用；上限 256 字符"
                                                   Style="{StaticResource Caption}" Margin="0,4,0,12" />
                                        <Grid x:Name="DomainAudienceGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition x:Name="DomainAudienceRow1" Height="0" />
                                            </Grid.RowDefinitions>
                                            <StackPanel x:Name="DomainPanel">
                                                <TextBlock Text="领域" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="DomainTextBox" Style="{StaticResource PromptTextField}"
                                                         MaxLength="256" MaxLines="1"
                                                         local:Ui.Placeholder="例如：计算机科学"
                                                         AutomationProperties.Name="默认领域"
                                                         TextChanged="EditorField_Changed" />
                                                <TextBlock x:Name="DomainCounterText" Style="{StaticResource CounterText}"
                                                           AutomationProperties.Name="默认领域用量计数"
                                                           Text="0 字符 · 0/1024 字节" />
                                            </StackPanel>
                                            <StackPanel x:Name="AudiencePanel" Grid.Column="2">
                                                <TextBlock Text="受众" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="AudienceTextBox" Style="{StaticResource PromptTextField}"
                                                         MaxLength="256" MaxLines="1"
                                                         local:Ui.Placeholder="例如：软件工程师"
                                                         AutomationProperties.Name="默认受众"
                                                         TextChanged="EditorField_Changed" />
                                                <TextBlock x:Name="AudienceCounterText" Style="{StaticResource CounterText}"
                                                           AutomationProperties.Name="默认受众用量计数"
                                                           Text="0 字符 · 0/1024 字节" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 编译预览 -->
                                <Border Style="{StaticResource PromptSectionCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="效果预览" Style="{StaticResource PromptSectionTitle}" VerticalAlignment="Center" />
                                            <Button x:Name="CopyPreviewButton" Grid.Column="1" Content="复制"
                                                    VerticalAlignment="Top" Style="{StaticResource GhostButton}"
                                                    Padding="10,5" AutomationProperties.Name="复制效果预览结果"
                                                    Click="CopyPreview_Click" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   Text="本地编译，无需联网；示例目标为中文（简体）" />
                                        <TextBox x:Name="PreviewTextBox" Style="{StaticResource FormTextArea}"
                                                 Height="132" Margin="0,8,0,0"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                 FontSize="12"
                                                 AutomationProperties.Name="效果预览结果" />
                                        <TextBlock x:Name="PreviewStatusText" Style="{StaticResource Caption}"
                                                   Margin="2,8,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.Name="效果预览状态" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 脏草稿导航守卫：返回列表/切页/关窗前在这里解决草稿 -->
                    <Border x:Name="DraftGuardBar" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"
                            Padding="12,10" CornerRadius="{DynamicResource CardRadius}"
                            Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock x:Name="DraftGuardText" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="DraftCancelButton" Content="取消" Style="{StaticResource GhostButton}"
                                        AutomationProperties.Name="取消返回，留在编辑器" Click="DraftCancel_Click" />
                                <Button x:Name="DraftDiscardButton" Content="放弃修改" Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" AutomationProperties.Name="放弃未保存的模板修改"
                                        Click="DraftDiscard_Click" />
                                <Button x:Name="DraftSaveButton" Content="保存并继续" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" AutomationProperties.Name="保存模板并继续"
                                        Click="DraftSave_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 编辑器操作栏 -->
                    <Border x:Name="EditorActionBar" Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,8"
                                        x:Name="EditorDeleteConfirmPanel" Visibility="Collapsed">
                                <!-- 与列表行同一删除确认契约：范围如实说明、无 3 秒限时、
                                     Esc/取消解除；出现在删除按钮原位，其余操作不动。 -->
                                <TextBlock x:Name="EditorDeleteConfirmText" FontSize="12" TextWrapping="Wrap"
                                           HorizontalAlignment="Stretch"
                                           Foreground="{DynamicResource DangerBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="EditorDeleteCancelButton" Content="取消" Style="{StaticResource GhostButton}"
                                            Padding="12,4" AutomationProperties.Name="取消删除模板"
                                            Click="EditorDeleteConfirmCancel_Click" />
                                    <Button x:Name="EditorDeleteConfirmButton" Content="删除" Style="{StaticResource DangerButton}"
                                            Padding="12,4" Margin="8,0,0,0"
                                            AutomationProperties.Name="确认删除模板"
                                            Click="EditorDeleteConfirmDelete_Click" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="DeleteTemplateButton" Grid.Row="1" Content="删除模板" HorizontalAlignment="Left"
                                    Style="{StaticResource DangerButton}" Padding="12,6"
                                    AutomationProperties.Name="删除自定义模板"
                                    ToolTip="删除此模板及其历史修订"
                                    Click="EditorDelete_Click" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CopyBuiltinButton" Content="基于此规则新建" Style="{StaticResource PrimaryButton}"
                                        Padding="14,6" Margin="0,0,8,0" Visibility="Collapsed"
                                        AutomationProperties.Name="基于此规则新建" Click="CopyBuiltinEditor_Click" />
                                <Border x:Name="EditorDirtyBadge" Visibility="Collapsed"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="未保存" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                                <Button x:Name="CancelEditButton" Content="取消" Style="{StaticResource GhostButton}"
                                        Padding="12,6" AutomationProperties.Name="取消编辑并返回模板列表"
                                        Click="CancelEdit_Click" />
                                <Button x:Name="SaveTemplateButton" Content="保存" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}" Padding="16,6"
                                        AutomationProperties.Name="保存模板"
                                        Click="SaveTemplate_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
</UserControl>
