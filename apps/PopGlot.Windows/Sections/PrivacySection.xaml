<UserControl x:Class="PopGlot.Windows.Sections.PrivacySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows"
             xmlns:services="clr-namespace:PopGlot.Windows.Services"
             SizeChanged="PrivacySection_SizeChanged">

    <!-- Compact desktop property list -->
    <StackPanel>
        <TextBlock Text="隐私与数据" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />

        <!-- Plain language privacy commitment card -->
        <Border Style="{StaticResource InlineCard}" Margin="0,0,0,16" Padding="14,12">
            <StackPanel>
                <TextBlock Text="仅在你发起翻译时处理所选内容。" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <!-- 0.1.27：去掉折叠，事实直接可见——两行说清，不再让用户
                     展开一张「详情」折叠板。 -->
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="17"
                           Text="联网时仅发送待翻译文本，视觉翻译获准后才会上传截图；OCR 识别、密钥存储与安全离线模式都在本机完成，不监听复制或屏幕。" />
            </StackPanel>
        </Border>

        <!-- Primary security controls -->
        <TextBlock Text="常用隐私设置" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static services:EngineWording.SafeOfflineModeName}" Style="{StaticResource RowTitle}" />
                <TextBlock Text="彻底断开外部网络通信，仅使用本机模型与本地词库" Style="{StaticResource RowHint}" />
            </StackPanel>
            <ToggleButton x:Name="SafeModeToggle"
                          AutomationProperties.Name="{x:Static services:EngineWording.SafeOfflineModeName}" Grid.Column="1"
                          VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitch}"
                          Checked="ProviderGate_Changed" Unchecked="ProviderGate_Changed" />
        </Grid>

        <!-- Status note shown while safe mode is active -->
        <TextBlock x:Name="SafeModeGateNote" Style="{StaticResource Caption}"
                   Foreground="{DynamicResource WarningBrush}"
                   Margin="0,0,0,12" Visibility="Collapsed"
                   Text="已暂停云端翻译、截图上传与云端朗读。" />

        <Border Style="{StaticResource SettingsDivider}" Margin="0,0,0,12" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="允许读取截图内容" Style="{StaticResource RowTitle}" />
                <TextBlock Text="允许截图翻译分析画面中的文字与排版布局" Style="{StaticResource RowHint}" />
            </StackPanel>
            <ToggleButton x:Name="AllowImageUploadToggle"
                          AutomationProperties.Name="允许读取截图内容" Grid.Column="1"
                          VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitch}"
                          Checked="ProviderGate_Changed" Unchecked="ProviderGate_Changed" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" Margin="0,0,0,12" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="云端在线朗读" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="开启后将朗读文本发送至 Microsoft；默认使用本地语音" />
            </StackPanel>
            <ToggleButton x:Name="CloudSpeechToggle"
                          AutomationProperties.Name="云端在线朗读" Grid.Column="1"
                          VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitch}"
                          Checked="CloudSpeech_ToggleChanged" Unchecked="CloudSpeech_ToggleChanged" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" Margin="0,0,0,12" />

        <!-- 0.1.25 自我迭代：GitHub 问题上报。默认关闭的 opt-in 诊断上传，
             令牌只存 Windows 凭据管理器，正文仅脱敏诊断与版本信息。 -->
        <TextBlock Text="GitHub 问题上报" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
        <Border Style="{StaticResource InlineCard}" Margin="0,0,0,14" Padding="14,12">
            <StackPanel>
                <CheckBox x:Name="IssueUploadConsentToggle"
                          AutomationProperties.Name="允许崩溃时上传脱敏诊断到 GitHub"
                          Checked="IssueUploadConsent_Changed"
                          Unchecked="IssueUploadConsent_Changed">
                    <TextBlock Text="程序遇到严重问题时，上传脱敏诊断到 GitHub Issues" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Style="{StaticResource Caption}" Margin="20,4,0,0" TextWrapping="Wrap" LineHeight="17"
                           Text="默认关闭。仅上传版本、系统信息与已脱敏的崩溃类型和堆栈；绝不包含翻译文本、截图、带查询串的地址或凭据。随时取消勾选即可撤销。" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="IssueUploadPatBox"
                                 Style="{StaticResource FormPasswordBox}"
                                 local:Ui.Placeholder="留空保留"
                                 AutomationProperties.Name="GitHub 访问令牌"
                                 PasswordChanged="IssueUploadPat_PasswordChanged" />
                    <Button x:Name="IssueUploadPatClearButton" Grid.Column="1"
                            Content="清除令牌" Margin="8,0,0,0" Padding="10,5"
                            Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            AutomationProperties.Name="清除已保存的 GitHub 令牌"
                            Click="IssueUploadPatClear_Click" />
                    <Button x:Name="IssueUploadTestButton" Grid.Column="2"
                            Content="发送测试诊断" Margin="8,0,0,0" Padding="10,5"
                            Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            AutomationProperties.Name="发送测试诊断到 GitHub"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="需要先勾选上传同意，并保存 GitHub 访问令牌（需 Issues 写权限）。"
                            Click="IssueUploadTest_Click" />
                    <Button x:Name="IssueUploadPatHelpButton" Grid.Column="3"
                            Content="如何生成令牌？" Margin="8,0,0,0" Padding="10,5"
                            Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            AutomationProperties.Name="打开 GitHub 令牌生成页"
                            ToolTip="打开 GitHub 的令牌生成页（勾选 repo 权限），生成后粘贴到左侧输入框。"
                            Click="IssueUploadPatHelp_Click" />
                </Grid>
                <!-- 0.1.27：令牌是什么、去哪生成直接说清——不知道 PAT 为何物
                     的用户此前只能卡在这里。 -->
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="17"
                           Text="令牌是 GitHub 的访问密码：点「如何生成令牌？」会打开 GitHub 生成页（勾选 repo 权限），把生成结果粘贴到上面输入框即可。不想上传也可以只用「数据页 → 导出诊断」手动反馈。" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="令牌仅由你粘贴，保存在本机 Windows 凭据管理器（PopGlot/telemetry/github），不写入配置文件或日志；留空保留已保存的令牌。" />
                <TextBlock x:Name="IssueUploadStatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                           FontSize="12" LineHeight="17"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Route status card -->
        <Border x:Name="RouteCard" Visibility="Collapsed" Style="{StaticResource InlineCard}" Margin="0,6,0,14" Padding="12,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock x:Name="RouteCardTitle" Text="当前实际线路" Style="{StaticResource FieldLabel}"
                               Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Border x:Name="RouteBadge" Style="{StaticResource StatusPill}"
                            Padding="7,2" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}">
                        <TextBlock x:Name="RouteBadgeText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" Text="本地 OCR" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="RoutePreviewText" TextWrapping="Wrap"
                           FontSize="12" LineHeight="17"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="RouteDraftNote" Style="{StaticResource Caption}"
                         Margin="0,4,0,0" Visibility="Collapsed"
                         Text="保存后线路将按新设置重新评估。" />
            </StackPanel>
        </Border>

        <!-- Advanced settings expander: Outbound details & Local OCR language packs -->
        <Expander Header="高级设置" Margin="0,0,0,12">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="云端翻译" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                <Grid Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="允许连接云端翻译服务" Style="{StaticResource RowTitle}" />
                    </StackPanel>
                    <ToggleButton x:Name="NetworkEnabledToggle"
                                  AutomationProperties.Name="允许连接云端翻译服务" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  Checked="ProviderGate_Changed" Unchecked="ProviderGate_Changed" />
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,0,0,12" />

                <Grid x:Name="FreeEngineConsentRow" Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static services:EngineWording.FreePublicTranslationName}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                   ToolTip="{x:Static services:EngineWording.FreeEngineOnlineServiceNote}"
                                   Text="免配置即开即用；仅传输文本，保障隐私安全" />
                        <TextBlock x:Name="FreeEngineConsentState" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="FreeEngineConsentActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="允许" Style="{StaticResource GhostButton}"
                                Padding="10,5" Click="AllowFreeEngine_Click" />
                        <Button Content="拒绝" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                                Padding="10,5" Click="DenyFreeEngine_Click" />
                        <Border Width="1" Height="14" Margin="10,0" VerticalAlignment="Center"
                                Background="{DynamicResource BorderSubtleBrush}" />
                        <Button Content="恢复询问" Style="{StaticResource GhostButton}"
                                Padding="10,5" Click="ResetFreeEngineConsent_Click" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,6,0,14" />

                <Grid x:Name="ScreenshotModeRow" Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="截图翻译方式" Style="{StaticResource RowTitle}" />
                    </StackPanel>
                    <ComboBox x:Name="ModeComboBox" Grid.Column="1" MaxWidth="280" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              AutomationProperties.Name="截图翻译方式"
                              SelectionChanged="ModeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="LocalOcr">本机识别文字（推荐）</ComboBoxItem>
                        <ComboBoxItem Tag="Auto">自动选择</ComboBoxItem>
                        <ComboBoxItem Tag="VisionOcr">视觉模型识别，文字模型翻译</ComboBoxItem>
                        <ComboBoxItem Tag="VisionDirect">视觉模型直接翻译图片</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,10,0,14" />

                <TextBlock Text="本机文字识别" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBlock x:Name="OcrStatusText" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                <Border Background="{DynamicResource InputBrush}" CornerRadius="{StaticResource ControlRadius}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="6" Margin="0,0,0,8">
                    <ListBox x:Name="OcrLanguagesListBox" MaxHeight="120"
                             IsHitTestVisible="False" />
                </Border>
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text='缺少语言包：Windows 设置 → 时间和语言 → 语言和区域 → 语言选项 → 光学字符识别' />
                </TextBlock>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
