<UserControl x:Class="PopGlot.Windows.Sections.LibrarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">

    <!-- Star row: the master–detail fills the window height; list and detail scroll separately. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="资料库" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="历史与生词只保存在本机。双击或按 Enter 将条目载入翻译工作台。" />
        </StackPanel>

        <!-- ==================== Master–detail ==================== -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Master: muted navigation-ish list surface; detail stays on main surface -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="ModeHistory" Style="{StaticResource SegmentButton}"
                                     GroupName="LibraryMode" IsChecked="True" Content="历史"
                                     Checked="Mode_Checked" Tag="History" />
                        <RadioButton x:Name="ModeVocabulary" Style="{StaticResource SegmentButton}"
                                     GroupName="LibraryMode" Content="生词"
                                     Checked="Mode_Checked" Tag="Vocabulary" />
                    </StackPanel>

                    <TextBox x:Name="LibrarySearchBox" Grid.Row="1" Height="34" Margin="0,0,0,8"
                             AutomationProperties.Name="搜索历史与生词"
                             local:Ui.Placeholder="搜索…"
                             TextChanged="LibrarySearch_TextChanged" />

                    <Grid Grid.Row="2">
                        <StackPanel x:Name="LibraryEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="24" Visibility="Collapsed">
                            <TextBlock x:Name="LibraryEmptyTitle" Text="暂无历史记录" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock x:Name="LibraryEmptyHint"
                                       Style="{StaticResource Caption}" MaxWidth="230"
                                       TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ListBox x:Name="LibraryListBox"
                                 SelectionChanged="LibraryList_SelectionChanged"
                                 KeyDown="LibraryList_KeyDown"
                                 MouseDoubleClick="LibraryList_MouseDoubleClick"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="270"
                                                       HorizontalAlignment="Left"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Timestamp}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Detail}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12.5" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock x:Name="LibraryCountText" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ExportMenuButton" Style="{StaticResource GhostButton}"
                                    Content="导出" Padding="10,5" Click="ExportMenuButton_Click" />
                            <Button x:Name="ClearCurrentButton" Style="{StaticResource GhostButton}"
                                    Margin="4,0,0,0" Content="清理" Padding="10,5"
                                    ToolTip="清空当前数据源的全部记录（点击两次确认）" Click="ClearCurrent_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Detail: the selected entry; long content scrolls inside the pane. -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="20,18">
                <Grid>
                    <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="选择一个条目查看详情" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="DetailContent">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource StatusPill}" Padding="8,2"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}">
                                <TextBlock x:Name="DetailKindText" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock x:Name="DetailMetaText" Style="{StaticResource Caption}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="原文" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DetailSourceText" Style="{StaticResource FlatTextBox}"
                                 IsReadOnly="True" TextWrapping="Wrap" FontSize="13.5"
                                 VerticalScrollBarVisibility="Auto"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock Text="译文" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                        <TextBox x:Name="DetailTranslationText" Style="{StaticResource FlatTextBox}"
                                 IsReadOnly="True" TextWrapping="Wrap" FontSize="14.5"
                                 VerticalScrollBarVisibility="Auto"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />

                        <TextBlock x:Name="DetailExplanationText" Style="{StaticResource Caption}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                                Margin="0,16,0,0" Padding="0,14,0,0">
                            <Grid>
                                <Button Content="删除" Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Left" Padding="12,7" Click="DeleteSelected_Click" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource GhostButton}" Content="朗读"
                                            Padding="12,7" Click="SpeakSelected_Click" />
                                    <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                            Content="复制译文" Padding="12,7" Click="CopySelected_Click" />
                                    <Button Margin="6,0,0,0" Content="载入到工作台"
                                            Padding="14,7" Click="LoadSelected_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
