<UserControl x:Class="PopGlot.Windows.Sections.LibrarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows"
             PreviewKeyDown="Section_PreviewKeyDown">

    <!-- High-density Master-Detail & Property List desktop workstation -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0.1.30：单行工具栏——去重复大标题；搜索改为紧凑内嵌图标输入框。 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" MinWidth="8" />
                <ColumnDefinition Width="100*" MaxWidth="248" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ModeHistory" Style="{StaticResource SegmentButton}"
                             GroupName="LibraryMode" IsChecked="True" Content="历史"
                             Checked="Mode_Checked" Tag="History" />
                <RadioButton x:Name="ModeVocabulary" Style="{StaticResource SegmentButton}"
                             GroupName="LibraryMode" Content="生词"
                             Checked="Mode_Checked" Tag="Vocabulary" />
            </StackPanel>

            <Grid x:Name="LibrarySearchHost" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                <TextBox x:Name="LibrarySearchBox"
                         Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center"
                         Style="{StaticResource FormTextBox}" local:Ui.ContentPadding="28,0,8,0"
                         AutomationProperties.Name="搜索当前列表"
                         local:Ui.Placeholder="搜索原文或译文"
                         TextChanged="LibrarySearch_TextChanged" />
                <Path Width="12" Height="12" Stretch="Uniform" IsHitTestVisible="False"
                      Data="{StaticResource IconSearch}" HorizontalAlignment="Left" Margin="9,0,0,0"
                      Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RetryVocabularyButton" Style="{StaticResource IconButton}"
                        local:Ui.Icon="{StaticResource IconRetry}" Margin="0,0,4,0"
                        Visibility="Collapsed"
                        ToolTip="重新加载"
                        AutomationProperties.Name="重试加载生词本"
                        Click="RetryVocabularyButton_Click" />
                <Button x:Name="ExportMenuButton" Style="{StaticResource IconButton}"
                        local:Ui.Icon="{StaticResource IconExport}" Margin="0,0,4,0"
                        ToolTip="导出" AutomationProperties.Name="导出当前列表"
                        Click="ExportMenuButton_Click" />
                <Button x:Name="ClearCurrentButton" Style="{StaticResource IconButton}"
                        local:Ui.Icon="{StaticResource IconDelete}"
                        Foreground="{DynamicResource DangerBrush}"
                        ToolTip="清空当前列表" AutomationProperties.Name="清空当前列表" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1">
            <Border x:Name="LibraryUndoBar" Margin="0,8,0,0" Padding="10,6"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}"
                    AutomationProperties.Name="删除撤销提示">
                <!-- 消息独占弹性列可换行；撤销按钮固定宽度，不被长消息挤出。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LibraryUndoText" Grid.Column="0" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Text="已删除"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <Button x:Name="LibraryUndoButton" Grid.Column="1"
                            Style="{StaticResource GhostButton}" Content="撤销" Padding="10,2"
                            ToolTip="恢复刚才删除的条目" AutomationProperties.Name="撤销刚才的删除"
                            Click="LibraryUndo_Click" />
                </Grid>
            </Border>
            <Border x:Name="LibraryExportBar" Margin="0,8,0,0" Padding="10,6"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}"
                    AutomationProperties.Name="导出结果提示">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Text="已导出" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 主要后续操作在前；「关闭」是图标按钮 + 完整读屏名。 -->
                        <Button x:Name="OpenExportFileButton" Margin="0,0,8,0"
                                Style="{StaticResource GhostButton}" Content="打开文件" Padding="10,2"
                                ToolTip="打开刚导出的文件" AutomationProperties.Name="打开导出文件"
                                Click="OpenExportFile_Click" />
                        <Button x:Name="OpenExportFolderButton"
                                Style="{StaticResource GhostButton}" Content="所在文件夹" Padding="10,2"
                                ToolTip="打开导出文件所在的文件夹" AutomationProperties.Name="打开导出文件夹"
                                Click="OpenExportFolder_Click" />
                        <Button x:Name="DismissExportButton" Style="{StaticResource IconButton}"
                                Width="26" Height="26" Margin="6,0,0,0"
                                local:Ui.Icon="{StaticResource IconClose}"
                                ToolTip="关闭导出提示" AutomationProperties.Name="关闭导出提示"
                                Click="DismissExport_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>

        <!-- ==================== Master–Detail Surface ==================== -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}">
            <Grid x:Name="LibrarySplitGrid" SizeChanged="LibrarySplitGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="320" MinWidth="220" MaxWidth="460" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="8" />
                    <ColumnDefinition x:Name="DetailColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ==================== Master Column: List ==================== -->
                <Grid x:Name="ListPane" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="LibraryEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="16" Visibility="Collapsed">
                        <TextBlock x:Name="LibraryEmptyTitle" Text="暂无历史记录" Style="{StaticResource SectionTitle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock x:Name="LibraryEmptyHint"
                                   Style="{StaticResource Caption}" MaxWidth="220"
                                   TextAlignment="Center" HorizontalAlignment="Center" />
                        <Button x:Name="InlineRetryVocabularyButton" Style="{StaticResource PrimaryButton}"
                                Content="重试加载" Padding="14,6" Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                ToolTip="重新读取生词本"
                                AutomationProperties.Name="重试加载生词本"
                                Click="RetryVocabularyButton_Click" />
                    </StackPanel>

                    <ListBox x:Name="LibraryListBox" Grid.Row="0"
                             Background="Transparent" BorderThickness="0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyDown="LibraryList_KeyDown"
                             MouseDoubleClick="LibraryList_MouseDoubleClick"
                             SelectionChanged="LibraryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding TitleOneLine}" />
                                <Setter Property="Padding" Value="12,9" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TitleOneLine}" Style="{StaticResource Body}"
                                                   FontWeight="SemiBold" ToolTip="{Binding TitleOneLine}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Style="{StaticResource Metadata}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" ToolTip="{Binding FullTimestamp}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding DetailOneLine}" Style="{StaticResource Caption}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailOneLine}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Master bottom summary line -->
                    <Border x:Name="MasterSummaryBorder" Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,0,9" Padding="12,6">
                        <TextBlock x:Name="LibraryCountText" Style="{StaticResource Metadata}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- ==================== Column Splitter ==================== -->
                <GridSplitter x:Name="LibrarySplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                              Cursor="SizeWE" ShowsPreview="False">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Border Width="1" HorizontalAlignment="Center"
                                                Background="{DynamicResource BorderSubtleBrush}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.75" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <!-- ==================== Detail Column: Property List Inspector ==================== -->
                <Border x:Name="DetailPane" Grid.Column="2" Background="{DynamicResource CanvasBrush}"
                        CornerRadius="0,9,9,0">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="LibraryBackButton" Grid.Row="0" HorizontalAlignment="Left"
                            Margin="12,8,0,0" Padding="10,2" Visibility="Collapsed"
                            Style="{StaticResource GhostButton}" Content="返回列表"
                            ToolTip="返回资料列表，保留当前选中项"
                            AutomationProperties.Name="返回资料列表"
                            Click="LibraryBack_Click" />
                    <Grid Grid.Row="1">
                    <!-- Nothing selected placeholder -->
                    <StackPanel x:Name="DetailPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                        <TextBlock Text="未选择条目" Style="{StaticResource SectionTitle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock x:Name="DetailPlaceholderHints" Style="{StaticResource Caption}" MaxWidth="380" TextAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="方向键切换 · Enter 载入工作台 · Ctrl+P 朗读 · Ctrl+Shift+C 复制译文 · Delete 删除" />
                    </StackPanel>

                    <!-- Selected entry: property list inspector style -->
                    <Grid x:Name="DetailScroll" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="DetailContent" Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,14">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Property list header table -->
                                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource ControlRadius}" Padding="12,8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="语言方向" Style="{StaticResource Metadata}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="DetailLanguagePair" Style="{StaticResource BodyStrong}"
                                                       FontSize="12.5" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSubtleBrush}"
                                                Margin="0,6" />
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="来源与时间" Style="{StaticResource Metadata}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="DetailKind" Style="{StaticResource Metadata}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Source Property Block -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="原文" Style="{StaticResource FieldLabel}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="CardCopySourceButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                            local:Ui.Icon="{StaticResource IconCopy}" Width="28" Height="28" Padding="0"
                                            ToolTip="复制原文" AutomationProperties.Name="复制所选原文" Click="CardCopySource_Click" />
                                </Grid>
                                <Border Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource ControlRadius}" Padding="12,10">
                                    <TextBox x:Name="DetailSource" Style="{StaticResource ResultTextBox}"
                                             IsReadOnly="True" TextWrapping="Wrap" FontSize="13"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="已保存的原文" />
                                </Border>

                                <!-- Translation Property Block -->
                                <TextBlock Text="译文" Style="{StaticResource FieldLabel}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,12,0,4" />
                                <Border Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource ControlRadius}" Padding="12,10">
                                    <RichTextBox x:Name="DetailTranslation"
                                                 Style="{StaticResource FlatRichTextBox}"
                                                 IsReadOnly="True" IsDocumentEnabled="True"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 AutomationProperties.Name="已保存的译文" />
                                </Border>

                                <!-- Explanation Property Block -->
                                <Grid x:Name="DetailExplanationHeader" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="解释" Style="{StaticResource FieldLabel}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="CardCopyExplanationButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                            local:Ui.Icon="{StaticResource IconCopy}" Width="28" Height="28" Padding="0"
                                            ToolTip="复制解释" AutomationProperties.Name="复制所选解释" Click="CardCopyExplanation_Click" />
                                </Grid>
                                <TextBlock x:Name="DetailExplanation" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <ItemsControl x:Name="DetailTermsList" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TokenChipButton}"
                                                    Content="{Binding}" Margin="0,2,4,2"
                                                    AutomationProperties.Name="复制术语"
                                                    Click="DetailTermChip_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Pinned bottom action bar -->
                        <Border x:Name="DetailFooterBorder" Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,9,0" Padding="12,5">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CardSpeakButton" Style="{StaticResource IconButton}" Margin="0,3,0,3"
                                        ToolTip="朗读" AutomationProperties.Name="朗读所选记录" Click="CardSpeak_Click">
                                    <Path x:Name="CardSpeakIcon" Width="12" Height="12" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="{StaticResource IconSpeaker}" />
                                </Button>
                                <Button x:Name="CardCopyButton" Style="{StaticResource IconButton}"
                                        Width="Auto" MinWidth="32" Height="32" Padding="8,0" Margin="6,3,0,3"
                                        ToolTip="复制译文 (Ctrl+Shift+C)"
                                        AutomationProperties.Name="复制所选译文" Click="CardCopy_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconCopy}" VerticalAlignment="Center" />
                                        <TextBlock Text="复制译文" FontSize="12" Margin="4,0,0,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="6,3,0,3"
                                        Content="载入工作台" Padding="12,4" ToolTip="载入工作台 (Enter)" Click="CardLoad_Click" />
                                <Button x:Name="CardDeleteButton" Style="{StaticResource DangerButton}" Margin="6,3,0,3"
                                        Content="删除" Padding="12,4" Click="CardDelete_Click"
                                        ToolTip="删除此条记录 (Delete)"
                                        AutomationProperties.Name="删除此条记录" />
                            </WrapPanel>
                        </Border>
                    </Grid>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
