<UserControl x:Class="PopGlot.Windows.Sections.DataSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">

    <!-- Second group of the "隐私与数据" page: flat rows for data lifecycle. -->
    <StackPanel>
        <TextBlock Text="本地数据" Style="{StaticResource SectionTitle}" Margin="0,20,0,14" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="保存本地翻译历史" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="最多 200 条，保留 90 天；疑似密钥与过大内容不记录" />
            </StackPanel>
            <ToggleButton x:Name="HistoryEnabledToggle"
                          AutomationProperties.Name="保存本地翻译历史" Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="清空全部历史记录" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="删除 history.json 中的全部记录，不可恢复" />
            </StackPanel>
            <Button x:Name="ClearHistoryButton" Grid.Column="1" Content="清空历史"
                    Style="{StaticResource DangerButton}" Click="ClearHistory_Click" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="清空生词本" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="删除全部生词与收藏，不可恢复" />
            </StackPanel>
            <Button x:Name="ClearVocabularyButton" Grid.Column="1" Content="清空生词本" Style="{StaticResource DangerButton}"
                    Click="ClearVocabulary_Click" />
        </Grid>
    </StackPanel>
</UserControl>

