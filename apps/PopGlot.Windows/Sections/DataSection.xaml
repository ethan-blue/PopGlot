<UserControl x:Class="PopGlot.Windows.Sections.DataSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">

    <!-- Compact desktop property list -->
    <StackPanel Margin="0,6,0,0">
        <TextBlock Text="本地存储" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="保存本地翻译历史" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="最多 200 条 · 保留 90 天" />
            </StackPanel>
            <ToggleButton x:Name="HistoryEnabledToggle"
                          AutomationProperties.Name="保存本地翻译历史" Grid.Column="1"
                          VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitch}" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" Margin="0,0,0,6" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="清空翻译历史" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}" Text="清空全部历史，支持短时撤销"
                           ToolTip="移除本地全部翻译历史记录；清空后支持短时撤销。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="UndoHistoryButton" Content="撤销" Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Style="{StaticResource GhostButton}" Padding="12,5"
                    ToolTip="恢复刚才清空的历史" AutomationProperties.Name="撤销清空历史"
                    Click="UndoHistory_Click" />
            <Button x:Name="ClearHistoryButton" Content="清空历史"
                    VerticalAlignment="Center"
                    Style="{StaticResource DangerButton}" Padding="12,5" ToolTip="清空全部历史记录"
                    Click="ClearHistory_Click" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" Margin="0,0,0,6" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="清空生词本" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}" Text="清空全部生词，支持短时撤销"
                           ToolTip="移除本地收藏的全部生词条目；清空后支持短时撤销。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="UndoVocabularyButton" Content="撤销" Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Style="{StaticResource GhostButton}" Padding="12,5"
                    ToolTip="恢复刚才清空的生词" AutomationProperties.Name="撤销清空生词本"
                    Click="UndoVocabulary_Click" />
            <Button x:Name="ClearVocabularyButton" Content="清空生词本"
                    VerticalAlignment="Center"
                    Style="{StaticResource DangerButton}" Padding="12,5" ToolTip="清空全部生词"
                    Click="ClearVocabulary_Click" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" Margin="0,0,0,12" />

        <TextBlock Text="备份与恢复" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="导出数据备份" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}" Text="历史、生词与非敏感设置 · 不含密钥"
                           ToolTip="导出本地历史、生词本与非敏感设置为 JSON 文件，不含密钥。" />
            </StackPanel>
            <Button x:Name="ExportBackupButton" Grid.Column="1" Content="导出备份"
                    VerticalAlignment="Center"
                    Style="{StaticResource GhostButton}" Padding="14,5"
                    AutomationProperties.Name="导出数据备份"
                    Click="ExportBackup_Click" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" Margin="0,0,0,6" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="恢复数据备份" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}" Text="覆盖前自动保留本地还原快照"
                           ToolTip="从备份文件还原历史与配置；覆盖前自动创建本地还原快照。" />
            </StackPanel>
            <Button x:Name="ImportBackupButton" Grid.Column="1" Content="恢复备份"
                    VerticalAlignment="Center"
                    Style="{StaticResource GhostButton}" Padding="14,5"
                    AutomationProperties.Name="恢复数据备份"
                    Click="ImportBackup_Click" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" Margin="0,0,0,12" />

        <TextBlock Text="排障诊断" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="导出排障诊断包" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}" Text="脱敏系统信息与日志 · 不含翻译或密钥"
                           ToolTip="导出脱敏的系统版本、运行日志与诊断信息，不含翻译原文、译文或密钥。" />
            </StackPanel>
            <Button x:Name="ExportDiagnosticsButton" Grid.Column="1" Content="导出诊断"
                    VerticalAlignment="Center"
                    Style="{StaticResource GhostButton}" Padding="14,5"
                    AutomationProperties.Name="导出排障诊断包"
                    Click="ExportDiagnostics_Click" />
        </Grid>
    </StackPanel>
</UserControl>
