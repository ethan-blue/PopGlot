<UserControl x:Class="PopGlot.Windows.Sections.TranslateSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows"
             KeyDown="TranslateSection_KeyDown">

    <!-- High-density single-plane dual-column workstation -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- N-ONB: non-blocking three-step first-run guide. It lives INSIDE
             the workbench (no modal, no new window), reuses the existing
             add-engine / free-consent paths, and can be skipped at any
             point; skip/complete persists through the shell flag. -->
        <Border x:Name="OnboardingBanner" Grid.Row="0" Visibility="Collapsed"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="OnboardingStepLabel" Style="{StaticResource Metadata}"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="OnboardingTitle" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,2" />
                    <TextBlock x:Name="OnboardingDescription" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="OnboardingPrimaryButton" Style="{StaticResource PrimaryButton}"
                            Padding="14,6" MinWidth="92" Click="OnboardingPrimary_Click" />
                    <Button x:Name="OnboardingSkipButton" Style="{StaticResource GhostButton}"
                            Padding="10,6" Margin="8,0,0,0" Content="跳过引导"
                            AutomationProperties.Name="跳过新手引导"
                            ToolTip="可在「设置 → 通用」重新显示"
                            Click="OnboardingSkip_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top ToolBar: Workbench title left, primary actions right -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="翻译工作台" Style="{StaticResource PageTitle}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TranslateShortcutHint" Text="Enter 翻译 · Shift+Enter 换行"
                           Style="{StaticResource Metadata}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="StyleSelectorButton" Style="{StaticResource GhostButton}"
                        Padding="10,6" Margin="0,0,8,0"
                        AutomationProperties.Name="翻译风格"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="翻译风格（下一次翻译生效）"
                        Click="StyleSelector_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Fill="{DynamicResource AccentBrush}"
                              Data="{StaticResource IconStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StyleSelectorLabel" Text="风格" Margin="6,0,0,0"
                                   VerticalAlignment="Center" MaxWidth="120"
                                   TextTrimming="CharacterEllipsis" />
                        <Path Width="8" Height="8" Stretch="Uniform" Margin="5,0,0,0"
                              Fill="{DynamicResource TextTertiaryBrush}"
                              Data="{StaticResource IconChevronDown}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RestoreSessionButton" Style="{StaticResource GhostButton}"
                        Padding="10,6" Margin="0,0,8,0" Content="恢复"
                        ToolTip="恢复上次暂存内容"
                        AutomationProperties.Name="恢复暂存会话"
                        Click="RestoreSession_Click" />
                <Button x:Name="TranslateButton" Style="{StaticResource PrimaryButton}"
                        Padding="18,6" Content="翻译" Click="Translate_Click" />
            </StackPanel>

            <!-- Hairline loading progress bar -->
            <ProgressBar x:Name="TranslateProgress" Height="2" IsIndeterminate="True"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Bottom" Visibility="Collapsed" />
        </Grid>

        <!--
            Single-plane dual-column work surface: unified container, hairline separator,
            symmetrical toolbars, maximized text editing and reading area.
        -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}">
            <Grid x:Name="TranslatePaneGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="40" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <!-- ==================== Left Column: Source ==================== -->

                <!-- Source language bar: "原文" on left, auto hint & picker near center axis on right -->

                <Border x:Name="SourceLangBarCell" Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceMutedBrush}"

                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"

                        Padding="12,6,8,6">

                    <Grid>

                        <TextBlock Text="原文" Style="{StaticResource FieldLabel}"

                                   Foreground="{DynamicResource TextSecondaryBrush}"

                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0"

                                   HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            <ComboBox x:Name="TranslateSourceLang"

                                      MinWidth="100" MaxWidth="140"

                                      Style="{StaticResource LanguagePickerComboBox}"

                                      AutomationProperties.Name="源语言"

                                      SelectionChanged="SourceLang_SelectionChanged" />

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- Source text editor (maximized area) -->

                <Border x:Name="SourceEditorCell" Grid.Row="1" Grid.Column="0" Background="{DynamicResource InputBrush}" Padding="12,10">

                    <TextBox x:Name="TranslateInput"

                             Style="{StaticResource FlatTextBox}"

                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"

                             FontSize="14.5"

                             Foreground="{DynamicResource TextPrimaryBrush}"

                             AutomationProperties.Name="翻译原文输入框"

                             AutomationProperties.HelpText="Enter 翻译 · Shift+Enter 换行"

                             local:Ui.Placeholder="输入要翻译的文本…"

                             TextChanged="TranslateInput_TextChanged"

                             KeyDown="TranslateInput_KeyDown" />

                </Border>



                <!-- Source action footer -->

                <Border x:Name="SourceFooterCell" Grid.Row="2" Grid.Column="0" Background="{DynamicResource SurfaceMutedBrush}"

                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"

                        Padding="12,5">

                    <Grid>

                        <TextBlock x:Name="TranslateCounter" Style="{StaticResource Metadata}"

                                   Foreground="{DynamicResource TextTertiaryBrush}"

                                   HorizontalAlignment="Left" VerticalAlignment="Center"

                                   Visibility="Collapsed"

                                   Text="0 字符" TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                            <Button x:Name="TranslateSourceSpeakButton" Style="{StaticResource IconButton}" Width="32" Height="32"

                                    AutomationProperties.Name="朗读原文" ToolTip="朗读原文"

                                    Click="TranslateSourceSpeak_Click">

                                <Path x:Name="TranslateSourceSpeakIcon" Width="12" Height="12" Stretch="Uniform"

                                      Fill="{DynamicResource TextSecondaryBrush}"

                                      Data="{StaticResource IconSpeaker}" />

                            </Button>

                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0"

                                    AutomationProperties.Name="复制原文" ToolTip="复制原文"

                                    Click="TranslateSourceCopy_Click">

                                <Path Width="12" Height="12" Stretch="Uniform"

                                      Fill="{DynamicResource TextSecondaryBrush}"

                                      Data="{StaticResource IconCopy}" />

                            </Button>

                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0"

                                    AutomationProperties.Name="合并断行"

                                    ToolTip="合并断行"

                                    Click="TranslateMergeLines_Click">

                                <Path Width="12" Height="12" Stretch="Uniform"

                                      Fill="{DynamicResource TextSecondaryBrush}"

                                      Data="{StaticResource IconMergeLines}" />

                            </Button>

                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0"

                                    AutomationProperties.Name="清空原文"

                                    ToolTip="清空原文"

                                    Click="TranslateClear_Click">

                                <Path Width="12" Height="12" Stretch="Uniform"

                                      Fill="{DynamicResource TextSecondaryBrush}"

                                      Data="{StaticResource IconClear}" />

                            </Button>

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- ==================== Center Column: Axis & Swap ==================== -->

                <!-- Center top bar cell matching Row 0 background and bottom border -->

                <Border x:Name="AxisTopCell" Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceMutedBrush}"

                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" />



                <!-- Language swap button: strictly placed in dedicated center column Grid.Column=1, Grid.Row=0 -->

                <Button x:Name="TranslateSwapButton" Grid.Row="0" Grid.Column="1"

                        Style="{StaticResource IconButton}"

                        HorizontalAlignment="Center" VerticalAlignment="Center"

                        Width="32" Height="32"

                        ToolTip="交换语言方向" AutomationProperties.Name="交换语言方向"

                        Click="TranslateSwap_Click">

                    <Path Width="12" Height="12" Stretch="Uniform"

                          Fill="{DynamicResource TextSecondaryBrush}"

                          Data="{StaticResource IconSwap}" />

                </Button>



                <!-- Center footer cell matching Row 2 background and top border -->

                <Border x:Name="AxisFooterCell" Grid.Row="2" Grid.Column="1" Background="{DynamicResource SurfaceMutedBrush}"

                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" />



                <!-- Center vertical line: 1px hairline drawn down the center spanning body and footer -->

                <Rectangle x:Name="AxisDividerLine" Grid.Row="1" Grid.RowSpan="1" Grid.Column="1"

                           Width="1" Fill="{DynamicResource BorderSubtleBrush}"

                           HorizontalAlignment="Center" SnapsToDevicePixels="True" />



                <!-- ==================== Right Column: Target ==================== -->

                <!-- Target language bar: picker on left near center axis, "译文/生成状态" on right -->

                <Border x:Name="TargetLangBarCell" Grid.Row="0" Grid.Column="2" Background="{DynamicResource SurfaceMutedBrush}"

                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"

                        Padding="8,6,12,6">

                    <Grid>

                        <ComboBox x:Name="TranslateTargetLang" HorizontalAlignment="Left"

                                  MinWidth="100" MaxWidth="140"

                                  Style="{StaticResource LanguagePickerComboBox}"

                                  AutomationProperties.Name="目标语言"

                                  SelectionChanged="TargetLang_SelectionChanged" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            <RadioButton x:Name="ShowTranslationChoice" Content="译文" GroupName="WorkbenchReading"
                                         Style="{StaticResource SegmentChoice}" IsChecked="True"
                                         AutomationProperties.Name="显示译文"
                                         ToolTip="翻译结果。说明附在译文下面，不用再单独解释。"
                                         Click="ShowTranslation_Click" />
                            <RadioButton x:Name="ShowSummaryChoice" Content="要点" GroupName="WorkbenchReading"
                                         Style="{StaticResource SegmentChoice}" Margin="0"
                                         AutomationProperties.Name="显示要点"
                                         ToolTip="整理原文要点，会额外使用一次模型额度。"
                                         Click="ShowSummary_Click" />

                            <Border x:Name="TranslateStreamIndicator" Visibility="Collapsed"

                                    Margin="8,0,0,0" Padding="6,2" CornerRadius="6"

                                    Background="{DynamicResource AccentSoftBrush}">

                                <TextBlock Text="正在生成…" Style="{StaticResource Metadata}"

                                           Foreground="{DynamicResource AccentBrush}"

                                           FontSize="11" VerticalAlignment="Center" />

                            </Border>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- Target text reader (maximized area, scrollable, shared with explanation) -->

                <Border x:Name="TargetEditorCell" Grid.Row="1" Grid.Column="2" Background="{DynamicResource ResultSurfaceBrush}" Padding="12,10">

                    <ScrollViewer x:Name="TranslateResultScroll" VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Grid MinHeight="140">

                                <TextBox x:Name="TranslateResult"

                                         Style="{StaticResource ResultTextBox}"

                                         AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"

                                         VerticalScrollBarVisibility="Disabled" FontSize="14.5"

                                         Foreground="{DynamicResource TextPrimaryBrush}"

                             AutomationProperties.LiveSetting="Off"
                              AutomationProperties.Name="翻译结果"

                             AutomationProperties.HelpText="译文将显示在这里" />




                                <RichTextBox x:Name="TranslateRichResult"
                                             Visibility="Collapsed"
                                             Style="{StaticResource FlatRichTextBox}"
                                             FontSize="14.5"
                                             Background="Transparent"
                                             IsReadOnly="True"
                                             IsDocumentEnabled="True"
                                             VerticalScrollBarVisibility="Disabled"
                                             AutomationProperties.LiveSetting="Off"
                                              AutomationProperties.Name="格式化翻译结果" />

                                <TextBox x:Name="TranslateStreamResult"

                                         Visibility="Collapsed"

                                         Focusable="False"

                                         IsHitTestVisible="True"

                                         Style="{StaticResource ResultTextBox}"

                                         AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"

                                         VerticalScrollBarVisibility="Disabled" FontSize="14.5"

                                         Foreground="{DynamicResource TextPrimaryBrush}"

                                         AutomationProperties.LiveSetting="Off"
                                          AutomationProperties.Name="流式翻译中" />

                                <!-- First-use guidance. Two disjoint states, one
                                     hierarchy per state (层级收敛) — never stacked
                                     with the result placeholder (removed: this card
                                     IS the empty-state surface).

                                     · Unconfigured: exactly two actions — 添加引擎
                                       (primary) and 允许联网免费引擎 (first-use
                                       consent, shown while undecided).
                                     · Normal idle: one title, one hint, one CTA
                                       (the offline demo example). -->

                                <StackPanel x:Name="TranslateEmptyState" VerticalAlignment="Center"

                                            HorizontalAlignment="Center">

                                    <!-- Unconfigured service guidance card. Shown whenever no fully
                                         configured user engine exists — the built-in free engine is a
                                         fallback route and never hides this entry. -->
                                    <StackPanel x:Name="UnconfiguredGuidePanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,0,8"
                                                Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconProvider}" Width="16" Height="16" Stretch="Uniform"
                                                  Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="GuideTitle" Text="尚未配置翻译引擎" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="GuideDescription" Text="添加翻译引擎后即可开始使用。"
                                                   Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,12" />
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button x:Name="EnableFreeEngineButton" Content="允许公共翻译"
                                                    Style="{StaticResource GhostButton}" Padding="10,6" Margin="4"
                                                    HorizontalAlignment="Center"
                                                    AutomationProperties.Name="允许公共翻译"
                                                    ToolTip="只把待翻译文本发给你选中的公共翻译（Google 或 MyMemory）；不发送截图、历史或密钥"
                                                    Click="EnableFreeEngine_Click" />
                                            <Button x:Name="GoToSettingsButton" Content="添加翻译引擎" Style="{StaticResource PrimaryButton}"
                                                    Padding="14,6" Margin="4" HorizontalAlignment="Center" Cursor="Hand"
                                                    AutomationProperties.Name="添加翻译引擎"
                                                    Click="OpenAddEngine_Click" />
                                            <Button x:Name="ViewOfflineUsageButton" Content="查看离线用法"
                                                    Style="{StaticResource GhostButton}" Padding="10,6" Margin="4"
                                                    HorizontalAlignment="Center"
                                                    AutomationProperties.Name="查看离线用法"
                                                    ToolTip="查看随包附带的离线使用指南"
                                                    Click="ViewOfflineUsage_Click" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Normal idle guidance: one title, one hint, one primary CTA. -->
                                    <StackPanel x:Name="NormalGuidePanel" HorizontalAlignment="Center">
                                        <TextBlock x:Name="ShortcutEntriesHint" Text="划词 Ctrl+Alt+W · 截图 Ctrl+Alt+Space"

                                                   Style="{StaticResource Caption}" HorizontalAlignment="Center"

                                                   Margin="0,0,0,12" Foreground="{DynamicResource TextTertiaryBrush}" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="填入示例" Style="{StaticResource GhostButton}" Padding="10,6"

                                                    AutomationProperties.Name="填入示例报错文本"

                                                    ToolTip="填入演示报错文本（不联网）"

                                                    Click="FillExample_Click" />
                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>

                            </Grid>

                            <StackPanel x:Name="TranslateExplanationBox" Margin="0,12,0,0" Visibility="Collapsed">
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="补充说明" Style="{StaticResource FieldLabel}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4" />
                                <TextBlock x:Name="TranslateExplanation" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl x:Name="TranslateTermsList" Margin="0,8,0,0" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TokenChipButton}"
                                                Content="{Binding}" Margin="0,2,4,2"
                                                AutomationProperties.Name="复制术语"
                                                Click="TranslateTermChip_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Target action footer (symmetrical to source) -->
                <Border x:Name="TargetFooterCell" Grid.Row="2" Grid.Column="2" Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                        Padding="12,5">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TranslateEngineBadge" Style="{StaticResource Metadata}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" Text="等待输入" />
                            <TextBlock x:Name="TranslateStatus" Style="{StaticResource Metadata}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis" Text="就绪"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="翻译状态" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TranslateResultSpeakButton" Style="{StaticResource IconButton}"
                                    Width="32" Height="32"
                                    AutomationProperties.Name="朗读译文" ToolTip="朗读译文"
                                    Click="TranslateResultSpeak_Click">
                                <Path x:Name="TranslateResultSpeakIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconSpeaker}" />
                            </Button>
                            <Button x:Name="TranslateResultCopyButton" Style="{StaticResource IconButton}"
                                    Width="32" Height="32" Margin="4,0,0,0"
                                    AutomationProperties.Name="复制译文" ToolTip="复制译文"
                                    Click="TranslateResultCopy_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconCopy}" />
                            </Button>
                            <Button x:Name="TranslateStarButton" Style="{StaticResource IconButton}"
                                    Width="32" Height="32" Margin="4,0,0,0"
                                    AutomationProperties.Name="收藏到生词本"
                                    ToolTip="收藏到生词本" Click="TranslateStar_Click">
                                <Path x:Name="TranslateStarIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconStar}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
