<UserControl x:Class="PopGlot.Windows.Sections.TranslateSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">

    <!-- Star row keeps the dual panes filling the window height; each pane scrolls itself. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Header: title left, the single primary action right -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="翻译" Style="{StaticResource PageTitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="TranslateShortcutHint" Text="Enter 翻译 · Shift+Enter 换行"
                           Style="{StaticResource Metadata}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource GhostButton}" Content="清空"
                        Padding="10,5" Click="TranslateClear_Click" />
                <Button x:Name="TranslateButton" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Padding="20,7" Content="翻译" Click="Translate_Click" />
            </StackPanel>
        </Grid>

        <!-- Dual pane: source left (editable input), target right (read-only result) -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Left: Source Pane ================= -->
            <Border Grid.Column="0" Background="{DynamicResource InputBrush}"
                    CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="原文" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="TranslateSourceLang" HorizontalAlignment="Right"
                                  Width="136" Style="{StaticResource CompactComboBox}"
                                  AutomationProperties.Name="源语言"
                                  SelectionChanged="SourceLang_SelectionChanged" />
                    </Grid>

                    <TextBox x:Name="TranslateInput" Grid.Row="1" MinHeight="140"
                             Style="{StaticResource FlatTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="14"
                             AutomationProperties.Name="翻译原文输入框"
                             local:Ui.Placeholder="输入或粘贴要翻译的内容，Enter 立即翻译，Shift+Enter 换行…"
                             TextChanged="TranslateInput_TextChanged"
                             KeyDown="TranslateInput_KeyDown" />

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="TranslateCounter" Style="{StaticResource Metadata}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Text="0 字符" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="26"
                                    AutomationProperties.Name="朗读原文" ToolTip="朗读原文"
                                    Click="TranslateSourceSpeak_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconSpeaker}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="26"
                                    AutomationProperties.Name="复制原文" ToolTip="复制原文"
                                    Click="TranslateSourceCopy_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconCopy}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="26"
                                    AutomationProperties.Name="合并断行"
                                    ToolTip="合并 PDF 复制产生的换行"
                                    Click="TranslateMergeLines_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconMergeLines}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= Center: Swap ================= -->
            <Button x:Name="TranslateSwapButton" Grid.Column="1" Style="{StaticResource IconButton}"
                    Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip="交换语言方向" AutomationProperties.Name="交换语言方向"
                    Click="TranslateSwap_Click">
                <Path Width="13" Height="13" Stretch="Uniform"
                      Fill="{DynamicResource TextSecondaryBrush}"
                      Data="{StaticResource IconSwap}" />
            </Button>

            <!-- ================= Right: Target Pane (the result is the focus) ================= -->
            <!-- 与左侧原文栏同底色同边框：左右卡片此前一白一灰，完成翻译时
                 右侧观感与输入时不一致。 -->
            <Border Grid.Column="2" Background="{DynamicResource InputBrush}"
                    CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="译文" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border x:Name="TranslateStreamIndicator" Visibility="Collapsed"
                                    Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="正在生成" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <ComboBox x:Name="TranslateTargetLang" HorizontalAlignment="Right"
                                  Width="136" Style="{StaticResource CompactComboBox}"
                                  AutomationProperties.Name="目标语言"
                                  SelectionChanged="TargetLang_SelectionChanged" />
                    </Grid>

                    <Grid Grid.Row="1" MinHeight="140">
                        <TextBox x:Name="TranslateResult"
                                 Style="{StaticResource FlatTextBox}"
                                 AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="14.5"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 AutomationProperties.Name="翻译结果"
                                 local:Ui.Placeholder="译文将显示在这里…" />

                        <TextBox x:Name="TranslateStreamResult"
                                 Visibility="Collapsed"
                                 Focusable="False"
                                 IsHitTestVisible="True"
                                 Style="{StaticResource FlatTextBox}"
                                 AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="14.5"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 AutomationProperties.Name="流式翻译中" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TranslateEngineBadge" Style="{StaticResource Metadata}"
                                       Text="等待输入" />
                            <TextBlock x:Name="TranslateStatus" Style="{StaticResource Metadata}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       MaxWidth="300" TextTrimming="CharacterEllipsis" Text="就绪"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="翻译状态" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TranslateResultSpeakButton" Style="{StaticResource IconButton}" Width="28" Height="26"
                                    AutomationProperties.Name="朗读译文" ToolTip="朗读译文"
                                    Click="TranslateResultSpeak_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconSpeaker}" />
                            </Button>
                            <Button x:Name="TranslateResultCopyButton" Style="{StaticResource IconButton}" Width="28" Height="26"
                                    AutomationProperties.Name="复制译文" ToolTip="复制译文"
                                    Click="TranslateResultCopy_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconCopy}" />
                            </Button>
                            <Button x:Name="TranslateStarButton" Style="{StaticResource IconButton}"
                                    Width="28" Height="26"
                                    AutomationProperties.Name="收藏到生词本"
                                    ToolTip="收藏到生词本" Click="TranslateStar_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconStar}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Translation progress -->
        <ProgressBar x:Name="TranslateProgress" Grid.Row="2" Height="2" IsIndeterminate="True"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="Transparent" BorderThickness="0"
                     Visibility="Collapsed" Margin="0,8,0,0" />

        <!-- Explanation: flat section, no decorative card; capped and scrollable so it
             can never squeeze the dual panes away. -->
        <ScrollViewer x:Name="TranslateExplanationBox" Grid.Row="3" Visibility="Collapsed"
                      MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
                <TextBlock Text="补充说明" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,6" />
                <TextBlock x:Name="TranslateExplanation" Style="{StaticResource Caption}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>