<UserControl x:Class="PopGlot.Windows.Sections.ShortcutsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">
    <UserControl.Resources>
        <Style x:Key="ShortcutRow" TargetType="Border">
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        </Style>
        <Style x:Key="ShortcutLabel" TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ShortcutRecorder" TargetType="local:HotkeyRecorder" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Width" Value="170" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="AutomationProperties.HelpText" Value="点击后按下组合键，也支持单按 F1–F12 或 PrintScreen；截悬停菜单或提示框时推荐 F1、PrintScreen 或不含 Alt 的组合；Esc 取消，退格或右键可停用" />
            <Setter Property="ToolTip" Value="点击后按下组合键，也支持单按 F1–F12 或 PrintScreen；截悬停菜单或提示框时推荐 F1、PrintScreen 或不含 Alt 的组合；Esc 取消，退格或右键可停用" />
        </Style>
        <Style x:Key="ClearShortcutButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="ToolTip" Value="停用此快捷键" />
            <Setter Property="AutomationProperties.Name" Value="停用此快捷键" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="点击后直接按键录制（支持单按 F1–F12 / PrintScreen）；Esc 取消，点 × 停用" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="ProbeAvailabilityButton" Content="检测占用" Style="{StaticResource GhostButton}"
                        Height="26" Padding="10,2" Margin="0,0,6,0" FontSize="12"
                        AutomationProperties.Name="检测快捷键占用" ToolTip="检查当前全局快捷键是否被其他软件占用"
                        Click="ProbeAvailabilityButton_Click" />
                <Button x:Name="ResetDefaultsButton" Style="{StaticResource IconButton}"
                        local:Ui.Icon="{StaticResource IconRetry}" Width="26" Height="26"
                        AutomationProperties.Name="恢复默认快捷键" ToolTip="恢复默认快捷键"
                        Click="ResetDefaultsButton_Click" />
            </StackPanel>
        </Grid>

        <!-- 常用翻译快捷键：开门见山，傻瓜式直达 -->
        <Border Style="{StaticResource ShortcutRow}"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
            <TextBlock Text="划词翻译" Style="{StaticResource ShortcutLabel}"/>
            <local:HotkeyRecorder x:Name="SelectionHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="划词翻译"/>
            <Button x:Name="ClearSelectionButton" Grid.Column="2" Style="{StaticResource ClearShortcutButton}" local:Ui.Icon="{StaticResource IconCaptionClose}" AutomationProperties.Name="停用划词翻译快捷键" Tag="Selection" Click="ClearShortcutButton_Click"/>
        </Grid></Border>
        <Border Style="{StaticResource ShortcutRow}"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
            <TextBlock Text="截图翻译" Style="{StaticResource ShortcutLabel}"/>
            <local:HotkeyRecorder x:Name="ScreenshotHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}"
                                  AutomationProperties.Name="截图翻译"
                                  AutomationProperties.HelpText="点击后按下组合键，也支持单按 F1–F12 或 PrintScreen；截悬停菜单或提示框时推荐 F1、PrintScreen 或不含 Alt 的组合；Esc 取消，退格或右键可停用"
                                  HelpTip="点击后按下组合键，也支持单按 F1–F12 或 PrintScreen；截悬停菜单或提示框时推荐 F1、PrintScreen 或不含 Alt 的组合；Esc 取消，退格或右键可停用"
                                  ToolTip="点击后按下组合键，也支持单按 F1–F12 或 PrintScreen；截悬停菜单或提示框时推荐 F1、PrintScreen 或不含 Alt 的组合；Esc 取消，退格或右键可停用"/>
            <Button x:Name="ClearScreenshotButton" Grid.Column="2" Style="{StaticResource ClearShortcutButton}" local:Ui.Icon="{StaticResource IconCaptionClose}" AutomationProperties.Name="停用截图翻译快捷键" Tag="Screenshot" Click="ClearShortcutButton_Click"/>
        </Grid></Border>
        <Border Style="{StaticResource ShortcutRow}"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
            <TextBlock Text="极速查词" Style="{StaticResource ShortcutLabel}"/>
            <local:HotkeyRecorder x:Name="QuickSearchHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="极速查词快捷键"/>
            <Button x:Name="ClearQuickSearchButton" Grid.Column="2" Style="{StaticResource ClearShortcutButton}" local:Ui.Icon="{StaticResource IconCaptionClose}" AutomationProperties.Name="停用极速查词快捷键" Tag="QuickSearch" Click="ClearShortcutButton_Click"/>
        </Grid></Border>

        <!-- 实时冲突与一键建议条（仅在冲突、被占用或手动检测时显示） -->
        <Border x:Name="ShortcutDiagnosticBar" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,7"
                CornerRadius="{StaticResource ControlRadius}"
                Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ShortcutDiagnosticText" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button x:Name="ShortcutFixButton" Grid.Column="1" Margin="10,0,0,0"
                        Style="{StaticResource GhostButton}" Height="26" Padding="10,2" FontSize="12"
                        Visibility="Collapsed" Click="ShortcutFixButton_Click" />
            </Grid>
        </Border>

        <!-- 更多快捷键：默认折叠，降低配置负担 -->
        <Expander x:Name="MoreShortcutsExpander" Header="更多快捷键（窗口与界面操作）" Margin="0,12,0,0" IsExpanded="False">
            <Grid x:Name="ShortcutGroups" Margin="0,8,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ShortcutGutter" Width="24"/>
                    <ColumnDefinition x:Name="ShortcutRightColumn" Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="全局控制" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" ToolTip="在任何应用中可用" />
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="打开主窗口" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="ShowWindowHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="打开主窗口快捷键"/>
                    </Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="关闭浮窗" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="CloseHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="关闭浮窗"/>
                    </Grid></Border>
                </StackPanel>
                <StackPanel x:Name="InterfaceShortcutGroup" Grid.Column="2">
                    <TextBlock Text="窗口内" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" ToolTip="PopGlot 窗口聚焦时可用" />
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="切换模型" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="InterfaceModelHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="切换当前模型快捷键"/>
                    </Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="切换风格" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="InterfaceStyleHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="切换翻译风格快捷键"/>
                    </Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="互换语言" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="InterfaceSwapHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="互换源目标语言快捷键"/>
                    </Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="发起翻译" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="InterfaceTranslateHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="发起翻译快捷键"/>
                    </Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="朗读译文" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="InterfaceSpeakHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="朗读译文快捷键"/>
                    </Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="打开工作台" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="InterfaceWorkbenchHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="打开工作台快捷键"/>
                    </Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="打开资料库" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="InterfaceLibraryHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="打开资料库快捷键"/>
                    </Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="打开设置" Style="{StaticResource ShortcutLabel}"/>
                        <local:HotkeyRecorder x:Name="InterfaceSettingsHotkeyRecorder" Grid.Column="1" Style="{StaticResource ShortcutRecorder}" AutomationProperties.Name="打开设置快捷键"/>
                    </Grid></Border>
                </StackPanel>
            </Grid>
        </Expander>
    </StackPanel>
</UserControl>
