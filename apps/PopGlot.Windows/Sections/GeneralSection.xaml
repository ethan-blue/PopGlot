<UserControl x:Class="PopGlot.Windows.Sections.GeneralSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">

    <!-- Flat settings page: group titles, plain rows, hairline separators. -->
    <StackPanel>
        <TextBlock Text="通用" Style="{StaticResource PageTitle}" />

        <TextBlock Text="外观与启动" Style="{StaticResource SectionTitle}" Margin="0,20,0,14" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="主题" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="跟随 Windows 系统配色，或固定浅色 / 深色" />
            </StackPanel>
            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" VerticalAlignment="Top"
                      AutomationProperties.Name="主题"
                      SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Tag="System">跟随系统</ComboBoxItem>
                <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
            </ComboBox>
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="登录 Windows 后自动在托盘常驻" />
            </StackPanel>
            <ToggleButton x:Name="StartWithWindowsToggle"
                          AutomationProperties.Name="开机自动启动" Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}" />
        </Grid>

        <TextBlock Text="浮窗行为" Style="{StaticResource SectionTitle}" Margin="0,20,0,14" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="点击别处自动关闭浮窗" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="关闭后浮窗会一直停留，直到手动关闭" />
            </StackPanel>
            <ToggleButton x:Name="CloseOnFocusLossToggle"
                          AutomationProperties.Name="点击别处自动关闭浮窗" Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="翻译完成后自动复制译文" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="译文会写入剪贴板，方便直接粘贴" />
            </StackPanel>
            <ToggleButton x:Name="AutoCopyToggle"
                          AutomationProperties.Name="翻译完成后自动复制译文" Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}" />
        </Grid>

        <TextBlock Text="翻译行为" Style="{StaticResource SectionTitle}" Margin="0,20,0,14" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="附带用法说明与语境解析" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="让模型在译文后方补充语气、歧义或专业术语提示" />
            </StackPanel>
            <ToggleButton x:Name="IncludeExplanationToggle" Grid.Column="1"
                          AutomationProperties.Name="附带用法说明与语境解析"
                          Style="{StaticResource ToggleSwitch}" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" />

        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="保护代码标识符与变量名" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="翻译前自动遮蔽变量、路径、命令与异常类名，翻译后逐字节还原" />
            </StackPanel>
            <ToggleButton x:Name="ProtectTokensToggle" Grid.Column="1"
                          AutomationProperties.Name="保护代码标识符与变量名"
                          Style="{StaticResource ToggleSwitch}" />
        </Grid>
    </StackPanel>
</UserControl>
