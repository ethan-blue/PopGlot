<UserControl x:Class="PopGlot.Windows.Sections.GeneralSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">
    <UserControl.Resources>
        <Style x:Key="ThemeSwatch" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Padding="6,6,6,5" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                Background="{DynamicResource SurfaceBrush}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Card-grouped desktop settings -->
    <StackPanel>
        <TextBlock Text="通用" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />

        <!-- ==================== 外观与启动 ==================== -->
        <TextBlock Text="外观与启动" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="16,14" Margin="0,0,0,20">
            <StackPanel>
                <Grid x:Name="ThemeRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ThemeCol0" Width="*" />
                        <ColumnDefinition x:Name="ThemeCol1" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ThemeRow1" Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="ThemeTextPanel" VerticalAlignment="Center">
                        <TextBlock Text="主题" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        <TextBlock Text="点选即预览，保存后记住" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <!-- Visible choices. The combo stays as the saved value the
                         settings window already reads; compact layout still moves it. -->
                    <StackPanel x:Name="ThemeChoicePanel" Grid.Column="1" Grid.Row="0"
                                Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="ThemeSystemChoice" GroupName="AppTheme" Tag="System"
                                     Style="{StaticResource ThemeSwatch}"
                                     AutomationProperties.Name="主题跟随系统"
                                     Click="ThemeChoice_Click">
                            <StackPanel Width="52">
                                <Grid Width="36" Height="22" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F4F6F8" CornerRadius="3,0,0,3" />
                                    <Border Grid.Column="1" Background="#181B22" CornerRadius="0,3,3,0" />
                                </Grid>
                                <TextBlock Text="跟随系统" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeLightChoice" GroupName="AppTheme" Tag="Light"
                                     Style="{StaticResource ThemeSwatch}"
                                     AutomationProperties.Name="浅色主题"
                                     Click="ThemeChoice_Click">
                            <StackPanel Width="44">
                                <Border Width="36" Height="22" CornerRadius="3" Background="#F4F6F8" HorizontalAlignment="Center">
                                    <Border Width="16" Height="3" Background="#5563B8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,5,0,0" />
                                </Border>
                                <TextBlock Text="浅色" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeDarkChoice" GroupName="AppTheme" Tag="Dark"
                                     Style="{StaticResource ThemeSwatch}" Margin="0"
                                     AutomationProperties.Name="深色主题"
                                     Click="ThemeChoice_Click">
                            <StackPanel Width="44">
                                <Border Width="36" Height="22" CornerRadius="3" Background="#181B22" HorizontalAlignment="Center">
                                    <Border Width="16" Height="3" Background="#7C89D9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,5,0,0" />
                                </Border>
                                <TextBlock Text="深色" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="#C5CAD3" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center"
                              Visibility="Collapsed"
                              AutomationProperties.Name="主题"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="System">跟随系统</ComboBoxItem>
                        <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                        <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,12" SnapsToDevicePixels="True" Opacity="0.7" />

                <Grid x:Name="StartupRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StartupCol0" Width="*" />
                        <ColumnDefinition x:Name="StartupCol1" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="StartupRow1" Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="StartupTextPanel" VerticalAlignment="Center">
                        <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="StartupStateHint"
                                   Style="{StaticResource RowHint}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="StartupControlsPanel" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="StartupRepairButton"
                                Content="重新启用"
                                Style="{StaticResource GhostButton}"
                                Height="26" Padding="10,2"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="重新启用开机自动启动"
                                Visibility="Collapsed"
                                Margin="0,0,10,0" />
                        <ToggleButton x:Name="StartWithWindowsToggle"
                                      AutomationProperties.Name="开机自动启动"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,12" SnapsToDevicePixels="True" Opacity="0.7" />

                <Grid x:Name="CloseToTrayRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="关闭主窗口时最小化到托盘" Style="{StaticResource RowTitle}" />
                    </StackPanel>
                    <ToggleButton x:Name="CloseToTrayToggle"
                                  AutomationProperties.Name="关闭主窗口时最小化到托盘" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}" />
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,12" SnapsToDevicePixels="True" Opacity="0.7" />

                <Grid x:Name="OnboardingRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="新手引导" Style="{StaticResource RowTitle}" />
                    </StackPanel>
                    <Button x:Name="RestartOnboardingButton" Grid.Column="1"
                            Content="重新显示引导"
                            Style="{StaticResource GhostButton}"
                            Height="26" Padding="10,3"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="重新显示新手引导"
                            Click="RestartOnboarding_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 浮窗行为 ==================== -->
        <TextBlock Text="浮窗行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="16,14" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="点击浮窗外部时自动隐藏" Style="{StaticResource RowTitle}" />
                    </StackPanel>
                    <ToggleButton x:Name="CloseOnFocusLossToggle"
                                  AutomationProperties.Name="点击浮窗外部时自动隐藏" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}" />
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,12" SnapsToDevicePixels="True" Opacity="0.7" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="译后自动复制" Style="{StaticResource RowTitle}" />
                    </StackPanel>
                    <ToggleButton x:Name="AutoCopyToggle"
                                  AutomationProperties.Name="译后自动复制" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 翻译规则 ==================== -->
        <TextBlock Text="翻译规则" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="16,14" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="显示详细解析" Style="{StaticResource RowTitle}" />
                    </StackPanel>
                    <ToggleButton x:Name="IncludeExplanationToggle" Grid.Column="1"
                                  AutomationProperties.Name="显示详细解析"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}" />
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,12" SnapsToDevicePixels="True" Opacity="0.7" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="保留代码与变量名原文" Style="{StaticResource RowTitle}" />
                    </StackPanel>
                    <ToggleButton x:Name="ProtectTokensToggle" Grid.Column="1"
                            AutomationProperties.Name="保留代码与变量名原文"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToggleSwitch}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
