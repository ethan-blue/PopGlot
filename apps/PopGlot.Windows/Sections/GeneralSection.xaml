<UserControl x:Class="PopGlot.Windows.Sections.GeneralSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows"
             SizeChanged="GeneralSection_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="ThemeSwatch" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ==================== 外观与启动 ==================== -->
        <TextBlock Text="外观与启动" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <Border Padding="0" Margin="0,0,0,16">
            <StackPanel>
                <Grid x:Name="ThemeRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ThemeCol0" Width="*" />
                        <ColumnDefinition x:Name="ThemeCol1" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ThemeRow1" Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="ThemeTextPanel" VerticalAlignment="Center">
                        <TextBlock Text="主题" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        <TextBlock Text="点选即预览，保存后记住" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <!-- Visible choices. The combo stays as the saved value the
                         settings window already reads; compact layout still moves it. -->
                    <StackPanel x:Name="ThemeChoicePanel" Grid.Column="1" Grid.Row="0"
                                Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="ThemeSystemChoice" GroupName="AppTheme" Tag="System"
                                     Style="{StaticResource ThemeSwatch}"
                                     AutomationProperties.Name="系统主题"
                                     Click="ThemeChoice_Click">
                            <TextBlock Text="系统" />
                        </RadioButton>
                        <RadioButton x:Name="ThemeLightChoice" GroupName="AppTheme" Tag="Light"
                                     Style="{StaticResource ThemeSwatch}"
                                     AutomationProperties.Name="浅色主题"
                                     Click="ThemeChoice_Click">
                            <TextBlock Text="浅色" />
                        </RadioButton>
                        <RadioButton x:Name="ThemeDarkChoice" GroupName="AppTheme" Tag="Dark"
                                     Style="{StaticResource ThemeSwatch}" Margin="0"
                                     AutomationProperties.Name="深色主题"
                                     Click="ThemeChoice_Click">
                            <TextBlock Text="深色" />
                        </RadioButton>
                    </StackPanel>
                    <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center"
                              Visibility="Collapsed"
                              AutomationProperties.Name="主题"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="System">跟随系统</ComboBoxItem>
                        <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                        <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid x:Name="StartupRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StartupCol0" Width="*" />
                        <ColumnDefinition x:Name="StartupCol1" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="StartupRow1" Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="StartupTextPanel" VerticalAlignment="Center">
                        <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="StartupStateHint"
                                   Style="{StaticResource RowHint}"
                                   Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="StartupControlsPanel" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="StartupRepairButton"
                                Content="修复"
                                Style="{StaticResource GhostButton}"
                                Height="26" Padding="10,2"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="修复开机启动"
                                Visibility="Collapsed"
                                Margin="0,0,10,0" />
                        <ToggleButton x:Name="StartWithWindowsToggle"
                                      AutomationProperties.Name="开机自动启动"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid x:Name="CloseToTrayRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="关闭到托盘" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="关闭窗口后仍可使用快捷键" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ToggleButton x:Name="CloseToTrayToggle"
                                  AutomationProperties.Name="关闭主窗口时最小化到托盘" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}" />
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid x:Name="OnboardingRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="新手引导" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="重新查看快速上手" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <Button x:Name="RestartOnboardingButton" Grid.Column="1"
                            Content="重新显示引导"
                            Style="{StaticResource GhostButton}"
                            Height="26" Padding="10,3"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="重新显示新手引导"
                            Click="RestartOnboarding_Click" />
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <!-- C25 离线帮助入口：本机文档，不联网。 -->
                <Grid x:Name="HelpRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="使用帮助" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Text="快速上手与常见问题" />
                    </StackPanel>
                    <Button x:Name="OpenHelpButton" Grid.Column="1"
                            Content="打开帮助"
                            Style="{StaticResource GhostButton}"
                            Height="26" Padding="10,3"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="打开离线使用帮助"
                            Click="OpenHelp_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 浮窗行为 ==================== -->
        <TextBlock Text="浮窗行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <Border Padding="0" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="自动收起浮窗" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="点击其他位置时收起浮窗" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ToggleButton x:Name="CloseOnFocusLossToggle"
                                  AutomationProperties.Name="点击浮窗外部时自动隐藏" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}" />
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="浮窗自动复制" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="划词/截图浮窗翻译完成后复制到剪贴板" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ToggleButton x:Name="AutoCopyToggle"
                                  AutomationProperties.Name="译后自动复制" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 查词窗口 ==================== -->
        <TextBlock Text="查词窗口" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <Border Padding="0" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="边输边译" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="输入或修改查询词停顿后自动翻译，不写入历史记录" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ToggleButton x:Name="LiveTranslateToggle"
                                  AutomationProperties.Name="边输边译" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  Checked="LiveTranslateSettings_Changed"
                                  Unchecked="LiveTranslateSettings_Changed" />
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid x:Name="LiveTranslateDelayRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="停顿延迟" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="停止输入后等待多久开始自动翻译" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ComboBox x:Name="LiveTranslateDelayCombo" Grid.Column="1" Grid.Row="0" Width="188"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              AutomationProperties.Name="停顿延迟"
                              SelectionChanged="LiveTranslateSettings_Changed">
                        <ComboBoxItem Tag="300">300 ms</ComboBoxItem>
                        <ComboBoxItem Tag="500">500 ms (推荐)</ComboBoxItem>
                        <ComboBoxItem Tag="800">800 ms</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid x:Name="LiveTranslateScopeRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="自动翻译范围" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="默认仅对公共翻译线路启用边输边译，避免消耗模型额度" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ComboBox x:Name="LiveTranslateScopeCombo" Grid.Column="1" Grid.Row="0" Width="188"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              AutomationProperties.Name="自动翻译范围"
                              SelectionChanged="LiveTranslateSettings_Changed">
                        <ComboBoxItem Tag="FreeEngineOnly">仅内置免费线路 (默认)</ComboBoxItem>
                        <ComboBoxItem Tag="AllEngines">所有已选引擎</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid x:Name="QuickSearchModeRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="查词窗口形态" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="打开极速查词时的默认窗口大小与布局" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ComboBox x:Name="QuickSearchModeCombo" Grid.Column="1" Grid.Row="0" Width="188"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              AutomationProperties.Name="查词窗口形态"
                              SelectionChanged="LiveTranslateSettings_Changed">
                        <ComboBoxItem Tag="Compact">紧凑小窗</ComboBoxItem>
                        <ComboBoxItem Tag="Expanded">完整大窗</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 翻译规则 ==================== -->
        <TextBlock Text="翻译规则" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <Border Padding="0" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="补充说明" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="在译文下方说明用词与含义" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ToggleButton x:Name="IncludeExplanationToggle" Grid.Column="1"
                                  AutomationProperties.Name="显示详细解析"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}" />
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="保留代码与变量" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="翻译技术内容时尽量原样保留代码、变量名和路径" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ToggleButton x:Name="ProtectTokensToggle" Grid.Column="1"
                            AutomationProperties.Name="保留代码与变量名原文"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToggleSwitch}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 网络与代理 ==================== -->
        <TextBlock Text="网络与代理" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <Border Padding="0" Margin="0,0,0,16">
            <StackPanel>
                <Grid x:Name="ProxyModeRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="代理模式" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="选择 PopGlot 联网请求如何走网络代理" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <WrapPanel x:Name="ProxyModeChoicePanel" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                        <RadioButton x:Name="ProxySystemRadio" GroupName="NetworkProxyMode" Tag="System"
                                     Style="{StaticResource ThemeSwatch}" Margin="0,2,14,2"
                                     AutomationProperties.Name="跟随系统代理"
                                     Click="ProxyModeRadio_Click">
                            <TextBlock Text="跟随系统代理" />
                        </RadioButton>
                        <RadioButton x:Name="ProxyDirectRadio" GroupName="NetworkProxyMode" Tag="Direct"
                                     Style="{StaticResource ThemeSwatch}" Margin="0,2,14,2"
                                     AutomationProperties.Name="直连"
                                     Click="ProxyModeRadio_Click">
                            <TextBlock Text="直连" />
                        </RadioButton>
                        <RadioButton x:Name="ProxyCustomRadio" GroupName="NetworkProxyMode" Tag="Custom"
                                     Style="{StaticResource ThemeSwatch}" Margin="0,2,0,2"
                                     AutomationProperties.Name="自定义代理"
                                     Click="ProxyModeRadio_Click">
                            <TextBlock Text="自定义代理" />
                        </RadioButton>
                    </WrapPanel>
                </Grid>

                <StackPanel x:Name="CustomProxyRow" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="代理地址" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomProxyTextBox" Style="{StaticResource FormTextBox}" Height="34"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 local:Ui.Placeholder="http://127.0.0.1:7890 或 socks5://127.0.0.1:7891"
                                 AutomationProperties.Name="代理地址"
                                 TextChanged="CustomProxyTextBox_TextChanged"
                                 LostFocus="CustomProxyTextBox_LostFocus"
                                 KeyDown="CustomProxyTextBox_KeyDown" />
                        <Button x:Name="ApplyCustomProxyButton" Grid.Column="1" Content="应用"
                                Style="{StaticResource GhostButton}" Height="34" Padding="12,0" Margin="8,0,0,0"
                                AutomationProperties.Name="应用自定义代理"
                                Click="ApplyCustomProxy_Click" />
                    </Grid>
                    <TextBlock x:Name="ProxyValidationText" Style="{StaticResource Caption}"
                               Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="本地地址始终直连" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Ollama、LM Studio 等本机与局域网地址不走代理" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ToggleButton x:Name="ProxyBypassLocalToggle" Grid.Column="1"
                                  AutomationProperties.Name="本地地址始终直连"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  Checked="ProxyBypass_Changed" Unchecked="ProxyBypass_Changed" />
                </Grid>

                <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="国内线路直连加速" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="有道、Bing 国内版、DeepSeek、智谱、硅基流动等国内服务不绕代理，直连更快"
                                   Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleButton x:Name="ProxyBypassDomesticToggle" Grid.Column="1"
                                  AutomationProperties.Name="国内线路直连加速"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  Checked="ProxyBypass_Changed" Unchecked="ProxyBypass_Changed" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 版本 ==================== -->
        <!-- 0.1.25：唯一版本展示面。三段式程序集版本；悬停显示完整
             InformationalVersion（含 +commit 哈希，若构建带上了它）。 -->
        <Grid Style="{StaticResource SettingsRow}" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="版本" Style="{StaticResource RowTitle}" />
                <TextBlock Text="PopGlot 本机桌面客户端" Style="{StaticResource RowHint}" />
            </StackPanel>
            <TextBlock x:Name="AppVersionText" Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource RowTitle}"
                       AutomationProperties.Name="当前版本" />
        </Grid>

        <!-- ==================== 更新 ==================== -->
        <!-- 0.1.35：只提示、不静默。检查动作读 GitHub Releases，发现新版本
             只给版本号与下载页，下载与安装完全由用户决定。 -->
        <Border Style="{StaticResource SettingsDivider}" Margin="0,6,0,10" />

        <Grid x:Name="UpdateRowGrid" Style="{StaticResource SettingsRow}" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="启动时检查更新" Style="{StaticResource RowTitle}" />
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="启动时检查一次新版，有更新会提醒你，不会自动下载。" />
            </StackPanel>
            <StackPanel x:Name="UpdateControlsPanel" Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="AutoUpdateCheckToggle" VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="启动时检查更新"
                              Checked="AutoUpdateCheck_Changed" Unchecked="AutoUpdateCheck_Changed" />
                <Button x:Name="CheckUpdateButton" Content="立即检查" Margin="10,0,0,0"
                        Style="{StaticResource GhostButton}" Padding="10,5"
                        AutomationProperties.Name="立即检查更新"
                        Click="CheckUpdate_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
