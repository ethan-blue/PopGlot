<UserControl x:Class="PopGlot.Windows.Sections.ServicesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">
    <UserControl.Resources>
        <Style x:Key="ProviderPresetButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PresetBadgeBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PresetBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style x:Key="CapabilityPillBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="ServiceListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 内容由行卡片自绘；这里只补键盘焦点与选中态，
                             否则方向键导航完全不可见。 -->
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBorderBrush}" />
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CliToolItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorSectionCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="EditorTextField" TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="EditorComboField" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="EditorPasswordField" TargetType="PasswordBox" BasedOn="{StaticResource FormPasswordBox}">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="EditorSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DataTemplate x:Key="ConnectionChoiceTemplate">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
        </DataTemplate>
        <Style x:Key="ModelChipButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="ChooseAnotherProviderButton" Content="← 选择来源" Visibility="Collapsed"
                            Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,8,0"
                            Click="ChooseAnotherProvider_Click" />
                    <Button x:Name="BackToListHeaderButton" Content="← 返回引擎列表" Visibility="Collapsed"
                            Style="{StaticResource GhostButton}" Padding="10,5" Click="BackToServices_Click" />
                    <Button x:Name="AddEngineHeaderButton" Content="添加引擎"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" Click="AddProfile_Click" />
                </WrapPanel>
                <Button x:Name="ProxyStatusButton" Grid.Column="1" VerticalAlignment="Center"
                        Style="{StaticResource GhostButton}" Padding="10,5"
                        AutomationProperties.Name="网络与代理状态"
                        ToolTip="查看或快速切换网络代理模式"
                        Click="ProxyStatusButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ProxyStatusDot" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" />
                        <TextBlock x:Name="ProxyStatusLabel" Text="代理：跟随系统" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="QuickProxyPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,10"
                    CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="快捷代理设置" Style="{StaticResource EditorSectionTitle}" VerticalAlignment="Center" />
                        <Button x:Name="OpenGeneralProxySettingsButton" Grid.Column="1" Content="完整网络设置 →"
                                Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11.5"
                                AutomationProperties.Name="打开通用网络设置"
                                Click="OpenGeneralProxySettings_Click" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,6">
                        <RadioButton x:Name="QuickProxySystemRadio" GroupName="QuickProxyMode" Tag="System"
                                     Content="跟随系统代理" Margin="0,0,12,4" Click="QuickProxyMode_Click" />
                        <RadioButton x:Name="QuickProxyDirectRadio" GroupName="QuickProxyMode" Tag="Direct"
                                     Content="直连" Margin="0,0,12,4" Click="QuickProxyMode_Click" />
                        <RadioButton x:Name="QuickProxyCustomRadio" GroupName="QuickProxyMode" Tag="Custom"
                                     Content="自定义代理" Margin="0,0,0,4" Click="QuickProxyMode_Click" />
                    </WrapPanel>
                    <Grid x:Name="QuickProxyCustomRow" Visibility="Collapsed" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickProxyUrlTextBox" Style="{StaticResource FormTextBox}" Height="32"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 local:Ui.Placeholder="http://127.0.0.1:7890 或 socks5://127.0.0.1:7891"
                                 AutomationProperties.Name="快捷代理地址" />
                        <Button x:Name="QuickProxyApplyButton" Grid.Column="1" Content="应用"
                                Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Margin="8,0,0,0"
                                Click="QuickProxyApply_Click" />
                    </Grid>
                    <TextBlock x:Name="QuickProxyValidationText" Style="{StaticResource Caption}"
                               Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="DraftGuardBar" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,10" CornerRadius="{DynamicResource CardRadius}"
                    Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock x:Name="DraftGuardText" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" FontSize="12"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="DraftSaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Click="DraftSave_Click"/>
                        <Button x:Name="DraftDiscardButton" Content="放弃" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DraftDiscard_Click"/>
                        <Button x:Name="DraftCancelButton" Content="留在此页" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DraftCancel_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>


        <!-- 引擎与免费路线中心：免费线路、本机/环境变量一键发现、已配置引擎 -->
        <Grid x:Name="DetailGrid" Grid.Row="1" SizeChanged="DetailGrid_SizeChanged">
            <!-- Service overview. Editing is explicit and replaces this list. -->
            <Border x:Name="EditorEmpty" Padding="0" Background="Transparent" BorderThickness="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,8">
                    <StackPanel>
                        <!-- 1. Built-in Free Routes Panel -->
                        <Border x:Name="FreeRoutesPanel" Style="{StaticResource EditorSectionCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="内置免费线路" Style="{StaticResource EditorSectionTitle}" VerticalAlignment="Center" />
                                            <Border x:Name="FreeRoutesConsentBadge" Background="{DynamicResource SurfaceMutedBrush}"
                                                    CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="FreeRoutesConsentText" Text="已启用" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <Button x:Name="EnableFreeRoutesInlineButton" Content="开启免费线路"
                                                    Visibility="Collapsed" Style="{StaticResource GhostButton}"
                                                    Padding="8,2" Margin="8,0,0,0" FontSize="11.5"
                                                    Click="EnableFreeRoutesInline_Click" />
                                        </WrapPanel>
                                        <TextBlock Text="免 API Key 直接可用；点击右侧按钮可切换当前线路或手动测速"
                                                   Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="TestAllFreeRoutesButton" Grid.Column="1" Content="一键测速"
                                            Style="{StaticResource GhostButton}" Padding="10,5" VerticalAlignment="Center"
                                            AutomationProperties.Name="一键测速"
                                            ToolTip="向内置免费线路发送测试词以测量延迟"
                                            Click="TestAllFreeRoutes_Click" />
                                </Grid>

                                <ItemsControl x:Name="FreeRoutesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="8"
                                                    Background="{DynamicResource InputBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource CapabilityPillBorder}">
                                                                            <TextBlock Text="{Binding}" FontSize="10.5"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                                   Margin="13,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding LatencyText}" FontSize="11.5"
                                                               Foreground="{Binding LatencyBrush}" VerticalAlignment="Center"
                                                               Margin="0,0,10,0" MinWidth="46" TextAlignment="Right" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="测速" Style="{StaticResource GhostButton}"
                                                                Padding="8,3" FontSize="11.5" Margin="0,0,6,0"
                                                                Tag="{Binding Provider}"
                                                                AutomationProperties.Name="{Binding ProbeButtonName}"
                                                                Click="ProbeFreeRoute_Click" />
                                                        <Border Visibility="{Binding ActiveBadgeVisibility}"
                                                                Background="{DynamicResource SuccessSoftBrush}"
                                                                CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="当前线路" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SuccessBrush}" />
                                                        </Border>
                                                        <Button Content="设为当前" Style="{StaticResource GhostButton}"
                                                                Visibility="{Binding SelectVisibility}"
                                                                Padding="8,3" FontSize="11.5"
                                                                Tag="{Binding Provider}"
                                                                AutomationProperties.Name="{Binding SelectButtonName}"
                                                                Click="SelectFreeRoute_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="GoogleProxyHintBanner" Visibility="Collapsed" Margin="0,2,0,0" Padding="10,7"
                                        CornerRadius="6" Background="{DynamicResource WarningSoftBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="无法直连？可切换 Bing / 有道，或检查代理设置" FontSize="12"
                                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,8,2" />
                                        <Button Content="切到 Bing" Style="{StaticResource GhostButton}" Padding="8,2"
                                                FontSize="11.5" Margin="0,0,6,2" Click="QuickSwitchBing_Click" />
                                        <Button Content="切到有道" Style="{StaticResource GhostButton}" Padding="8,2"
                                                FontSize="11.5" Margin="0,0,6,2" Click="QuickSwitchYoudao_Click" />
                                        <Button Content="检查代理" Style="{StaticResource GhostButton}" Padding="8,2"
                                                FontSize="11.5" Margin="0,0,0,2" Click="OpenQuickProxyFromBanner_Click" />
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 2. One-Click Auto-Discovery & Free Model Addition -->
                        <Border x:Name="DiscoveryPanel" Style="{StaticResource EditorSectionCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="自动发现与免费模型" Style="{StaticResource EditorSectionTitle}" />
                                        <TextBlock Text="检测本机 Ollama / LM Studio 服务与环境变量密钥，确认后一键添加"
                                                   Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="ScanLocalAndEnvButton" Grid.Column="1" Content="扫描本机与环境"
                                            Style="{StaticResource GhostButton}" Padding="10,5" VerticalAlignment="Center"
                                            AutomationProperties.Name="扫描本机与环境"
                                            Click="ScanLocalAndEnv_Click" />
                                </Grid>
                                <TextBlock x:Name="DiscoveryStatusText" Style="{StaticResource Caption}"
                                           Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <ItemsControl x:Name="DiscoveredSourcesList" Visibility="Collapsed" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="8"
                                                    Background="{DynamicResource InputBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" />
                                                            <Border Style="{StaticResource PresetBadgeBorder}">
                                                                <TextBlock Text="{Binding KindBadge}" Style="{StaticResource PresetBadgeText}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}"
                                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="一键添加" Style="{StaticResource PrimaryButton}"
                                                            Padding="10,4" FontSize="11.5" VerticalAlignment="Center"
                                                            Tag="{Binding}"
                                                            AutomationProperties.Name="{Binding AddButtonName}"
                                                            Click="QuickAddDiscoveredSource_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 3. Configured Engines -->
                        <StackPanel Margin="2,0,0,8">
                            <TextBlock Text="已配置引擎" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <Grid>
                            <StackPanel x:Name="ProfilesEmptyText" Visibility="Collapsed" Panel.ZIndex="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,8">
                                <TextBlock Text="尚未添加引擎。可点击上方「添加引擎」或使用「扫描本机与环境」快速添加。" FontSize="13"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ListBox x:Name="ProfilesListBox" ItemContainerStyle="{StaticResource ServiceListItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,9" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource InputBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                                    <Path Data="{StaticResource IconProvider}" Width="16" Height="16" Stretch="Uniform"
                                                          Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}" />
                                                        <Border Visibility="{Binding IsDefaultBadge}"
                                                                Background="{DynamicResource SuccessSoftBrush}" CornerRadius="4"
                                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="当前引擎" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SuccessBrush}" />
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding CapabilityBadges}" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource CapabilityPillBorder}">
                                                                        <TextBlock Text="{Binding}" FontSize="10.5"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                                                                Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" />
                                                    <TextBlock Text="{Binding StateText}" Margin="7,0,0,0"
                                                               Foreground="{Binding StateTextBrush}" FontSize="12" />
                                                    <Border Visibility="{Binding LatencyVisibility}" Margin="6,0,0,0"
                                                            Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="4" Padding="5,1">
                                                        <TextBlock Text="{Binding LatencyText}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
