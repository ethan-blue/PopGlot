<UserControl x:Class="PopGlot.Windows.Sections.ServicesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PopGlot.Windows">
    <UserControl.Resources>
        <Style x:Key="ProviderPresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="ServiceListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 内容由行卡片自绘；这里只补键盘焦点与选中态，
                             否则方向键导航完全不可见。 -->
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBorderBrush}" />
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorSectionCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="EditorTextField" TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="EditorComboField" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="EditorPasswordField" TargetType="PasswordBox" BasedOn="{StaticResource FormPasswordBox}">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="EditorSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ModelChipButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EvidenceBadge" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock x:Name="ProviderPageTitle" Text="翻译引擎" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="ChooseAnotherProviderButton" Content="更换服务商" Visibility="Collapsed"
                        Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,8,0"
                        Click="ChooseAnotherProvider_Click" />
                <Button x:Name="BackToListHeaderButton" Content="← 返回引擎列表" Visibility="Collapsed"
                        Style="{StaticResource GhostButton}" Padding="10,5" Click="BackToServices_Click" />
                <Button x:Name="AddEngineHeaderButton" Content="添加引擎"
                        Style="{StaticResource PrimaryButton}" Padding="16,8" Click="AddProfile_Click" />
            </StackPanel>
        </Grid>

        <!-- 路由唯一入口是主窗口底部的快速切换器；设置页不再提供默认路由控件。 -->
        <Grid x:Name="DetailGrid" Grid.Row="1" SizeChanged="DetailGrid_SizeChanged">
            <!-- Service overview. Editing is explicit and replaces this list. -->
            <Border x:Name="EditorEmpty" Padding="0" Background="Transparent" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,0,0,12">
                        <TextBlock Text="已配置引擎" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="ProfilesEmptyText" Visibility="Collapsed" Panel.ZIndex="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0">
                            <TextBlock Text="尚未添加翻译引擎，点击右上角「添加引擎」开始。" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <!-- 页眉「添加引擎」是唯一主按钮。这个按钮留在树上供旧调用点找到，不占空态。 -->
                            <Button x:Name="AddFirstEngineButton" Content="添加第一个引擎"
                                    Visibility="Collapsed" IsHitTestVisible="False"
                                    Style="{StaticResource PrimaryButton}" Padding="16,7"
                                    AutomationProperties.Name="添加第一个引擎"
                                    Click="AddProfile_Click" />
                        </StackPanel>
                        <ListBox x:Name="ProfilesListBox" ItemContainerStyle="{StaticResource ServiceListItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource InputBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                                <Path Data="{StaticResource IconProvider}" Width="16" Height="16" Stretch="Uniform"
                                                      Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <Border Grid.Column="1" Visibility="{Binding IsDefaultBadge}" Style="{StaticResource StatusPill}"
                                                            Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="文字默认" FontSize="11" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                                                            Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" />
                                                <TextBlock Text="{Binding StateText}" Margin="7,0,0,0"
                                                           Foreground="{Binding StateTextBrush}" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="编辑" Padding="12,6" Tag="{Binding Id}"
                                                    Style="{StaticResource GhostButton}" AutomationProperties.Name="编辑引擎"
                                                    Click="EditProfile_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Full-width focused editor. -->
            <Border x:Name="EditorForm" Visibility="Collapsed" Padding="0" Background="Transparent" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 底部留白：滚动到底时最后一个字段仍完整悬于固定操作栏
                         上方，不再贴着保存/取消按钮的下边缘。 -->
                    <ScrollViewer x:Name="EditorScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
                        <StackPanel>
                            <StackPanel x:Name="PresetsPanel" Visibility="Collapsed">
                                <TextBlock Text="选择服务商" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

                                <!-- Prominent Custom / Relay preset card -->
                                <Button x:Name="CustomPresetButton" Style="{StaticResource ProviderPresetButton}" Tag="custom" Click="Preset_Click"
                                        Margin="0,0,0,12" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1.5"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <Grid x:Name="CustomPresetGrid">
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <WrapPanel x:Name="CustomPresetTitleRow" Orientation="Horizontal">
                                                <TextBlock Text="自定义兼容引擎" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Border Style="{StaticResource StatusPill}"
                                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                                        Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="自建或第三方引擎" FontSize="11"
                                                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="CustomPresetArrow" Grid.Column="1" Text="接入 →" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="8,0,4,0" />
                                    </Grid>
                                </Button>

                                <TextBlock Text="标准服务商预设" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10" />

                                <Grid x:Name="PresetColumns">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="PresetLeftColumn" Width="*"/>
                                        <ColumnDefinition x:Name="PresetGutter" Width="16"/>
                                        <ColumnDefinition x:Name="PresetRightColumn" Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="PresetColumnLeft">
                                        <Button Style="{StaticResource ProviderPresetButton}" Tag="openai" AutomationProperties.Name="OpenAI 预设" Click="Preset_Click"><StackPanel><TextBlock Text="OpenAI" FontWeight="SemiBold"/><TextBlock Text="GPT · 文字与图片" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Button>
                                        <Button Style="{StaticResource ProviderPresetButton}" Tag="gemini" AutomationProperties.Name="Google Gemini 预设" Click="Preset_Click"><StackPanel><TextBlock Text="Google Gemini" FontWeight="SemiBold"/><TextBlock Text="Gemini · 文字与图片" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Button>
                                        <Button Style="{StaticResource ProviderPresetButton}" Tag="zhipu" AutomationProperties.Name="智谱 GLM 预设" Click="Preset_Click"><StackPanel><TextBlock Text="智谱 GLM" FontWeight="SemiBold"/><TextBlock Text="国内服务 · 文字与图片" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Button>
                                    </StackPanel>
                                    <StackPanel x:Name="PresetColumnRight" Grid.Column="2">
                                        <Button Style="{StaticResource ProviderPresetButton}" Tag="deepseek" AutomationProperties.Name="DeepSeek 预设" Click="Preset_Click"><StackPanel><TextBlock Text="DeepSeek" FontWeight="SemiBold"/><TextBlock Text="文字翻译 · 官方接口" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Button>
                                        <Button Style="{StaticResource ProviderPresetButton}" Tag="claude" AutomationProperties.Name="Anthropic Claude 预设" Click="Preset_Click"><StackPanel><TextBlock Text="Anthropic Claude" FontWeight="SemiBold"/><TextBlock Text="Messages · 文字与图片" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Button>
                                        <Button Style="{StaticResource ProviderPresetButton}" Tag="ollama" AutomationProperties.Name="Ollama（本地）预设" Click="Preset_Click"><StackPanel><TextBlock Text="Ollama（本地）" FontWeight="SemiBold"/><TextBlock Text="本机运行 · 无需 Key" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Button>
                                        <Button Style="{StaticResource ProviderPresetButton}" Tag="litellm" AutomationProperties.Name="LiteLLM Proxy 预设" Click="Preset_Click"><StackPanel><TextBlock Text="LiteLLM Proxy" FontWeight="SemiBold"/><TextBlock Text="统一代理 · OpenAI 兼容" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- 宽度上限 900：设置窗 960 下表单不再明显窄于
                                 可用区，两侧大空白消失；超宽屏仍居中限宽。 -->
                            <StackPanel x:Name="ConfigFormPanel" MaxWidth="900" HorizontalAlignment="Stretch">
                                <Grid x:Name="EditorHeaderGrid" Margin="2,0,2,18">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                            <TextBlock x:Name="EditorProviderBadge" Text="S" FontSize="14.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="EditorProviderTitle" Text="连接引擎" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock x:Name="EditorProviderMeta" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="ConnectionCard" Style="{StaticResource EditorSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="连接信息" Style="{StaticResource EditorSectionTitle}" Margin="0,0,0,14" />
                                        <Grid x:Name="IdentityFieldsGrid" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel x:Name="ServiceNamePanel">
                                                <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="ServiceNameTextBox" Style="{StaticResource EditorTextField}" local:Ui.Placeholder="例如：公司内部代理"/>
                                            </StackPanel>
                                            <StackPanel x:Name="CustomProtocolGroup" Grid.Column="2" Visibility="Collapsed">
                                                <TextBlock Text="接口协议" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="ProviderTypeComboBox" Style="{StaticResource EditorComboField}" SelectionChanged="ProviderTypeComboBox_SelectionChanged">
                                                    <ComboBoxItem Tag="OpenAiCompatible">OpenAI 兼容</ComboBoxItem><ComboBoxItem Tag="OpenAiResponses">OpenAI Responses</ComboBoxItem>
                                                    <ComboBoxItem Tag="AnthropicMessages">Anthropic Messages</ComboBoxItem><ComboBoxItem Tag="GeminiGenerateContent">Gemini generateContent</ComboBoxItem>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="BaseUrlPanel" Visibility="Collapsed" Margin="0,0,0,14">
                                            <TextBlock Text="请求地址" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="BaseUrlTextBox" Style="{StaticResource EditorTextField}" FontFamily="{StaticResource MonoFontFamily}"
                                                     local:Ui.Placeholder="例如：http://localhost:4000 或 https://your-proxy.com/v1"/>
                                        </StackPanel>
                                        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                                        <Grid x:Name="ApiKeyInputGrid">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <PasswordBox x:Name="ApiKeyPasswordBox" Style="{StaticResource EditorPasswordField}" local:Ui.Placeholder="留空保持现有密钥" />
                                            <StackPanel x:Name="KeyActionsPanel" Grid.Column="2" Orientation="Horizontal">
                                                <Button x:Name="ClearKeyButton" Content="清除" Style="{StaticResource GhostButton}" Height="40" Padding="12,6" Click="ClearApiKey_Click" />
                                                <Button x:Name="TestConnectionButton" Content="验证连接" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Height="40" Padding="16,6" Click="TestConnection_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="ApiKeyStateText" Style="{StaticResource Caption}" Margin="2,7,0,0" />
                                        <StackPanel x:Name="TestStatusPanel" Orientation="Horizontal" Margin="2,8,0,0" Visibility="Collapsed">
                                            <Ellipse x:Name="TestStateDot" Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBlock x:Name="TestSummaryText" Margin="7,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TestDetailText" Style="{StaticResource Caption}" Margin="16,3,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <!-- A small dynamic spacer is used only when the first
                                     viewport would otherwise show a severed card header.
                                     It never participates once the card has useful room. -->
                                <Border x:Name="InitialFoldSpacer" Height="0" />

                                <Border x:Name="ModelCard" Style="{StaticResource EditorSectionCard}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="使用模型" Style="{StaticResource EditorSectionTitle}" />
                                            </StackPanel>
                                            <Button x:Name="FetchModelsButton" Content="获取模型" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Style="{StaticResource GhostButton}" Height="34" Padding="12,6" Click="FetchModels_Click" />
                                        </Grid>

                                        <!-- Recommendation Preference -->
                                        <Grid x:Name="PreferenceRowHost" Margin="0,12,0,0">
                                            <WrapPanel x:Name="PreferenceRadiosPanel" VerticalAlignment="Center">
                                                <TextBlock Text="推荐偏好" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,4,12,4" />
                                                <RadioButton x:Name="PreferenceSpeedRadio" Content="速度优先" GroupName="ModelPreferenceGroup"
                                                             AutomationProperties.Name="速度优先偏好" Margin="0,4,12,4"
                                                             Checked="PreferenceRadio_Checked" />
                                                <RadioButton x:Name="PreferenceBalancedRadio" Content="均衡推荐" GroupName="ModelPreferenceGroup"
                                                             AutomationProperties.Name="均衡推荐偏好" Margin="0,4,12,4" IsChecked="True"
                                                             Checked="PreferenceRadio_Checked" />
                                                <RadioButton x:Name="PreferenceQualityRadio" Content="质量优先" GroupName="ModelPreferenceGroup"
                                                             AutomationProperties.Name="质量优先偏好" Margin="0,4,0,4"
                                                             Checked="PreferenceRadio_Checked" />
                                            </WrapPanel>
                                        </Grid>

                                        <Grid x:Name="ModelFieldsGrid">
                                            <Grid.Margin>0,12,0,0</Grid.Margin>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel x:Name="TextModelPanel">
                                                <TextBlock Text="文字模型" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="TextModelCombo" Style="{StaticResource EditorComboField}" IsEditable="True" FontFamily="{StaticResource MonoFontFamily}"/>
                                                <!-- Text model recommendation chips -->
                                                <WrapPanel x:Name="TextRecommendationChipsPanel" Margin="0,8,0,0" />
                                                <!-- Text model recommendation reason & evidence -->
                                                <Grid x:Name="TextRecommendationReasonRow" Margin="0,4,0,0" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="TextEvidenceBadge" Style="{StaticResource EvidenceBadge}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse x:Name="TextEvidenceDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock x:Name="TextEvidenceBadgeText" Style="{StaticResource Caption}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock x:Name="TextRecommendationReasonText" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   AutomationProperties.LiveSetting="Polite" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel x:Name="VisionModelPanel" Grid.Column="2">
                                                <TextBlock Text="图片模型（可选）" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="VisionModelCombo" Style="{StaticResource EditorComboField}" IsEditable="True" FontFamily="{StaticResource MonoFontFamily}"/>
                                                <!-- Vision model recommendation chips -->
                                                <WrapPanel x:Name="VisionRecommendationChipsPanel" Margin="0,8,0,0" />
                                                <!-- Vision model recommendation reason & evidence -->
                                                <Grid x:Name="VisionRecommendationReasonRow" Margin="0,4,0,0" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="VisionEvidenceBadge" Style="{StaticResource EvidenceBadge}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse x:Name="VisionEvidenceDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock x:Name="VisionEvidenceBadgeText" Style="{StaticResource Caption}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock x:Name="VisionRecommendationReasonText" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   AutomationProperties.LiveSetting="Polite" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="UseTextModelForVisionCheckBox"
                                                  Content="图文共用此模型"
                                                  Margin="2,10,0,0"
                                                  Style="{StaticResource SwitchCheckBox}"
                                                  Checked="UseTextModelForVision_Changed"
                                                  Unchecked="UseTextModelForVision_Changed" />
                                        <TextBlock x:Name="SharedModelHintText" Style="{StaticResource Caption}"
                                                   Margin="46,3,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="开启后，图片识别与翻译将直接复用文字模型，无需单独配置图片模型" />
                                        <TextBlock x:Name="ModelCatalogStatusText" Visibility="Collapsed" Style="{StaticResource Caption}"
                                                   Margin="2,9,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="AdvancedGroup" Margin="0,0,0,14">

                                    <Expander x:Name="AdvancedExpander" Header="高级设置" Expanded="AdvancedExpander_Expanded">
                                        <StackPanel Margin="0,14,0,0">
                                            <TextBlock Text="接口与网络" Style="{StaticResource EditorSectionTitle}" Margin="0,0,0,12" />
                                            <Grid x:Name="EndpointFieldsGrid">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <StackPanel x:Name="TextEndpointPanel">
                                                    <TextBlock Text="文字请求路径" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="TextEndpointTextBox" Style="{StaticResource EditorTextField}" FontFamily="{StaticResource MonoFontFamily}"/>
                                                </StackPanel>
                                                <StackPanel x:Name="VisionEndpointPanel" Grid.Column="2">
                                                    <TextBlock Text="图片请求路径" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="VisionEndpointTextBox" Style="{StaticResource EditorTextField}" FontFamily="{StaticResource MonoFontFamily}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border Height="1" Margin="0,16,0,16" Background="{DynamicResource BorderSubtleBrush}" />
                                            <TextBlock Text="请求定制" Style="{StaticResource EditorSectionTitle}" Margin="0,0,0,12" />
                                            <Grid x:Name="AdvancedDetailsGrid">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <StackPanel x:Name="HeadersPanel">
                                                    <TextBlock Text="自定义请求头" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="ExtraHeadersTextBox" Style="{StaticResource FormTextArea}"
                                                             Height="104" FontFamily="{StaticResource MonoFontFamily}"
                                                             local:Ui.Placeholder="例如：X-Organization: team-a"/>
                                                </StackPanel>
                                                <StackPanel x:Name="CapabilitiesPanel" Grid.Column="2">
                                                    <TextBlock Text="Anthropic API 版本" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="AnthropicVersionTextBox" Style="{StaticResource EditorTextField}" FontFamily="{StaticResource MonoFontFamily}"/>
                                                    <!-- Kept hidden for schema/editor compatibility; runtime roles are derived from model fields. -->
                                                    <CheckBox x:Name="SupportsTextCheckBox" Visibility="Collapsed"/>
                                                    <CheckBox x:Name="SupportsVisionCheckBox" Visibility="Collapsed"/>
                                                    <CheckBox x:Name="AllowInsecureTlsCheckBox" Content="允许自签名 HTTPS 证书" Margin="0,10,0,0"
                                                  Style="{StaticResource SwitchCheckBox}"/>
                                                    <TextBlock Text="仅用于受信任的本地或内网服务" Style="{StaticResource Caption}" Margin="24,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="DraftGuardBar" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,10" CornerRadius="{DynamicResource CardRadius}"
                            Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5">
                        <!-- 说明文字独占一行并可换行：旧布局把文字和三个按钮
                             挤在同一行，窄面板上按钮直接压在省略号文字上。 -->
                        <StackPanel>
                            <TextBlock x:Name="DraftGuardText" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="DraftCancelButton" Content="取消" Style="{StaticResource GhostButton}" Click="DraftCancel_Click"/>
                                <Button x:Name="DraftDiscardButton" Content="放弃修改" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DraftDiscard_Click"/>
                                <Button x:Name="DraftSaveButton" Content="保存并继续" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="DraftSave_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="EditorActionBar" Grid.Row="2" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Button x:Name="DeleteServiceButton" Content="删除引擎" HorizontalAlignment="Left" Style="{StaticResource DangerButton}" Padding="12,6" Click="DeleteProfile_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border x:Name="EditorDirtyBadge" Visibility="Collapsed" Style="{StaticResource StatusPill}"
                                        Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                        Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="未保存的修改" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                </Border>
                                <Button x:Name="CancelEditButton" Content="取消" Style="{StaticResource GhostButton}" Padding="12,6" Click="CancelEdit_Click"/>
                                <Button x:Name="SaveServiceButton" Content="保存" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="SaveService_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
