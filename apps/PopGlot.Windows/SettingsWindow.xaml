<Window x:Class="PopGlot.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        xmlns:sections="clr-namespace:PopGlot.Windows.Sections"
        Title="设置" Width="960" Height="700" MinWidth="680" MinHeight="480"
        Icon="/PopGlot;component/Assets/PopGlot-v5.ico"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Left navigation rail ==================== -->
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="10,0,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Window header aligned with window caption height -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="6"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Image Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/PopGlot;component/Assets/popglot-app-avatar-v5.png"
                               AutomationProperties.Name="PopGlot 图标" />
                    </Border>
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="偏好设置" Style="{StaticResource Metadata}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11" FontWeight="SemiBold" Margin="8,0,0,8" />
                    <RadioButton x:Name="NavProvider" Style="{StaticResource NavButton}"
                                 GroupName="SettingsNav" IsChecked="True" Content="翻译引擎"
                                 local:Ui.Icon="{StaticResource IconProvider}"
                                 Checked="SubNav_Checked" Tag="Provider" Margin="0,2" />
                    <RadioButton x:Name="NavPrompt" Style="{StaticResource NavButton}"
                                 GroupName="SettingsNav" Content="翻译与提示词"
                                 local:Ui.Icon="{StaticResource IconTranslate}"
                                 Checked="SubNav_Checked" Tag="Prompt" Margin="0,2" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavButton}"
                                 GroupName="SettingsNav" Content="通用"
                                 local:Ui.Icon="{StaticResource IconSettings}"
                                 Checked="SubNav_Checked" Tag="General" Margin="0,2" />
                    <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavButton}"
                                 GroupName="SettingsNav" Content="快捷键"
                                 local:Ui.Icon="{StaticResource IconKeyboard}"
                                 Checked="SubNav_Checked" Tag="Shortcuts" Margin="0,2" />
                    <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavButton}"
                                 GroupName="SettingsNav" Content="隐私与数据"
                                 local:Ui.Icon="{StaticResource IconCapture}"
                                 Checked="SubNav_Checked" Tag="Privacy" Margin="0,2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Main content ==================== -->
        <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Caption controls (static first-paint labels; this window has
                 no tray-resident close semantics) -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMin}"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMax}"
                            AutomationProperties.Name="最大化"
                            ToolTip="最大化" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}"
                            AutomationProperties.Name="关闭设置"
                            local:Ui.Icon="{StaticResource IconCaptionClose}"
                            ToolTip="关闭设置" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Scrollable settings & provider engine view -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="SettingsScroll"
                              VerticalScrollBarVisibility="Auto" Padding="28,14,32,16">
                    <Grid>
                        <sections:GeneralSection x:Name="GeneralSection" Visibility="Collapsed" />
                        <sections:ShortcutsSection x:Name="ShortcutsSection" Visibility="Collapsed" />
                        <Grid x:Name="PrivacyPageHost" Visibility="Collapsed">
                            <StackPanel>
                                <sections:PrivacySection x:Name="CaptureSection" />
                                <sections:DataSection x:Name="DataSection" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
                <sections:ServicesSection x:Name="ProviderSection"
                                          Margin="28,14,32,16" />
                <sections:PromptSection x:Name="PromptSectionHost"
                                        Margin="28,14,32,16" Visibility="Collapsed" />
            </Grid>

            <!-- Fixed action bar: status dot on the left, save/revert actions on the right -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Padding="24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="3.5"
                                Background="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusTextBlock" Margin="8,0,0,0"
                                   Style="{StaticResource Metadata}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="状态"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="就绪" />
                    </StackPanel>
                    <StackPanel x:Name="SaveActionsPanel" Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Visibility="Collapsed">
                        <Border x:Name="UnsavedBadge" Style="{StaticResource StatusPill}"
                                Background="{DynamicResource WarningSoftBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="未保存的修改" Style="{StaticResource Metadata}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                        <Button x:Name="RevertButton" Content="放弃修改" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                Padding="12,6" Click="Revert_Click"
                                AutomationProperties.Name="放弃修改" ToolTip="放弃修改并恢复" />
                        <Button x:Name="SaveButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                                Padding="18,6" Content="保存" Click="Save_Click"
                                ToolTip="保存设置" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
