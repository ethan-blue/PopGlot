<Window x:Class="PopGlot.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        xmlns:sections="clr-namespace:PopGlot.Windows.Sections"
        Title="设置" Width="960" Height="700" MinWidth="820" MinHeight="600"
        Icon="/PopGlot;component/Assets/PopGlot-v3.ico"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Single settings rail ==================== -->
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,20,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="6,0,6,0">
                    <TextBlock Text="设置" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="PopGlot 偏好" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                    <!-- The engine page leads and opens by default: picking a
                         translation engine is the first thing anyone wants
                         from settings; 通用/快捷键/隐私 come after. -->
                    <RadioButton x:Name="NavProvider" Style="{StaticResource NavButton}"
                                 GroupName="SettingsNav" IsChecked="True" Content="翻译引擎"
                                 local:Ui.Icon="{StaticResource IconProvider}"
                                 Checked="SubNav_Checked" Tag="Provider" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavButton}"
                                 GroupName="SettingsNav" Content="通用"
                                 local:Ui.Icon="{StaticResource IconSettings}"
                                 Checked="SubNav_Checked" Tag="General" />
                    <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavButton}"
                                 GroupName="SettingsNav" Content="快捷键"
                                 local:Ui.Icon="{StaticResource IconKeyboard}"
                                 Checked="SubNav_Checked" Tag="Shortcuts" />
                    <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavButton}"
                                 GroupName="SettingsNav" Content="隐私与数据"
                                 local:Ui.Icon="{StaticResource IconCapture}"
                                 Checked="SubNav_Checked" Tag="Privacy" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Content ==================== -->
        <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Caption controls -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMin}"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMax}"
                            AutomationProperties.Name="最大化"
                            ToolTip="最大化" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}"
                            AutomationProperties.Name="关闭窗口"
                            local:Ui.Icon="{StaticResource IconCaptionClose}"
                            ToolTip="关闭" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!--
                General/shortcuts/privacy are page-flow content and scroll the
                window; the services master–detail fills the height and scrolls
                its own list and editor, so the ListBox keeps virtualization.
            -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="SettingsScroll"
                              VerticalScrollBarVisibility="Auto" Padding="30,8,34,14">
                    <Grid>
                        <sections:GeneralSection x:Name="GeneralSection" Visibility="Collapsed" />
                        <sections:ShortcutsSection x:Name="ShortcutsSection" Visibility="Collapsed" />
                        <Grid x:Name="PrivacyPageHost" Visibility="Collapsed">
                            <StackPanel>
                                <sections:PrivacySection x:Name="CaptureSection" />
                                <sections:DataSection x:Name="DataSection" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
                <sections:ServicesSection x:Name="ProviderSection"
                                          Margin="30,8,34,14" />
            </Grid>

            <!-- Save bar: the buttons only exist while there is an unsaved draft. -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Padding="30,11">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="4"
                                Background="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusTextBlock" Margin="9,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" MaxWidth="560"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="状态"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="就绪" />
                    </StackPanel>
                    <StackPanel x:Name="SaveActionsPanel" Orientation="Horizontal"
                                HorizontalAlignment="Right" Visibility="Collapsed">
                        <!-- High-contrast draft badge: the warning chip cannot
                             blend into the bar the way a muted pill did. -->
                        <Border x:Name="UnsavedBadge" Style="{StaticResource StatusPill}"
                                Background="{DynamicResource WarningSoftBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                Padding="9,4" VerticalAlignment="Center">
                            <TextBlock Text="未保存的修改" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                        <Button Content="放弃修改" Margin="10,0,0,0" Style="{StaticResource GhostButton}"
                                Padding="14,8" Click="Revert_Click" />
                        <Button x:Name="SaveButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                                Padding="22,8" Content="保存" Click="Save_Click"
                                ToolTip="保存快捷键、出网策略与外观偏好。保存后对后续翻译生效；进行中的翻译继续使用发起时的配置。翻译引擎的增删改在「翻译引擎」页保存后同样只影响后续翻译。" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
