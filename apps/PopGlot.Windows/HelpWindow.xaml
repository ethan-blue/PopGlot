<Window x:Class="PopGlot.Windows.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        Title="帮助" Width="780" Height="560" MinWidth="620" MinHeight="440"
        Icon="/PopGlot;component/Assets/PopGlot-v5.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        KeyDown="HelpWindow_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Left navigation rail ==================== -->
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="10,0,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="6"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Image Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/PopGlot;component/Assets/popglot-app-avatar-v5.png"
                               AutomationProperties.Name="PopGlot 图标" />
                    </Border>
                    <TextBlock Text="帮助" Style="{StaticResource PageTitle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 文章导航：离线内容，全部来自本机 help/ 目录。 -->
                <ListBox x:Name="ArticleList" Grid.Row="1" Margin="0,12,0,0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="帮助文章目录"
                         SelectionChanged="ArticleList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource AccentSoftBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- ==================== Article content ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Caption controls (close only: this is a reader surface) -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionCloseButton}"
                            AutomationProperties.Name="关闭帮助"
                            local:Ui.Icon="{StaticResource IconCaptionClose}"
                            ToolTip="关闭帮助" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,6,28,10">
                <TextBlock x:Name="ArticleTitle" FontSize="20" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.Name="帮助文章标题" />
                <TextBlock x:Name="ArticleMeta" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"
                           Text="本机文档 · 不需要联网" />
            </StackPanel>

            <Border Grid.Row="2" Margin="24,0,28,20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}">
                <RichTextBox x:Name="ArticleViewer" Style="{StaticResource FlatRichTextBox}"
                             FontSize="13.5" Padding="18,14"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True" IsDocumentEnabled="True"
                             AutomationProperties.Name="帮助文章正文"
                             AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>
    </Grid>
</Window>
