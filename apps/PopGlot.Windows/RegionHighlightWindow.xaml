<Window x:Class="PopGlot.Windows.RegionHighlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Focusable="False" IsHitTestVisible="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid x:Name="RootGrid" IsHitTestVisible="False">
        <!-- Dual-layer viewfinder frame matching CaptureOverlayWindow -->
        <Border x:Name="HighlightFrame"
                Margin="4"
                BorderBrush="#90000000" BorderThickness="1"
                IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid ClipToBounds="True" IsHitTestVisible="False">
                <!-- Subtle interior veil so the captured area reads clearly on light or dark scenes -->
                <Border Background="{DynamicResource AccentSoftBrush}" Opacity="0.14" IsHitTestVisible="False" />

                <!-- Inner high-visibility accent border -->
                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                        IsHitTestVisible="False" SnapsToDevicePixels="True" />

                <!-- Subtle luminous inner hairline -->
                <Border BorderBrush="#40FFFFFF" BorderThickness="1" Margin="2"
                        IsHitTestVisible="False" SnapsToDevicePixels="True" />

                <!-- Corner L-brackets -->
                <Path HorizontalAlignment="Left" VerticalAlignment="Top"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                      StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                      Data="M 0,14 L 0,0 L 14,0" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Top"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                      StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                      Data="M 0,0 L 14,0 L 14,14" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                <Path HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                      StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                      Data="M 0,0 L 0,14 L 14,14" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                      StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                      Data="M 0,14 L 14,14 L 14,0" IsHitTestVisible="False" SnapsToDevicePixels="True" />
            </Grid>
        </Border>

        <!-- Optional preview label badge (shown only in Preview mode; above frame or tucked inside top-left) -->
        <Border x:Name="PreviewBadge" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="8,3" Margin="4,0,4,0"
                CornerRadius="{StaticResource ControlRadius}"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                IsHitTestVisible="False" SnapsToDevicePixels="True">
            <TextBlock x:Name="PreviewLabelText"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="11.5" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
