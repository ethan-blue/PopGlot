<Window x:Class="PopGlot.Windows.FloatingTriggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="46" Height="46"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Opacity="0" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        AutomationProperties.Name="翻译选中内容">

    <Grid Margin="6">
        <Border x:Name="ButtonSurface" Width="32" Height="32" CornerRadius="16"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1.2"
                Cursor="Hand" ToolTip="PopGlot 翻译 (点击翻译选中内容)">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Path Width="15" Height="15" Stretch="Uniform"
                      Fill="{DynamicResource AccentBrush}"
                      Data="{StaticResource IconTranslate}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
