<Window x:Class="PopGlot.Windows.FloatingTriggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="44" Height="44"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Opacity="0" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        AutomationProperties.Name="翻译选中内容">

    <Grid Margin="6">
        <Border x:Name="ButtonSurface" Width="30" Height="30" CornerRadius="15"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                Cursor="Hand" ToolTip="点击翻译当前选中内容">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Path Width="14" Height="14" Stretch="Uniform"
                      Fill="{DynamicResource AccentBrush}"
                      Data="{StaticResource IconTranslate}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
