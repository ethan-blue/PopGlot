<Window x:Class="PopGlot.Windows.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#66000000"
        Topmost="True" ShowInTaskbar="False" Cursor="Cross" ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Canvas x:Name="SelectionCanvas">
        <Border x:Name="SelectionBorder" Visibility="Collapsed"
                BorderBrush="#6EE7C7" BorderThickness="2" Background="#1800D9A7">
            <Border.Effect>
                <DropShadowEffect Color="#6EE7C7" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>
        </Border>
        <Border Canvas.Left="24" Canvas.Top="24" Padding="14,9" CornerRadius="9" Background="#E6141B26">
            <TextBlock Foreground="White" Text="拖动选择翻译区域 · Esc 取消" FontSize="14" />
        </Border>
        <Border x:Name="SizeBadge" Visibility="Collapsed" Padding="9,5" CornerRadius="6" Background="#E6141B26">
            <TextBlock x:Name="SizeText" Foreground="White" FontFamily="Consolas" FontSize="12" />
        </Border>
    </Canvas>
</Window>
