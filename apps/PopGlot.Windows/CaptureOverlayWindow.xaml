<Window x:Class="PopGlot.Windows.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Cursor="Cross" Focusable="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Canvas x:Name="SelectionCanvas" ClipToBounds="True" Background="#01000000">

        <!-- Dim everything, then punch a hole where the user is dragging. -->
        <Rectangle x:Name="ShadeFull" Fill="#8C0A0D14"
                   Width="{Binding ActualWidth, ElementName=SelectionCanvas}"
                   Height="{Binding ActualHeight, ElementName=SelectionCanvas}" />
        <Rectangle x:Name="ShadeTop" Fill="#8C0A0D14" Visibility="Collapsed" />
        <Rectangle x:Name="ShadeLeft" Fill="#8C0A0D14" Visibility="Collapsed" />
        <Rectangle x:Name="ShadeRight" Fill="#8C0A0D14" Visibility="Collapsed" />
        <Rectangle x:Name="ShadeBottom" Fill="#8C0A0D14" Visibility="Collapsed" />

        <!-- Crosshair guides shown until the drag starts. -->
        <Line x:Name="CrossHorizontal" Stroke="#66FFFFFF" StrokeThickness="1" StrokeDashArray="4 4" />
        <Line x:Name="CrossVertical" Stroke="#66FFFFFF" StrokeThickness="1" StrokeDashArray="4 4" />

        <Border x:Name="SelectionBorder" Visibility="Collapsed" CornerRadius="1"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                Background="Transparent" />

        <!-- Corner handles make the live selection read as a real marquee. -->
        <Rectangle x:Name="HandleTopLeft" Width="8" Height="8" Visibility="Collapsed"
                   Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2" />
        <Rectangle x:Name="HandleTopRight" Width="8" Height="8" Visibility="Collapsed"
                   Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2" />
        <Rectangle x:Name="HandleBottomLeft" Width="8" Height="8" Visibility="Collapsed"
                   Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2" />
        <Rectangle x:Name="HandleBottomRight" Width="8" Height="8" Visibility="Collapsed"
                   Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2" />

        <Border x:Name="SizeBadge" Visibility="Collapsed" Padding="9,5" CornerRadius="6"
                Background="#F2151A23" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="SizeText" Foreground="#E9EEF6"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12" />
        </Border>

        <!-- Instruction chip, centred on the monitor under the cursor. -->
        <Border x:Name="HintChip" Padding="16,11" CornerRadius="12"
                Background="#F2151A23" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                <TextBlock Text="拖动框选要翻译的区域" Foreground="#E9EEF6" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Width="1" Height="14" Background="#33FFFFFF" Margin="12,0" />
                <TextBlock x:Name="HintDetail" Foreground="#98A5B8" VerticalAlignment="Center"
                           Text="Esc 或右键取消 · 按住 Shift 仅提取文字 (OCR)" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
