<Window x:Class="PopGlot.Windows.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Cursor="Cross" Focusable="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Functional screen-overlay colours: the crosshair and hit-test layer
             sit on top of arbitrary screen content, not on an app surface, so
             they stay fixed instead of following the theme palette. -->
        <SolidColorBrush x:Key="CaptureCrosshairBrush" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="CaptureHitTestBrush" Color="#01000000" />
    </Window.Resources>

    <Canvas x:Name="SelectionCanvas" ClipToBounds="True" Background="{StaticResource CaptureHitTestBrush}">

        <!-- Dim everything, then punch a hole where the user is dragging. -->
        <Rectangle x:Name="ShadeFull" Fill="{DynamicResource OverlayScrimBrush}"
                   Width="{Binding ActualWidth, ElementName=SelectionCanvas}"
                   Height="{Binding ActualHeight, ElementName=SelectionCanvas}" />
        <Rectangle x:Name="ShadeTop" Fill="{DynamicResource OverlayScrimBrush}" Visibility="Collapsed" />
        <Rectangle x:Name="ShadeLeft" Fill="{DynamicResource OverlayScrimBrush}" Visibility="Collapsed" />
        <Rectangle x:Name="ShadeRight" Fill="{DynamicResource OverlayScrimBrush}" Visibility="Collapsed" />
        <Rectangle x:Name="ShadeBottom" Fill="{DynamicResource OverlayScrimBrush}" Visibility="Collapsed" />

        <!-- Crosshair guides shown until the drag starts. -->
        <Line x:Name="CrossHorizontal" Stroke="{StaticResource CaptureCrosshairBrush}" StrokeThickness="1" StrokeDashArray="4 4" />
        <Line x:Name="CrossVertical" Stroke="{StaticResource CaptureCrosshairBrush}" StrokeThickness="1" StrokeDashArray="4 4" />

        <!-- No DropShadowEffect here: this element changes size on every
             pointer move and a live bitmap effect makes the full-screen
             layered window visibly trail the cursor. -->
        <Border x:Name="SelectionBorder" Visibility="Collapsed" CornerRadius="2"
                BorderBrush="#F2FFFFFF" BorderThickness="2" Background="Transparent" />

        <!-- Corner handles make the live selection read as a real marquee. -->
        <Rectangle x:Name="HandleTopLeft" Width="8" Height="8" Visibility="Collapsed"
                   Fill="#F2FFFFFF" RadiusX="2" RadiusY="2" />
        <Rectangle x:Name="HandleTopRight" Width="8" Height="8" Visibility="Collapsed"
                   Fill="#F2FFFFFF" RadiusX="2" RadiusY="2" />
        <Rectangle x:Name="HandleBottomLeft" Width="8" Height="8" Visibility="Collapsed"
                   Fill="#F2FFFFFF" RadiusX="2" RadiusY="2" />
        <Rectangle x:Name="HandleBottomRight" Width="8" Height="8" Visibility="Collapsed"
                   Fill="#F2FFFFFF" RadiusX="2" RadiusY="2" />

        <Border x:Name="SizeBadge" Visibility="Collapsed" Padding="9,5" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="SizeText" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12" />
        </Border>

        <!-- Instruction chip, centred on the monitor under the cursor. -->
        <Border x:Name="HintChip" Padding="16,11" CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                <TextBlock Text="拖动框选要翻译的区域" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Width="1" Height="14" Background="{StaticResource CaptureCrosshairBrush}" Margin="12,0" />
                <TextBlock x:Name="HintDetail" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Text="Esc 或右键取消 · 按住 Shift 仅提取文字 (OCR)" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
