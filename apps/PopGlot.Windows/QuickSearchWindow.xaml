<Window x:Class="PopGlot.Windows.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        Title="PopGlot 极速查词" Width="680" SizeToContent="Height" MaxHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">

    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" CornerRadius="18"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search input bar -->
            <Border Grid.Row="0" Padding="18,14" Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="17,17,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource AccentBrush}"
                              Data="{StaticResource IconSearch}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource FlatTextBox}"
                             FontSize="16" FontWeight="Medium" TextWrapping="Wrap" AcceptsReturn="True"
                             MaxHeight="80" VerticalScrollBarVisibility="Auto"
                             local:Ui.Placeholder="输入任意单词、长句、代码报错，回车立即翻译…"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Style="{StaticResource StatusPill}" Padding="8,3"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}">
                            <TextBlock x:Name="LangBadge" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Text="自动 → 中文" />
                        </Border>
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0"
                                AutomationProperties.Name="关闭查词栏"
                                ToolTip="关闭 (Esc)" Click="CloseButton_Click">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar x:Name="SearchProgress" Grid.Row="1" Height="2" IsIndeterminate="True"
                         Visibility="Collapsed" />

            <!-- Live Result Container -->
            <Border x:Name="ResultContainer" Grid.Row="2" Padding="20,16" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="翻译结果" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock x:Name="PhoneticLabel" FontSize="11.5" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SpeakButton" Style="{StaticResource IconButton}" Width="26" Height="24"
 AutomationProperties.Name="朗读译文"
                                    ToolTip="朗读译文 (Edge TTS)" Click="Speak_Click">
                                <Path x:Name="SpeakIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconSpeaker}" />
                            </Button>
                            <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Width="26" Height="24"
 AutomationProperties.Name="复制译文"
                                    ToolTip="复制译文" Click="Copy_Click">
                                <Path x:Name="CopyIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconCopy}" />
                            </Button>
                            <Button x:Name="StarButton" Style="{StaticResource IconButton}" Width="26" Height="24"
 AutomationProperties.Name="加入生词本"
                                    ToolTip="加入生词本 / 收藏" Click="Star_Click">
                                <Path x:Name="StarIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconStar}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <RichTextBox x:Name="ResultRichBox" Style="{StaticResource FlatRichTextBox}"
                                 FontSize="15" MaxHeight="220" VerticalScrollBarVisibility="Auto" />

                    <Border x:Name="ExplanationCard" Margin="0,10,0,0" Padding="10,8" CornerRadius="8"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ExplanationLabel" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bottom Shortcuts footer -->
            <Border Grid.Row="3" Padding="18,8" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,17,17">
                <Grid>
                    <TextBlock x:Name="FooterStatus" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Text="输入文字后按 Enter 翻译" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Enter 翻译 · Ctrl+R 朗读 · Esc 退出" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
