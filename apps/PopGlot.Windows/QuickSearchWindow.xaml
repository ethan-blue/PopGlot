<Window x:Class="PopGlot.Windows.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        Title="PopGlot 极速查词" Width="640" MinWidth="480" SizeToContent="Height" MaxHeight="600"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">

    <!-- Not AllowsTransparency: text-first window keeps ClearType via an
         opaque surface; DWM provides rounding and shadow. -->
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Adaptive height: compact bar when idle, grows with the result,
                     caps at MaxHeight; overflow scrolls inside ResultContainer. -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search input bar: Spotlight/Raycast style, flat & clean -->
            <Border Grid.Row="0" Padding="16,12" Background="Transparent"
                    CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Clean minimalist search icon -->
                    <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Data="{StaticResource IconSearch}"
                          Margin="2,0,12,0" VerticalAlignment="Center" />

                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource FlatTextBox}"
                             FontSize="14" FontWeight="Normal" TextWrapping="Wrap" AcceptsReturn="True"
                             MaxHeight="80" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="查词输入框"
                             local:Ui.Placeholder="搜索单词、句子或报错信息…"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="LangBadge" Style="{StaticResource Metadata}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Text="自动 → 中文" />
                        <!-- Global TEXT-translation style selector: consistent with the workbench and panel. -->
                        <Button x:Name="StyleSelectorButton" Style="{StaticResource IconButton}"
                                Width="Auto" MinWidth="32" Padding="4,0" Margin="6,0,0,0"
                                AutomationProperties.Name="文字翻译风格"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="文字翻译风格（仅影响下一次文字翻译；截图视觉直译不应用）"
                                Click="StyleSelector_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="11" Height="11" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBrush}"
                                      Data="{StaticResource IconSparkles}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StyleSelectorLabel" Text="风格" FontSize="11.5"
                                           Margin="4,0,0,0" VerticalAlignment="Center" MaxWidth="72"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Path Width="8" Height="8" Stretch="Uniform" Margin="3,0,0,0"
                                      Fill="{DynamicResource TextTertiaryBrush}"
                                      Data="{StaticResource IconChevronDown}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="6,0,0,0"
                                AutomationProperties.Name="打开设置"
                                ToolTip="设置" Click="SettingsButton_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconSettings}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0"
                                AutomationProperties.Name="关闭查词栏"
                                ToolTip="关闭 (Esc)" Click="CloseButton_Click">
                            <Path Width="11" Height="11" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>

                    <!-- Loading line overlays the search bar's bottom edge -->
                    <ProgressBar x:Name="SearchProgress" Grid.ColumnSpan="3" Height="2" IsIndeterminate="True"
                                 VerticalAlignment="Bottom" Visibility="Collapsed"
                                 Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" />
                </Grid>
            </Border>

            <!-- Hairline Divider -->
            <Border Grid.Row="0" Height="1" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Bottom" />

            <!-- Live Result Container: flat and integrated stream -->
            <Border x:Name="ResultContainer" Grid.Row="1" Padding="16,12" Visibility="Collapsed">
                <StackPanel>
                    <!-- Result Header & Actions -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PhoneticLabel" Style="{StaticResource MonoText}" FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis" MaxWidth="240" />
                            <TextBlock x:Name="StreamIndicator" Style="{StaticResource Metadata}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       Margin="6,0,0,0" Text="正在生成…" />
                            <TextBlock x:Name="IncompleteBadge" Style="{StaticResource Metadata}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       Margin="6,0,0,0" Text="未完成" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SpeakButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                    AutomationProperties.Name="朗读译文"
                                    ToolTip="朗读译文 (Ctrl+P)" Click="Speak_Click">
                                <Path x:Name="SpeakIcon" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconSpeaker}" />
                            </Button>
                            <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                    Margin="2,0,0,0"
                                    AutomationProperties.Name="复制译文"
                                    ToolTip="复制译文 (Ctrl+Shift+C)" Click="Copy_Click">
                                <Path x:Name="CopyIcon" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconCopy}" />
                            </Button>
                            <Button x:Name="StarButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                    Margin="2,0,0,0"
                                    AutomationProperties.Name="加入生词本"
                                    ToolTip="收藏到生词本 (Ctrl+S)" Click="Star_Click">
                                <Path x:Name="StarIcon" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconStar}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Plain text streaming layer (zero token-by-token FlowDoc rebuild) -->
                    <TextBox x:Name="ResultStreamBox"
                             Style="{StaticResource ResultTextBox}"
                             FontSize="14.5"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             Focusable="False"
                             IsHitTestVisible="True"
                             MinHeight="24"
                             MaxHeight="220"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed"
                             AutomationProperties.LiveSetting="Off"
                             AutomationProperties.Name="流式翻译中" />

                    <!-- RichTextBox for final one-off Markdown rendering -->
                    <RichTextBox x:Name="ResultRichBox" Style="{StaticResource FlatRichTextBox}"
                                 FontSize="14.5" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                 MinHeight="24"
                                 IsReadOnly="True" IsDocumentEnabled="True"
                                 Background="Transparent" BorderThickness="0"
                                 Visibility="Collapsed" />

                    <!-- Explanation: hairline + text -->
                    <StackPanel x:Name="ExplanationCard" Margin="0,8,0,0" Visibility="Collapsed">
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
                        <TextBlock x:Name="ExplanationLabel" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Error Card shown when translation fails or no engine is configured -->
                    <Border x:Name="ErrorCard" Margin="0,8,0,0" Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="ErrorTitle" Text="需要处理" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}" FontSize="12.5" />
                                <TextBlock x:Name="ErrorDetail" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="ErrorSettingsBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="打开设置" VerticalAlignment="Center" Padding="10,6"
                                    Click="SettingsButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bottom Shortcuts footer: Spotlight/Raycast style -->
            <Border Grid.Row="2" Padding="16,8" Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterStatus" Grid.Column="0" Style="{StaticResource Metadata}"
                               VerticalAlignment="Center" Text="输入后按 Enter 翻译"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="翻译状态" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Dynamic per-state shortcut hints; text is owned by QuickSearchState.HintsText -->
                        <TextBlock x:Name="FooterHints" Text="Enter 翻译 · Shift+Enter 换行 · Esc 关闭" Style="{StaticResource Metadata}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
