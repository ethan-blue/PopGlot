<Window x:Class="PopGlot.Windows.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        Title="PopGlot 极速查词" Width="640" MinWidth="480" SizeToContent="Height" MaxHeight="600"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">

    <!-- Not AllowsTransparency: text-first window keeps ClearType via an
         opaque surface; DWM provides rounding and shadow. -->
    <Grid>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Adaptive height: compact bar when idle, grows with the result,
                     caps at MaxHeight; overflow scrolls inside ResultContainer. -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search input bar: Spotlight/Raycast flagship style -->
            <Border Grid.Row="0" Padding="16,12" Background="Transparent"
                    CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Prominent Spotlight search icon -->
                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource AccentBrush}"
                          Data="{StaticResource IconSearch}"
                          Margin="2,0,12,0" VerticalAlignment="Center" />

                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource FlatTextBox}"
                             FontSize="15" FontWeight="Normal" TextWrapping="Wrap" AcceptsReturn="True"
                             MaxHeight="80" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="查词输入框"
                             local:Ui.Placeholder="搜索单词、句子或报错信息…"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <!-- Enter keycap affordance inside the search bar -->
                        <Button x:Name="SearchEnterKeycap" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Margin="0,0,6,0" VerticalAlignment="Center"
                                Cursor="Hand" ToolTip="按 Enter 立即翻译"
                                AutomationProperties.Name="按 Enter 立即翻译"
                                AutomationProperties.HelpText="点击或按 Enter 立即翻译当前输入的文本"
                                FocusVisualStyle="{StaticResource FocusRing}"
                                IsTabStop="True"
                                Click="SearchEnterKeycap_Click"
                                KeyDown="SearchEnterKeycap_KeyDown">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="KeycapBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="7,3"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="KeycapBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            <Setter TargetName="KeycapBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="KeycapBorder" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="KeycapBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="KeycapBorder" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↵" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="Enter" FontFamily="{StaticResource UiFontFamily}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Language Badge Pill -->
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="8,3" VerticalAlignment="Center" Margin="2,0,4,0">
                            <TextBlock x:Name="LangBadge" Style="{StaticResource Metadata}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" FontWeight="Medium"
                                       VerticalAlignment="Center" Text="自动 → 中文" />
                        </Border>

                        <!-- Global TEXT-translation style selector: consistent with the workbench and panel. -->
                        <Button x:Name="StyleSelectorButton" Style="{StaticResource IconButton}"
                                Width="Auto" MinWidth="32" Padding="4,0" Margin="4,0,0,0"
                                AutomationProperties.Name="文字翻译风格"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="文字翻译风格（下一次文字翻译生效）"
                                Click="StyleSelector_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBrush}"
                                      Data="{StaticResource IconSparkles}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StyleSelectorLabel" Text="风格" FontSize="11.5"
                                           Margin="4,0,0,0" VerticalAlignment="Center" MaxWidth="72"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Path Width="8" Height="8" Stretch="Uniform" Margin="3,0,0,0"
                                      Fill="{DynamicResource TextTertiaryBrush}"
                                      Data="{StaticResource IconChevronDown}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0"
                                AutomationProperties.Name="打开设置"
                                ToolTip="设置" Click="SettingsButton_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconSettings}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0"
                                AutomationProperties.Name="关闭查词栏"
                                ToolTip="关闭 (Esc)" Click="CloseButton_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>

                    <!-- Loading line overlays the search bar's bottom edge -->
                    <ProgressBar x:Name="SearchProgress" Grid.ColumnSpan="3" Height="2" IsIndeterminate="True"
                                 VerticalAlignment="Bottom" Visibility="Collapsed"
                                 Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" />
                </Grid>
            </Border>

            <!-- Hairline Divider -->
            <Border Grid.Row="0" Height="1" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Bottom" />

            <!-- Empty State: idle bar is just search box + footer hints
                 (the footer status already says 输入后按 Enter 翻译) -->
            <Border x:Name="EmptyStateContainer" Grid.Row="1" Padding="20,2" Visibility="Visible" />

            <!-- Live Result Container: Spotlight Card Hierarchy -->
            <Border x:Name="ResultContainer" Grid.Row="1" Padding="16,14" Visibility="Collapsed">
                <StackPanel>
                    <!-- Result Card Box: clean elevated container -->
                    <Border Background="{DynamicResource ResultSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource ControlRadius}" Padding="14,12">
                        <StackPanel>
                            <!-- Card Header: Pill, Phonetic, Status Indicator, Action Buttons -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Result Pill -->
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                            Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="译文" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock x:Name="PhoneticLabel" Style="{StaticResource MonoText}" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" Visibility="Collapsed"
                                               TextTrimming="CharacterEllipsis" MaxWidth="240"
                                               Margin="0,0,8,0" />
                                    <TextBlock x:Name="StreamIndicator" Style="{StaticResource Metadata}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" Visibility="Collapsed"
                                               Margin="0,0,8,0" Text="正在生成…" />
                                    <TextBlock x:Name="IncompleteBadge" Style="{StaticResource Metadata}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" Visibility="Collapsed"
                                               Margin="0,0,8,0" Text="未完成" />
                                </StackPanel>

                                <!-- Top-right Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="SpeakButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                                            AutomationProperties.Name="朗读译文"
                                            ToolTip="朗读译文 (Ctrl+P)" Click="Speak_Click">
                                        <Path x:Name="SpeakIcon" Width="12" Height="12" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconSpeaker}" />
                                    </Button>
                                    <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                                            Margin="4,0,0,0"
                                            AutomationProperties.Name="复制译文"
                                            ToolTip="复制译文 (Ctrl+Shift+C)" Click="Copy_Click">
                                        <Path x:Name="CopyIcon" Width="12" Height="12" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconCopy}" />
                                    </Button>
                                    <Button x:Name="StarButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                                            Margin="4,0,0,0"
                                            AutomationProperties.Name="收藏到生词本"
                                            ToolTip="收藏到生词本 (Ctrl+S)" Click="Star_Click">
                                        <Path x:Name="StarIcon" Width="12" Height="12" Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              Data="{StaticResource IconStar}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Subtle divider inside result card -->
                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" />

                            <!-- Plain text streaming layer (zero token-by-token FlowDoc rebuild) -->
                            <TextBox x:Name="ResultStreamBox"
                                     Style="{StaticResource ResultTextBox}"
                                     FontSize="14.5"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Focusable="False"
                                     IsHitTestVisible="True"
                                     MinHeight="24"
                                     MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto"
                                     Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Off"
                                     AutomationProperties.Name="流式翻译中" />

                            <!-- RichTextBox for final one-off Markdown rendering -->
                            <RichTextBox x:Name="ResultRichBox" Style="{StaticResource FlatRichTextBox}"
                                         FontSize="14.5" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                         MinHeight="24"
                                         IsReadOnly="True" IsDocumentEnabled="True"
                                         Background="Transparent" BorderThickness="0"
                                         Visibility="Collapsed"
                                         AutomationProperties.Name="翻译结果" />
                        </StackPanel>
                    </Border>

                    <!-- Explanation: distinct sub-card hierarchy -->
                    <Border x:Name="ExplanationCard" Margin="0,10,0,0" Padding="12,10" CornerRadius="{StaticResource ControlRadius}"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBrush}"
                                      Data="{StaticResource IconSparkles}" VerticalAlignment="Center" />
                                <TextBlock Text="详细释义" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ExplanationLabel" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Error Card shown when translation fails or no engine is configured -->
                    <Border x:Name="ErrorCard" Margin="0,10,0,0" Padding="12,10" CornerRadius="{StaticResource ControlRadius}"
                            Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                  Fill="{DynamicResource DangerBrush}"
                                  Data="{StaticResource IconClear}" Margin="0,2,10,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="ErrorTitle" Text="需要处理" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}" FontSize="12.5" />
                                <TextBlock x:Name="ErrorDetail" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="ErrorSettingsBtn" Grid.Column="2" Style="{StaticResource GhostButton}"
                                    Content="打开设置" VerticalAlignment="Center" Padding="10,6"
                                    Click="SettingsButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bottom Shortcuts footer: Spotlight/Raycast style -->
            <Border Grid.Row="2" Padding="16,8" Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource TextTertiaryBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterStatus" Style="{StaticResource Metadata}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Text="输入后按 Enter 翻译"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="翻译状态" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Dynamic per-state shortcut hints; text is owned by QuickSearchState.HintsText -->
                        <TextBlock x:Name="FooterHints" Text="Enter 翻译 · Shift+Enter 换行 · Esc 关闭" Style="{StaticResource Metadata}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="5,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="按 Esc 关闭或取消">
                            <TextBlock Text="Esc" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <!-- High-contrast window boundary: transparent in the normal themes (the
         root Border above keeps its own subtle hairline, so nothing changes
         visually), a crisp WindowText ring under system high contrast where
         the window would otherwise blend into a matching system theme.
         Overlay-only: no layout footprint, no hit testing. -->
    <Border Background="Transparent"
            BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1"
            CornerRadius="12" IsHitTestVisible="False" />
    </Grid>
</Window>
