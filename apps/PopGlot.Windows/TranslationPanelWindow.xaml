<Window x:Class="PopGlot.Windows.TranslationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        Title="PopGlot 翻译浮窗" Width="540" Height="380" MinWidth="460" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="5" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!--
        Deliberately NOT AllowsTransparency: layered windows lose ClearType,
        and this window is text-first. Rounded corners and the shadow come
        from DWM instead of a transparent padding border.
    -->
    <Grid>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Unified flat reading stream: source area and result area live
                     in one coherent canvas with the result filling all remaining
                     space, so translations enjoy maximum vertical height. -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==================== 1. Title & Upper Tool Bar ==================== -->
            <Border x:Name="HeaderBar" Grid.Row="0" Padding="12,8,12,8"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand mark and pin toggle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin: grey = closes on focus loss, lit = stays on top. -->
                        <ToggleButton x:Name="PinToggle" Width="32" Height="32"
                                      AutomationProperties.Name="固定浮窗"
                                      Cursor="Hand" ToolTip="固定浮窗"
                                      FocusVisualStyle="{StaticResource FocusRing}"
                                      Checked="PinToggle_Changed" Unchecked="PinToggle_Changed">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Surface" Background="Transparent" CornerRadius="6">
                                        <Path x:Name="Glyph" Width="12" Height="12" Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              Data="{StaticResource IconPin}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Opacity="0.65" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Surface" Property="Background"
                                                    Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Surface" Property="Background"
                                                    Value="{DynamicResource SurfacePressedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Surface" Property="Background"
                                                    Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="Glyph" Property="Fill"
                                                    Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource TextDisabledBrush}" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Path Width="13" Height="13" Margin="8,0,0,0" Stretch="Uniform"
                              Fill="{DynamicResource AccentBrush}" Data="{StaticResource IconTranslate}"
                              VerticalAlignment="Center" />
                        <TextBlock Text="PopGlot" Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Center: Lightweight toolbar language selector -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" MaxWidth="260">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="68" MaxWidth="110" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="68" MaxWidth="110" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SourceLangCombo" Grid.Column="0" Style="{StaticResource LanguagePickerComboBox}"
                                  MinHeight="32" HorizontalAlignment="Stretch" ToolTip="原文语言"
                                  AutomationProperties.Name="原文语言"
                                  SelectionChanged="Language_SelectionChanged" />
                        <Button x:Name="SwapLangButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                AutomationProperties.Name="交换语言方向"
                                Width="32" Height="32" Margin="4,0" ToolTip="交换语言方向" Click="SwapLangButton_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconSwap}" />
                        </Button>
                        <ComboBox x:Name="TargetLangCombo" Grid.Column="2" Style="{StaticResource LanguagePickerComboBox}"
                                  MinHeight="32" HorizontalAlignment="Stretch" ToolTip="译文语言"
                                  AutomationProperties.Name="译文语言"
                                  SelectionChanged="Language_SelectionChanged" />
                    </Grid>

                    <!-- Right: Window actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ExpandButton" Style="{StaticResource IconButton}"
                                AutomationProperties.Name="在主窗口中打开"
                                Width="32" Height="32" ToolTip="在主窗口中打开"
                                Click="ExpandButton_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconOpenExternal}" />
                        </Button>

                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                                AutomationProperties.Name="打开设置"
                                Width="32" Height="32" Margin="2,0,0,0" ToolTip="设置"
                                Click="SettingsButton_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconSettings}" />
                        </Button>

                        <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                                AutomationProperties.Name="关闭浮窗"
                                Width="32" Height="32" Margin="8,0,0,0"
                                ToolTip="关闭 (Esc)" Click="CloseButton_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>

                    <!-- Loading line overlays the title bar's bottom edge -->
                    <ProgressBar x:Name="Progress" Grid.ColumnSpan="3" Height="2" IsIndeterminate="True"
                                 VerticalAlignment="Bottom"
                                 Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" />
                </Grid>
            </Border>

            <!-- ==================== 2. Unified Reading Stream ==================== -->
            <Grid Grid.Row="1" Margin="14,10,14,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── Upper Stream: Source text & actions ── -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SourceInputBox" Grid.Row="0" Style="{StaticResource FlatTextBox}"
                             FontSize="14" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="36" MaxHeight="86" VerticalScrollBarVisibility="Auto"
                             local:Ui.Placeholder="输入文本，Enter 翻译"
                             AutomationProperties.Name="翻译原文输入框"
                             KeyDown="SourceInputBox_KeyDown" />

                    <!-- Source action & meta bar: clean and quiet -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SourceLabel" Text="原文" Style="{StaticResource Metadata}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SourceKindLabel" Style="{StaticResource Metadata}"
                                       Margin="4,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Global TEXT-translation style selector: compact icon+label+chevron so the
                                 header (and the window itself) is never squeezed. -->
                            <Button x:Name="StyleSelectorButton" Style="{StaticResource IconButton}"
                                    Width="Auto" MinWidth="32" Padding="4,0" Margin="0,0,6,0"
                                    AutomationProperties.Name="文字翻译风格"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="文字翻译风格（下一次文字翻译生效）"
                                    Click="StyleSelector_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Fill="{DynamicResource AccentBrush}"
                                          Data="{StaticResource IconStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StyleSelectorLabel" Text="风格" FontSize="11.5"
                                               Margin="4,0,0,0" VerticalAlignment="Center" MaxWidth="56"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Path Width="8" Height="8" Stretch="Uniform" Margin="3,0,0,0"
                                          Fill="{DynamicResource TextTertiaryBrush}"
                                          Data="{StaticResource IconChevronDown}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SourceSpeakBtn" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,2,0"
                                    AutomationProperties.Name="朗读原文"
                                    ToolTip="朗读原文" Click="SourceSpeak_Click">
                                <Path x:Name="SourceSpeakIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconSpeaker}" />
                            </Button>
                            <Button x:Name="SourceCopyBtn" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,2,0"
                                    AutomationProperties.Name="复制原文"
                                    ToolTip="复制原文" Click="SourceCopy_Click">
                                <Path x:Name="SourceCopyIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconCopy}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,2,0"
                                    AutomationProperties.Name="合并断行"
                                    ToolTip="合并断行" Click="MergeLines_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconMergeLines}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,2,0"
                                    AutomationProperties.Name="清空原文"
                                    ToolTip="清空原文" Click="SourceClear_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconClear}" />
                            </Button>
                            <Button x:Name="RetryButton" AutomationProperties.Name="重试翻译"
                                    Style="{StaticResource IconButton}" Width="32" Height="32"
                                    ToolTip="重试 (Ctrl+R)" Click="Retry_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconRetry}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Subtle hairline divider -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,8,0,8" SnapsToDevicePixels="True" />

                <!-- ── Lower Stream: Result reading flow (fills every remaining pixel) ── -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- No MinHeight floor here on purpose: the duplicated
                             120 DIP floors (row + inner grid) used to push the
                             bottom status bar out of the window at minimum
                             size. The result boxes keep their own 68 DIP floor
                             and the window MinHeight (380) guarantees every
                             fixed row, including the footer, stays visible. -->
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" MaxHeight="80" />
                    </Grid.RowDefinitions>

                    <!-- Engine header & result actions (Row 0) -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="ShowTranslationChoice" Content="译文" GroupName="PanelReading"
                                         Style="{StaticResource SegmentChoice}" IsChecked="True"
                                         AutomationProperties.Name="显示译文"
                                         ToolTip="翻译结果。说明附在译文下面，不用再单独解释。"
                                         Click="ShowTranslation_Click" />
                            <RadioButton x:Name="ShowSummaryChoice" Content="要点" GroupName="PanelReading"
                                         Style="{StaticResource SegmentChoice}"
                                         AutomationProperties.Name="显示要点"
                                         ToolTip="把原文收成几条要点。译文还在，可以切回来。需要已配置的模型。"
                                         Click="ShowSummary_Click" />
                            <TextBlock x:Name="EngineBadge" Style="{StaticResource Metadata}"
                                       FontWeight="SemiBold" FontSize="12" Margin="4,0,0,0"
                                       Foreground="{DynamicResource AccentBrush}" Text=""
                                       VerticalAlignment="Center" />

                            <Border x:Name="StreamIndicator" Visibility="Collapsed"
                                    Margin="8,0,0,0" Padding="6,2" CornerRadius="6"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="正在生成…" Style="{StaticResource Metadata}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="PhoneticText" Style="{StaticResource MonoText}" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ResultSpeakBtn" AutomationProperties.Name="朗读译文"
                                    Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,2,0"
                                    ToolTip="朗读译文" Click="ResultSpeak_Click">
                                <Path x:Name="ResultSpeakIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconSpeaker}" />
                            </Button>
                            <Button x:Name="ResultCopyBtn" AutomationProperties.Name="复制译文" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,2,0"
                                    ToolTip="复制译文" Click="ResultCopy_Click">
                                <Path x:Name="ResultCopyIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconCopy}" />
                            </Button>
                            <ToggleButton x:Name="StarToggle" Width="32" Height="32"
                                          AutomationProperties.Name="收藏到生词本"
                                          ToolTip="收藏到生词本" Click="StarToggle_Click"
                                          FocusVisualStyle="{StaticResource FocusRing}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Surface" Background="Transparent" CornerRadius="6">
                                            <Path x:Name="Glyph" Width="12" Height="12" Stretch="Uniform"
                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                  Data="{StaticResource IconStar}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background"
                                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Surface" Property="Background"
                                                        Value="{DynamicResource SurfacePressedBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Surface" Property="Background"
                                                        Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter TargetName="Glyph" Property="Fill"
                                                        Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource TextDisabledBrush}" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <!-- Text Layer (Grid.Row="1") -->
                    <Grid Grid.Row="1">
                        <TextBox x:Name="TranslationTextBox" Style="{StaticResource ResultTextBox}"
                                 FontSize="14.5" TextWrapping="Wrap" IsReadOnly="True"
                                 MinHeight="68" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.LiveSetting="Off"
                                 AutomationProperties.Name="翻译结果"
                                 local:Ui.Placeholder="译文将显示在这里…"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                        <RichTextBox x:Name="TranslationRichBox" Style="{StaticResource FlatRichTextBox}"
                                     FontSize="14.5"
                                     MinHeight="68" VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="True" IsDocumentEnabled="True"
                                     Background="Transparent" BorderThickness="0"
                                     Visibility="Collapsed"
                                     AutomationProperties.Name="格式化翻译结果" />
                        <!-- Skeleton shown while a request is in flight -->
                        <StackPanel x:Name="ResultSkeleton" Margin="2,0,0,0" Height="68"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Height="12" Width="230" HorizontalAlignment="Left"
                                    Background="{DynamicResource SurfacePressedBrush}" CornerRadius="6" />
                            <Border Height="12" Width="170" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Background="{DynamicResource SurfacePressedBrush}" CornerRadius="6" Opacity="0.75" />
                            <Border Height="12" Width="200" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Background="{DynamicResource SurfacePressedBrush}" CornerRadius="6" Opacity="0.5" />
                        </StackPanel>
                    </Grid>

                    <!-- Explanation & Warnings Layer (ScrollViewer Grid.Row="2", capped height, no nested scrollviewer) -->
                    <ScrollViewer Grid.Row="2" MaxHeight="80" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="ExplanationBox" Margin="0,6,0,0" Visibility="Collapsed">
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ExplanationText" Grid.Column="0" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button x:Name="ErrorSettingsButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                            Content="打开设置" Padding="8,3" FontSize="11.5" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            Click="SettingsButton_Click" />
                                </Grid>
                            </StackPanel>

                            <!-- Protected Token Chips (WrapPanel wraps naturally without horizontal scroll trap) -->
                            <ItemsControl x:Name="TermsList" Visibility="Collapsed" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TokenChipButton}"
                                                Content="{Binding}" Margin="0,2,4,2"
                                                Click="TermChip_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Warning Box -->
                            <Border x:Name="WarningBox" Margin="0,6,0,0" Padding="8,6" CornerRadius="6"
                                    Background="{DynamicResource WarningSoftBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="WarningText" Style="{StaticResource Metadata}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer Status Bar (Row 3, pinned to the bottom) -->
                <Grid Grid.Row="3" Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Metadata}" VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="翻译状态" />
                    </StackPanel>
                    <TextBlock x:Name="RouteText" Grid.Column="1" Style="{StaticResource Metadata}" VerticalAlignment="Center"
                               Margin="12,0,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>

    <!-- High-contrast window boundary: transparent in the normal themes (the
         root Border above keeps its own subtle hairline, so nothing changes
         visually), a crisp WindowText ring under system high contrast where
         the window would otherwise blend into a matching system theme.
         Overlay-only: no layout footprint, no hit testing. -->
    <Border Background="Transparent"
            BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1"
            CornerRadius="12" IsHitTestVisible="False" />
    </Grid>
</Window>
