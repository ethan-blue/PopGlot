<Window x:Class="PopGlot.Windows.TranslationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        Width="580" MinHeight="180" MaxHeight="780" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!--
        Deliberately NOT AllowsTransparency: layered windows lose ClearType,
        and this window is text-first. Rounded corners and the shadow come
        from DWM instead of a transparent padding border.
    -->
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== 1. Title Bar ==================== -->
            <Border x:Name="HeaderBar" Grid.Row="0" Padding="10,8,10,8"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin: grey = closes on focus loss, lit = stays on top. -->
                        <ToggleButton x:Name="PinToggle" Width="26" Height="26"
                                      AutomationProperties.Name="固定浮窗"
                                      Cursor="Hand" ToolTip="固定浮窗（不随失焦关闭）"
                                      Checked="PinToggle_Changed" Unchecked="PinToggle_Changed">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Surface" Background="Transparent" CornerRadius="6">
                                        <Path x:Name="Glyph" Width="12" Height="12" Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              Data="{StaticResource IconPin}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Opacity="0.6" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Surface" Property="Background"
                                                    Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Surface" Property="Background"
                                                    Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="Glyph" Property="Fill"
                                                    Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <TextBlock Text="PopGlot 翻译" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ExpandButton" Style="{StaticResource IconButton}"
                                AutomationProperties.Name="在主窗口中打开"
                                Width="26" Height="26" ToolTip="在主窗口中打开"
                                Click="ExpandButton_Click">
                            <Path Width="11" Height="11" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Data="{StaticResource IconOpenExternal}" />
                        </Button>

                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                                AutomationProperties.Name="打开设置"
                                Width="26" Height="26" Margin="2,0,0,0" ToolTip="设置"
                                Click="SettingsButton_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Data="{StaticResource IconSettings}" />
                        </Button>

                        <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                                AutomationProperties.Name="关闭浮窗"
                                Width="26" Height="26" Margin="2,0,0,0"
                                ToolTip="关闭 (Esc)" Click="CloseButton_Click">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading Progress Bar -->
            <ProgressBar x:Name="Progress" Grid.Row="1" Height="2" IsIndeterminate="True"
                         Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" />

            <!-- ==================== 2. Body Workspace ==================== -->
            <StackPanel Grid.Row="2" Margin="14,12,14,12">

                <!-- ── Segment 1: Source ── -->
                <Border Background="{DynamicResource InputBrush}" CornerRadius="10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="SourceInputBox" Grid.Row="0" Style="{StaticResource FlatTextBox}"
                                 FontSize="13.5" TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="40" MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                 local:Ui.Placeholder="输入或粘贴内容，Enter 翻译，Shift+Enter 换行"
                                 KeyDown="SourceInputBox_KeyDown" />

                        <!-- Source action bar: speak / copy / clear / merge breaks, then the
                             input kind and the retry shortcut on the far right. -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SourceSpeakBtn" Style="{StaticResource IconButton}" Width="24" Height="22"
                                        AutomationProperties.Name="朗读原文"
                                        ToolTip="朗读原文" Click="SourceSpeak_Click">
                                    <Path x:Name="SourceSpeakIcon" Width="11" Height="11" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="{StaticResource IconSpeaker}" />
                                </Button>
                                <Button x:Name="SourceCopyBtn" Style="{StaticResource IconButton}" Width="24" Height="22"
                                        AutomationProperties.Name="复制原文"
                                        ToolTip="复制原文" Click="SourceCopy_Click">
                                    <Path x:Name="SourceCopyIcon" Width="11" Height="11" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="{StaticResource IconCopy}" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="24" Height="22"
                                        AutomationProperties.Name="清空原文"
                                        ToolTip="清空原文" Click="SourceClear_Click">
                                    <Path Width="9" Height="9" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="{StaticResource IconClear}" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="24" Height="22" Margin="2,0,0,0"
                                        AutomationProperties.Name="合并断行"
                                        ToolTip="合并换行（修复 PDF 复制的断行）" Click="MergeLines_Click">
                                    <Path Width="11" Height="11" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="{StaticResource IconMergeLines}" />
                                </Button>

                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SourceLabel" Text="原文" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock x:Name="SourceKindLabel" FontSize="11" Margin="5,0,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="RetryButton" AutomationProperties.Name="重试翻译"
                                    Style="{StaticResource IconButton}" Width="24" Height="22"
                                    HorizontalAlignment="Right" ToolTip="重新翻译 (Ctrl+R)"
                                    Click="Retry_Click">
                                <Path Width="11" Height="11" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="{StaticResource IconRetry}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Segment 2: Language bar ── -->
                <Grid Margin="2,11,2,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SourceLangCombo" Grid.Column="0" Style="{StaticResource CompactComboBox}"
                              Width="128" ToolTip="原文语言"
                              SelectionChanged="Language_SelectionChanged" />
                    <Border Grid.Column="1" Height="1" Margin="12,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource BorderSubtleBrush}" />
                    <Button x:Name="SwapLangButton" Grid.Column="2" Style="{StaticResource IconButton}"
                            AutomationProperties.Name="交换语言方向"
                            Width="26" Height="26" ToolTip="交换语言方向" Click="SwapLangButton_Click">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Data="{StaticResource IconSwap}" />
                    </Button>
                    <Border Grid.Column="3" Height="1" Margin="12,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource BorderSubtleBrush}" />
                    <ComboBox x:Name="TargetLangCombo" Grid.Column="4" Style="{StaticResource CompactComboBox}"
                              Width="128" ToolTip="译文语言"
                              SelectionChanged="Language_SelectionChanged" />
                </Grid>

                <!-- ── Segment 3: Result card ── -->
                <Border Background="{DynamicResource SurfaceMutedBrush}"
                        CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Engine name as metadata text, not a coloured badge. -->
                                <TextBlock x:Name="EngineBadge" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Text="译文" />
                                <TextBlock x:Name="PhoneticText" FontSize="11.5" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           VerticalAlignment="Center" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" MaxWidth="240" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ResultSpeakBtn" AutomationProperties.Name="朗读译文"
                                        Style="{StaticResource IconButton}" Width="24" Height="22"
                                        ToolTip="朗读译文" Click="ResultSpeak_Click">
                                    <Path x:Name="ResultSpeakIcon" Width="11" Height="11" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="{StaticResource IconSpeaker}" />
                                </Button>
                                <Button x:Name="ResultCopyBtn" AutomationProperties.Name="复制译文" Style="{StaticResource IconButton}" Width="24" Height="22"
                                        ToolTip="复制译文" Click="ResultCopy_Click">
                                    <Path x:Name="ResultCopyIcon" Width="11" Height="11" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="{StaticResource IconCopy}" />
                                </Button>
                                <ToggleButton x:Name="StarToggle" Width="24" Height="22" Margin="2,0,0,0"
                                              AutomationProperties.Name="收藏到生词本"
                                              ToolTip="收藏到生词本" Click="StarToggle_Click">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Surface" Background="Transparent" CornerRadius="6">
                                                <Path x:Name="Glyph" Width="12" Height="12" Stretch="Uniform"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Data="{StaticResource IconStar}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Surface" Property="Background"
                                                            Value="{DynamicResource SurfaceHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Surface" Property="Background"
                                                            Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter TargetName="Glyph" Property="Fill"
                                                            Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <TextBox x:Name="TranslationTextBox" Style="{StaticResource FlatTextBox}"
                                     FontSize="15" TextWrapping="Wrap" IsReadOnly="True"
                                     MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                     local:Ui.Placeholder="译文将显示在这里…"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                            <RichTextBox x:Name="TranslationRichBox" Style="{StaticResource FlatRichTextBox}"
                                         MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                         Visibility="Collapsed" />
                            <!-- Skeleton shown while a request is in flight. -->
                            <StackPanel x:Name="ResultSkeleton" Margin="2,6,0,0"
                                        Visibility="Collapsed" IsHitTestVisible="False">
                                <Border Height="12" Width="230" HorizontalAlignment="Left"
                                        Background="{DynamicResource SurfacePressedBrush}" CornerRadius="6" />
                                <Border Height="12" Width="170" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Background="{DynamicResource SurfacePressedBrush}" CornerRadius="6" Opacity="0.75" />
                                <Border Height="12" Width="200" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Background="{DynamicResource SurfacePressedBrush}" CornerRadius="6" Opacity="0.5" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Explanation: hairline + text, same pattern as the workbench. -->
                <StackPanel x:Name="ExplanationBox" Margin="2,10,2,0" Visibility="Collapsed">
                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
                    <TextBlock x:Name="ExplanationText" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="19"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Protected Token Chips -->
                <ItemsControl x:Name="TermsList" Margin="0,9,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TokenChipButton}"
                                    Content="{Binding}"
                                    Click="TermChip_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Warning Box -->
                <Border x:Name="WarningBox" Margin="0,9,0,0" Padding="10,7" CornerRadius="7"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WarningText" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" />
                </Border>

                <!-- Footer Status Bar -->
                <Grid Margin="3,10,3,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="4"
                                Background="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" FontSize="11.5" VerticalAlignment="Center"
                                   Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    </StackPanel>
                    <TextBlock x:Name="RouteText" FontSize="11.5" VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
