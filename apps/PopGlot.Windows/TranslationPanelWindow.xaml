<Window x:Class="PopGlot.Windows.TranslationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" MinHeight="186" MaxHeight="690" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        KeyDown="Window_KeyDown" Opacity="0">
    <Window.Resources>
        <Style x:Key="PanelAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource CardBackground}" CornerRadius="14"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="6" Opacity="0.34" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryText}"
                               FontSize="13" VerticalAlignment="Center" Text="准备中" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PinButton" Style="{StaticResource PanelAction}"
                            Background="Transparent" BorderThickness="0" Padding="7,3"
                            Click="PinButton_Click" ToolTip="固定浮窗" Content="固定" />
                    <Button Style="{StaticResource PanelAction}" Margin="4,0,0,0"
                            Background="Transparent" BorderThickness="0" Padding="8,3"
                            Click="CloseButton_Click" ToolTip="关闭" Content="✕" />
                </StackPanel>
            </DockPanel>

            <ProgressBar Grid.Row="1" x:Name="Progress" Height="2" Margin="0,13,0,0"
                         IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource DividerBrush}" BorderThickness="0" />

            <Border Grid.Row="2" x:Name="SourceSurface" Margin="0,16,0,0" Padding="13,11"
                    Background="{DynamicResource InputBackground}" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="SourceLabel" Text="原文" FontSize="12"
                               Foreground="{DynamicResource TertiaryText}" />
                    <TextBlock x:Name="SourceText" Margin="0,5,0,0" MaxHeight="92"
                               Foreground="{DynamicResource SecondaryText}" FontSize="13"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Text="正在读取选区…" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="中文释义" FontSize="12" Foreground="{DynamicResource TertiaryText}" />
                <TextBlock x:Name="TranslationText" Margin="0,7,0,0"
                           Foreground="{DynamicResource PrimaryText}" FontSize="18"
                           LineHeight="28" TextWrapping="Wrap" Text="等待内容…" />
                <TextBlock x:Name="ExplanationText" Margin="0,11,0,0"
                           Foreground="{DynamicResource SecondaryText}" LineHeight="21"
                           TextWrapping="Wrap" Visibility="Collapsed" />
                <Border x:Name="TermsBorder" Margin="0,13,0,0" Padding="11,8"
                        CornerRadius="7" Background="{DynamicResource AccentMutedBrush}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TermsText" Foreground="{DynamicResource PrimaryText}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <DockPanel Grid.Row="4" Margin="0,20,0,0">
                <TextBlock x:Name="RouteText" DockPanel.Dock="Left"
                           Foreground="{DynamicResource TertiaryText}" FontSize="12"
                           VerticalAlignment="Center" Text="PopGlot" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RetryButton" Style="{StaticResource PanelAction}"
                            Margin="0,0,8,0" Click="RetryButton_Click" Content="重新翻译"
                            Visibility="Collapsed" />
                    <Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}"
                            Click="CopyButton_Click" Content="复制译文" IsEnabled="False" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
