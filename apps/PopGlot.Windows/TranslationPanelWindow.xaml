<Window x:Class="PopGlot.Windows.TranslationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540" MinHeight="220" MaxHeight="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        KeyDown="Window_KeyDown" Opacity="0">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBackground}" CornerRadius="12"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.38" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header with Language Selectors & Window Controls -->
            <DockPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" LastChildFill="True">
                <!-- Left: App Logo / Status -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="PopGlot" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource PrimaryText}" Margin="0,0,12,0" />

                    <!-- Source Lang -->
                    <ComboBox x:Name="SourceLangCombo" Style="{StaticResource LangCombo}" Width="85"
                              SelectionChanged="Language_SelectionChanged">
                        <ComboBoxItem Content="自动检测" Tag="auto" IsSelected="True" />
                        <ComboBoxItem Content="英语" Tag="en" />
                        <ComboBoxItem Content="中文" Tag="zh-CN" />
                        <ComboBoxItem Content="日语" Tag="ja" />
                        <ComboBoxItem Content="韩语" Tag="ko" />
                        <ComboBoxItem Content="法语" Tag="fr" />
                        <ComboBoxItem Content="德语" Tag="de" />
                        <ComboBoxItem Content="西班牙语" Tag="es" />
                        <ComboBoxItem Content="俄语" Tag="ru" />
                    </ComboBox>

                    <!-- Swap Lang -->
                    <Button x:Name="SwapLangButton" Style="{StaticResource IconButton}" Content="⇄"
                            ToolTip="切换语言" Click="SwapLangButton_Click" Margin="4,0" />

                    <!-- Target Lang -->
                    <ComboBox x:Name="TargetLangCombo" Style="{StaticResource LangCombo}" Width="85"
                              SelectionChanged="Language_SelectionChanged">
                        <ComboBoxItem Content="中文" Tag="zh-CN" IsSelected="True" />
                        <ComboBoxItem Content="英语" Tag="en" />
                        <ComboBoxItem Content="日语" Tag="ja" />
                        <ComboBoxItem Content="韩语" Tag="ko" />
                        <ComboBoxItem Content="法语" Tag="fr" />
                        <ComboBoxItem Content="德语" Tag="de" />
                        <ComboBoxItem Content="西班牙语" Tag="es" />
                        <ComboBoxItem Content="俄语" Tag="ru" />
                    </ComboBox>
                </StackPanel>

                <!-- Right: Window controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}"
                            Click="PinButton_Click" ToolTip="固定浮窗" Content="📌" Margin="0,0,4,0" />
                    <Button Style="{StaticResource IconButton}"
                            Click="CloseButton_Click" ToolTip="关闭 (Esc)" Content="✕" />
                </StackPanel>
            </DockPanel>

            <!-- Loading Progress bar -->
            <ProgressBar Grid.Row="1" x:Name="Progress" Height="2" Margin="0,10,0,0"
                         IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource DividerBrush}" BorderThickness="0" />

            <!-- 2. Source Input / Text Box -->
            <Border Grid.Row="2" x:Name="SourceSurface" Margin="0,12,0,0" Padding="10"
                    Background="{DynamicResource InputBackground}" CornerRadius="8"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock x:Name="SourceLabel" Text="原文" FontSize="11"
                                   Foreground="{DynamicResource TertiaryText}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SourceSpeakButton" Style="{StaticResource IconButton}" Content="🔊 朗读"
                                    ToolTip="朗读原文" Click="SourceSpeakButton_Click" Margin="0,0,4,0" />
                            <Button x:Name="SourceCopyButton" Style="{StaticResource IconButton}" Content="📋 复制"
                                    ToolTip="复制原文" Click="SourceCopyButton_Click" Margin="0,0,4,0" />
                            <Button x:Name="SourceClearButton" Style="{StaticResource IconButton}" Content="🗑️ 清空"
                                    ToolTip="清空原文" Click="SourceClearButton_Click" />
                        </StackPanel>
                    </DockPanel>

                    <TextBox Grid.Row="1" x:Name="SourceInputBox" Background="Transparent"
                             BorderThickness="0" Foreground="{DynamicResource PrimaryText}"
                             FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                             MaxHeight="120" VerticalScrollBarVisibility="Auto"
                             Text="正在读取选区…" KeyDown="SourceInputBox_KeyDown" />
                </Grid>
            </Border>

            <!-- 3. Result Section -->
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="12"
                    Background="{DynamicResource CardBackground}" CornerRadius="8"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ResultEngineBadge" Text="✨ 翻译结果" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="PhoneticText" FontSize="11" Foreground="{DynamicResource TertiaryText}"
                                       Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ResultSpeakButton" Style="{StaticResource IconButton}" Content="🔊 朗读"
                                    ToolTip="朗读译文" Click="ResultSpeakButton_Click" Margin="0,0,4,0" />
                            <Button x:Name="ResultCopyButton" Style="{StaticResource IconButton}" Content="📋 复制"
                                    ToolTip="复制译文" Click="CopyButton_Click" Margin="0,0,4,0" />
                            <Button x:Name="RetryButton" Style="{StaticResource IconButton}" Content="🔄 重试"
                                    ToolTip="重新翻译" Click="RetryButton_Click" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Main Translated Text -->
                    <TextBox x:Name="TranslationTextBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryText}" FontSize="15"
                             TextWrapping="Wrap" IsReadOnly="True" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" Text="等待内容…" />

                    <!-- Detailed Explanation / Terms if available -->
                    <TextBlock x:Name="ExplanationText" Margin="0,8,0,0" FontSize="12"
                               Foreground="{DynamicResource SecondaryText}" LineHeight="18"
                               TextWrapping="Wrap" Visibility="Collapsed" />

                    <Border x:Name="TermsBorder" Margin="0,8,0,0" Padding="8,6"
                            CornerRadius="6" Background="{DynamicResource AccentMutedBrush}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TermsText" Foreground="{DynamicResource PrimaryText}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Footer Status Bar -->
            <DockPanel Grid.Row="4" Margin="0,10,0,0">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left"
                           Foreground="{DynamicResource TertiaryText}" FontSize="11"
                           VerticalAlignment="Center" Text="准备就绪" />
                <TextBlock x:Name="RouteText" DockPanel.Dock="Right"
                           Foreground="{DynamicResource TertiaryText}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Text="" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
