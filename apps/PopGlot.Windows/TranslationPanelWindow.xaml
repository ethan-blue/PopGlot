<Window x:Class="PopGlot.Windows.TranslationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" MaxHeight="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#F2151C29" CornerRadius="18" BorderBrush="#3342576F" BorderThickness="1"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="7" Opacity="0.48" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border DockPanel.Dock="Left" Width="9" Height="9" CornerRadius="5" Background="#6EE7C7" Margin="0,0,10,0" />
                <TextBlock x:Name="StatusText" Foreground="#A8B4C5" VerticalAlignment="Center" Text="正在准备…" />
                <Button DockPanel.Dock="Right" Padding="7,2" Background="Transparent" Click="CloseButton_Click" Content="×" />
            </DockPanel>

            <TextBlock Grid.Row="1" x:Name="TranslationText" Margin="0,20,0,0"
                       Foreground="#F7F9FC" FontSize="17" LineHeight="26" TextWrapping="Wrap"
                       Text="正在分析选区…" />

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="说明" Foreground="#6EE7C7" FontWeight="SemiBold" />
                <TextBlock x:Name="ExplanationText" Margin="0,7,0,0" Foreground="#A8B4C5"
                           TextWrapping="Wrap" LineHeight="21" Text="当前不会发送截图。" />
                <Border x:Name="TermsBorder" Margin="0,14,0,0" Padding="12" CornerRadius="9" Background="#182234">
                    <TextBlock x:Name="TermsText" Foreground="#CBD5E1" FontFamily="Consolas" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <DockPanel Grid.Row="3" Margin="0,20,0,0">
                <TextBlock x:Name="RouteText" DockPanel.Dock="Left" Foreground="#728096" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Click="CopyButton_Click" Content="复制" />
                    <Button Background="#2C8E78" Click="CloseButton_Click" Content="完成" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
