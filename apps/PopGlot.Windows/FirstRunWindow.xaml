<Window x:Class="PopGlot.Windows.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        Title="首次配置 · PopGlot" Width="720" Height="560" MinWidth="640" MinHeight="520"
        Icon="/PopGlot;component/Assets/PopGlot-v5.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <TextBlock x:Name="StepIndicator" Margin="24,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Caption}"
                           AutomationProperties.Name="当前步骤" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}"
                            AutomationProperties.Name="关闭首次配置"
                            local:Ui.Icon="{StaticResource IconCaptionClose}"
                            ToolTip="关闭（保留默认设置）" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ==================== Step 1: welcome ==================== -->
            <StackPanel x:Name="WelcomeStep" Grid.Row="1" Margin="32,12,32,0">
                <TextBlock Text="欢迎使用 PopGlot" Style="{StaticResource PageTitle}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13.5"
                           Text="划词即译、截图识别、本地朗读。默认已经可以开箱即用——内置免费引擎不需要任何配置。" />
                <TextBlock Margin="0,18,0,6" Text="三个快捷键" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="划词翻译　Ctrl + Alt + W" FontSize="13" Margin="0,2" />
                        <TextBlock Text="截图翻译　Ctrl + Alt + Space" FontSize="13" Margin="0,2" />
                        <TextBlock Text="关闭浮窗　Esc" FontSize="13" Margin="0,2" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="下一步是隐私设置。全部按推荐值默认开启，你可以逐项关掉；之后随时能在「设置」里再改。" />
            </StackPanel>

            <!-- ==================== Step 2: privacy ==================== -->
            <StackPanel x:Name="PrivacyStep" Grid.Row="1" Margin="32,12,32,0" Visibility="Collapsed">
                <TextBlock Text="隐私与联网" Style="{StaticResource PageTitle}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,14" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="以下选择只影响这台机器。关闭任何一项都不会丢失已保存的数据。" />

                <Border Style="{StaticResource Card}" Padding="14,6">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsRow}" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="允许连接云端翻译服务" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="关掉后完全不出网，只使用本机模型（如 Ollama）" />
                            </StackPanel>
                            <ToggleButton x:Name="CloudToggle" Grid.Column="1" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                          AutomationProperties.Name="允许连接云端翻译服务" />
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                        <Grid Style="{StaticResource SettingsRow}" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="使用内置免费引擎" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="无需配置即可翻译；会把待译文本发送给你选中的公共服务" />
                            </StackPanel>
                            <ToggleButton x:Name="FreeEngineToggle" Grid.Column="1" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                          AutomationProperties.Name="使用内置免费引擎" />
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                        <Grid Style="{StaticResource SettingsRow}" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="保存翻译历史" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="历史与生词本只写在本机 %LOCALAPPDATA%\PopGlot" />
                            </StackPanel>
                            <ToggleButton x:Name="HistoryToggle" Grid.Column="1" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                          AutomationProperties.Name="保存翻译历史" />
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                        <Grid Style="{StaticResource SettingsRow}" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="登录后静默驻留托盘，随时可用" />
                            </StackPanel>
                            <ToggleButton x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                          AutomationProperties.Name="开机自动启动" />
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}" Margin="0,8" />

                        <Grid Style="{StaticResource SettingsRow}" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="允许上报诊断信息" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="崩溃时把脱敏后的诊断发到 GitHub Issues；默认关闭" />
                            </StackPanel>
                            <ToggleButton x:Name="DiagnosticsToggle" Grid.Column="1" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                          AutomationProperties.Name="允许上报诊断信息" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Step 3: done ==================== -->
            <StackPanel x:Name="DoneStep" Grid.Row="1" Margin="32,12,32,0" Visibility="Collapsed">
                <TextBlock Text="配置完成" Style="{StaticResource PageTitle}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="DoneSummary" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13.5" />
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="13.5"
                           Text="想要更稳定、更高质量的翻译，可以在「设置 → 服务」里填上自己的模型服务（OpenAI 兼容、DeepSeek、本地 Ollama 等）。不配置也完全能用。" />
                <Button x:Name="OpenServicesButton" Margin="0,16,0,0" HorizontalAlignment="Left"
                        Style="{StaticResource GhostButton}" Padding="12,6"
                        Content="打开设置 → 服务" Click="OpenServices_Click" />
            </StackPanel>

            <!-- ==================== Footer ==================== -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Padding="14,6"
                            Content="上一步" IsEnabled="False" Click="Back_Click" />
                    <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Padding="14,6"
                            Margin="8,0,0,0" Content="下一步" Click="Next_Click" />
                    <Button x:Name="FinishButton" Style="{StaticResource PrimaryButton}" Padding="14,6"
                            Margin="8,0,0,0" Content="开始使用" Visibility="Collapsed" Click="Finish_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
