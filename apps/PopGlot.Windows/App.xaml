<Application x:Class="PopGlot.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#0C111B" />
        <SolidColorBrush x:Key="CardBackground" Color="#151C29" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6EE7C7" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F5F7FA" />
        <SolidColorBrush x:Key="SecondaryText" Color="#9AA6B6" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#243044" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
