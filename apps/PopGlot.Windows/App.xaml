<Application x:Class="PopGlot.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Seed values only. ThemeService replaces every one of these on
                startup and whenever the theme changes; they exist so the
                designer and the very first layout pass have something to bind
                to instead of falling back to transparent.
            -->
            <SolidColorBrush x:Key="CanvasBrush" Color="#0A0B0F" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#0F1015" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#14161C" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#111318" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1B1E26" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#21242E" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#333B49" />
            <SolidColorBrush x:Key="InputBrush" Color="#0E1014" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2A303D" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#626C82" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4D9FFF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BABFF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#3D82E8" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#071224" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#152C4E" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#5E96E0" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1F55C7" />
            <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1A47A8" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF0F4" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A9B4" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A93A2" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#525A66" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF6B7D" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#401C25" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F2B95C" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#3D2D14" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#3DD68C" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#143826" />
            <SolidColorBrush x:Key="OverlayScrimBrush" Color="#C80A0B0F" />

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
