<Application x:Class="PopGlot.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Seed values only. ThemeService replaces every one of these on
                startup and whenever the theme changes; they exist so the
                designer and the very first layout pass have something to bind
                to instead of falling back to transparent.
            -->
            <SolidColorBrush x:Key="CanvasBrush" Color="#0B0E14" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#0F131B" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#151A23" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1B2130" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#232C3C" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#2B3547" />
            <SolidColorBrush x:Key="InputBrush" Color="#111722" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#222B39" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#334054" />
            <SolidColorBrush x:Key="AccentBrush" Color="#35D0A5" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#4FE0B8" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#23B48C" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#04211A" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#123328" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#1E6B55" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9EEF6" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98A5B8" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6A7688" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="#0B0E14" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF7A7A" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1D22" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F4B860" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2E1A" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#35D0A5" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#123328" />
            <SolidColorBrush x:Key="OverlayScrimBrush" Color="#B3070A10" />

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
