<Application x:Class="PopGlot.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Seed values only. ThemeService replaces every one of these on
                startup and whenever the theme changes; they exist so the
                designer and the very first layout pass have something to bind
                to instead of falling back to transparent.
            -->
            <SolidColorBrush x:Key="CanvasBrush" Color="#0E0F12" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#121419" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#191C22" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#15181E" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#20242C" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#222730" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#2A303B" />
            <SolidColorBrush x:Key="InputBrush" Color="#111318" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2A2F38" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#3B424F" />
            <SolidColorBrush x:Key="AccentBrush" Color="#8B8FF7" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#A0A3FF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#777BE3" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#101124" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#27294C" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#45497B" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F5" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8ADB7" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#747B87" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#555C67" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF7180" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#421D24" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F0B35A" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#3B2B15" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#45C18A" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#15392B" />
            <SolidColorBrush x:Key="OverlayScrimBrush" Color="#C80E0F12" />

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
