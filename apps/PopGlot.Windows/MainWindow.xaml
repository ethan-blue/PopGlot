<Window x:Class="PopGlot.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        xmlns:sections="clr-namespace:PopGlot.Windows.Sections"
        Title="PopGlot" Width="1120" Height="760" MinWidth="920" MinHeight="640"
        Icon="/PopGlot;component/Assets/PopGlot-v3.ico"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Sidebar: quiet navigation, no logo chrome ==================== -->
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,18,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,0,0,0">
                    <Image Width="22" Height="22" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/PopGlot;component/Assets/popglot-app-avatar-v3.png"
                           AutomationProperties.Name="PopGlot 图标" />
                    <TextBlock Text="PopGlot" FontSize="15" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <RadioButton x:Name="NavTranslate" Style="{StaticResource NavButton}"
                                 GroupName="Nav" IsChecked="True" Content="翻译"
                                 local:Ui.Icon="{StaticResource IconTranslate}"
                                 Checked="Nav_Checked" Tag="Translate" />
                    <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Content="资料库"
                                 local:Ui.Icon="{StaticResource IconLibrary}"
                                 Checked="Nav_Checked" Tag="Library" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Content ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom TitleBar Caption Controls -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMin}"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMax}"
                            AutomationProperties.Name="最大化"
                            ToolTip="最大化" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}"
                            AutomationProperties.Name="关闭到托盘"
                            local:Ui.Icon="{StaticResource IconCaptionClose}"
                            ToolTip="关闭到托盘" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!--
                Work surface: the two sections fill the height instead of
                growing an outer scroll, so the translate panes and the library
                list scroll inside their own constrained areas and the ListBox
                keeps virtualization. Width changes drive the compact breakpoint.
            -->
            <Grid Grid.Row="1" Margin="28,14,28,18" SizeChanged="ContentGrid_SizeChanged">
                <sections:TranslateSection x:Name="TranslateSection" />
                <sections:LibrarySection x:Name="LibrarySection" Visibility="Collapsed" />
            </Grid>

            <!-- ==================== Quiet status footer ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Padding="24,5">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusTextBlock" Margin="8,0,0,0" FontSize="11"
                                   VerticalAlignment="Center" MaxWidth="560"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="状态"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="就绪" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="EngineHealthButton" Style="{StaticResource GhostButton}"
                                VerticalAlignment="Center" Margin="0,0,8,0"
                                Padding="7,4" AutomationProperties.Name="翻译引擎状态"
                                ToolTip="翻译引擎连通性 · 点击重新检测"
                                Click="EngineHealthButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="EngineDot" Width="6" Height="6" CornerRadius="3"
                                        Background="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="EngineSummary" Margin="7,0,2,0" FontSize="11"
                                           VerticalAlignment="Center" MaxWidth="400"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Text="内置免费引擎" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}"
                                AutomationProperties.Name="打开设置"
                                Click="SettingsButton_Click" Padding="9,5" ToolTip="打开设置">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextTertiaryBrush}"
                                      Data="{StaticResource IconSettings}" VerticalAlignment="Center" />
                                <TextBlock Text="设置" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
