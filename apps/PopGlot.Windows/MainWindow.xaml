<Window x:Class="PopGlot.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PopGlot" Width="1040" Height="780" MinWidth="900" MinHeight="680"
        Background="{DynamicResource PageBackground}" Foreground="{DynamicResource PrimaryText}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="P" Foreground="{DynamicResource AccentTextBrush}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PopGlot" Margin="11,0,0,0" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TertiaryText}" FontSize="12"
                               Text="桌面划词、截图与 AI 翻译" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Nav Buttons -->
                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                    <Button x:Name="TranslateNavButton" Style="{StaticResource NavButton}"
                            Click="TranslateNavButton_Click" Content="📝  独立翻译" />
                    <Button x:Name="GeneralNavButton" Style="{StaticResource NavButton}"
                            Click="GeneralNavButton_Click" Content="⌨️  快捷操作" />
                    <Button x:Name="ProviderNavButton" Style="{StaticResource NavButton}"
                            Click="ProviderNavButton_Click" Content="🤖  翻译服务" />
                    <Button x:Name="OcrNavButton" Style="{StaticResource NavButton}"
                            Click="OcrNavButton_Click" Content="🔍  本地 OCR" />
                    <Button x:Name="PrivacyNavButton" Style="{StaticResource NavButton}"
                            Click="PrivacyNavButton_Click" Content="📜  历史记录" />
                </StackPanel>

                <!-- Shortcut Hint Card -->
                <Border Grid.Row="2" Padding="12" CornerRadius="9" Background="{DynamicResource ElevatedBackground}">
                    <StackPanel>
                        <TextBlock Text="随时唤起" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="ShortcutHintText" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,28,36,20">
                <Grid>
                    <!-- 1. Standalone Translate Panel -->
                    <StackPanel x:Name="TranslatePanel">
                        <TextBlock Text="独立翻译" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,20" Foreground="{DynamicResource SecondaryText}"
                                   Text="直接输入文字或粘贴内容进行即时翻译。" />

                        <Border Padding="20" CornerRadius="12" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <!-- Language Selectors -->
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="源语言：" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="StandaloneSourceLang" Width="95" Height="32" SelectedIndex="0">
                                            <ComboBoxItem Tag="auto">自动检测</ComboBoxItem>
                                            <ComboBoxItem Tag="en">英语</ComboBoxItem>
                                            <ComboBoxItem Tag="zh-CN">中文</ComboBoxItem>
                                            <ComboBoxItem Tag="ja">日语</ComboBoxItem>
                                            <ComboBoxItem Tag="ko">韩语</ComboBoxItem>
                                            <ComboBoxItem Tag="fr">法语</ComboBoxItem>
                                            <ComboBoxItem Tag="de">德语</ComboBoxItem>
                                            <ComboBoxItem Tag="es">西班牙语</ComboBoxItem>
                                            <ComboBoxItem Tag="ru">俄语</ComboBoxItem>
                                        </ComboBox>

                                        <Button x:Name="StandaloneSwapButton" Margin="8,0" Padding="8,4"
                                                Click="StandaloneSwapButton_Click" Content="⇄" ToolTip="切换语言" />

                                        <TextBlock Text="目标语言：" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="StandaloneTargetLang" Width="95" Height="32" SelectedIndex="0">
                                            <ComboBoxItem Tag="zh-CN">中文</ComboBoxItem>
                                            <ComboBoxItem Tag="en">英语</ComboBoxItem>
                                            <ComboBoxItem Tag="ja">日语</ComboBoxItem>
                                            <ComboBoxItem Tag="ko">韩语</ComboBoxItem>
                                            <ComboBoxItem Tag="fr">法语</ComboBoxItem>
                                            <ComboBoxItem Tag="de">德语</ComboBoxItem>
                                            <ComboBoxItem Tag="es">西班牙语</ComboBoxItem>
                                            <ComboBoxItem Tag="ru">俄语</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button x:Name="StandaloneTranslateButton" Style="{StaticResource PrimaryButton}"
                                                Click="StandaloneTranslateButton_Click" Content="翻译 (Enter)" Padding="16,6" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Input Box -->
                                <TextBox x:Name="StandaloneSourceInput" Height="110" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontSize="14" Padding="10"
                                         KeyDown="StandaloneSourceInput_KeyDown" />

                                <DockPanel Margin="0,8,0,16">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Margin="0,0,6,0" Padding="8,4" Click="StandaloneSourceSpeak_Click" Content="🔊 朗读" />
                                        <Button Margin="0,0,6,0" Padding="8,4" Click="StandaloneSourceCopy_Click" Content="📋 复制" />
                                        <Button Padding="8,4" Click="StandaloneSourceClear_Click" Content="🗑️ 清空" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Output Box -->
                                <TextBlock Text="翻译结果" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBox x:Name="StandaloneResultText" Height="140" AcceptsReturn="True"
                                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontSize="15" Padding="10" Background="{DynamicResource InputBackground}" />

                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock x:Name="StandaloneStatusText" Foreground="{DynamicResource SecondaryText}"
                                               FontSize="12" VerticalAlignment="Center" Text="就绪" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Margin="0,0,6,0" Padding="8,4" Click="StandaloneResultSpeak_Click" Content="🔊 朗读译文" />
                                        <Button Padding="12,4" Style="{StaticResource PrimaryButton}" Click="StandaloneResultCopy_Click" Content="📋 复制译文" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. Shortcuts & General Panel -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">
                        <TextBlock Text="快捷操作" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,20" Foreground="{DynamicResource SecondaryText}"
                                   Text="配置全局快捷键与软件外观。" />

                        <Border Padding="20" CornerRadius="12" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="全局快捷键" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,18" Foreground="{DynamicResource SecondaryText}"
                                           Text="按下快捷键即可在任何软件中唤起翻译。" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,20,16">
                                        <TextBlock Text="划词翻译" FontWeight="SemiBold" />
                                        <TextBlock Text="选中文字后按下快捷键" Foreground="{DynamicResource TertiaryText}" FontSize="12" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="SelectionShortcutComboBox" Height="36"
                                              DisplayMemberPath="DisplayName" />

                                    <StackPanel Grid.Row="1" Margin="0,0,20,16">
                                        <TextBlock Text="截图翻译" FontWeight="SemiBold" />
                                        <TextBlock Text="框选屏幕任意区域图文进行识别与翻译" Foreground="{DynamicResource TertiaryText}" FontSize="12" />
                                    </StackPanel>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ScreenshotShortcutComboBox" Height="36"
                                              DisplayMemberPath="DisplayName" />

                                    <StackPanel Grid.Row="2" Margin="0,0,20,0">
                                        <TextBlock Text="关闭浮窗" FontWeight="SemiBold" />
                                        <TextBlock Text="浮窗内始终支持 Esc 键快速关闭" Foreground="{DynamicResource TertiaryText}" FontSize="12" />
                                    </StackPanel>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CloseShortcutComboBox" Height="36"
                                              DisplayMemberPath="DisplayName" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="20" CornerRadius="12"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="外观主题" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"
                                               Text="跟随 Windows 系统配色，或固定浅色/深色模式。" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="ThemeComboBox" Height="36" SelectedIndex="0">
                                    <ComboBoxItem Tag="System">跟随系统</ComboBoxItem>
                                    <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                                    <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 3. Provider Panel -->
                    <StackPanel x:Name="ProviderPanel" Visibility="Collapsed">
                        <TextBlock Text="翻译服务" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,20" Foreground="{DynamicResource SecondaryText}"
                                   Text="支持 OpenAI、DeepSeek、Gemini、Claude、Ollama 等，无配置时自动使用免费内置服务。" />

                        <!-- Quick Presets -->
                        <Border Padding="16" CornerRadius="12" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="快速预设" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <Button Style="{StaticResource PresetButton}" Content="OpenAI (官方)" Click="PresetOpenAi_Click" />
                                    <Button Style="{StaticResource PresetButton}" Content="DeepSeek (官方)" Click="PresetDeepSeek_Click" />
                                    <Button Style="{StaticResource PresetButton}" Content="Google Gemini" Click="PresetGemini_Click" />
                                    <Button Style="{StaticResource PresetButton}" Content="Anthropic Claude" Click="PresetClaude_Click" />
                                    <Button Style="{StaticResource PresetButton}" Content="Ollama (本地免费)" Click="PresetOllama_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Padding="20" CornerRadius="12" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="服务与模型配置" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="提供商协议" Margin="0,14,0,6" />
                                <ComboBox x:Name="ProviderTypeComboBox" Height="36"
                                          SelectionChanged="ProviderTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="OpenAiCompatible">OpenAI-compatible (推荐)</ComboBoxItem>
                                    <ComboBoxItem Tag="OpenAiResponses">OpenAI · Responses API</ComboBoxItem>
                                    <ComboBoxItem Tag="AnthropicMessages">Anthropic · Claude</ComboBoxItem>
                                    <ComboBoxItem Tag="GeminiGenerateContent">Google · Gemini</ComboBoxItem>
                                </ComboBox>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="文本模型" Margin="0,0,0,6" />
                                        <TextBox x:Name="TextModelTextBox" Height="36" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="视觉模型 (可选)" Margin="0,0,0,6" />
                                        <TextBox x:Name="VisionModelTextBox" Height="36" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="API Key (密钥将安全保存在 Windows 凭据管理器)" Margin="0,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyPasswordBox" Height="36" />
                                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="12,0" Click="ClearApiKey_Click" Content="清除密钥" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <CheckBox x:Name="NetworkEnabledCheckBox" Content="启用大模型网络翻译" IsChecked="True" />
                                    <CheckBox x:Name="SafeDevModeCheckBox" Margin="22,0,0,0" IsChecked="False"
                                              Content="调试日志拦截" />
                                </StackPanel>

                                <Button x:Name="TestConnectionButton" Margin="0,16,0,0"
                                        HorizontalAlignment="Left" Click="TestConnectionButton_Click"
                                        Content="测试连接" Padding="14,6" />
                            </StackPanel>
                        </Border>

                        <Expander Margin="0,16,0,0" Header="高级参数设置 (Base URL / Endpoints / 自定义请求头)">
                            <Border Margin="0,10,0,0" Padding="20" CornerRadius="12"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="API Base URL" Margin="0,0,0,6" />
                                    <TextBox x:Name="BaseUrlTextBox" Height="36" />
                                    <CheckBox x:Name="AllowInsecureTlsCheckBox" Margin="0,10,0,0" IsChecked="False"
                                              Content="允许无效/自签名 TLS 证书（仅自建或 IP 直连中转站使用）" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="文本 endpoint" Margin="0,0,0,6" />
                                            <TextBox x:Name="TextEndpointTextBox" Height="36" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="视觉 endpoint" Margin="0,0,0,6" />
                                            <TextBox x:Name="VisionEndpointTextBox" Height="36" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="自定义请求头（每行 Header: Value）" Margin="0,0,0,6" />
                                            <TextBox x:Name="ExtraHeadersTextBox" Height="68" AcceptsReturn="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Anthropic Version" Margin="0,0,0,6" />
                                            <TextBox x:Name="AnthropicVersionTextBox" Height="36" />
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <CheckBox x:Name="SupportsTextCheckBox" Content="支持文本" IsChecked="True" />
                                                <CheckBox x:Name="SupportsVisionCheckBox" Margin="18,0,0,0"
                                                          Content="支持图片" IsChecked="True" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <!-- 4. OCR Panel -->
                    <StackPanel x:Name="OcrPanel" Visibility="Collapsed">
                        <TextBlock Text="本地 OCR" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,20" Foreground="{DynamicResource SecondaryText}"
                                   Text="使用 Windows 10/11 内置的高性能离线 OCR 引擎，本地识别，保护隐私。" />

                        <Border Padding="20" CornerRadius="12" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Windows Native OCR 状态" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="OcrStatusText" Margin="0,8,0,16" Foreground="{DynamicResource SecondaryText}"
                                           Text="正在检测系统 OCR 语言包…" />

                                <TextBlock Text="已安装的 OCR 识别语言：" Margin="0,0,0,8" />
                                <ListBox x:Name="OcrLanguagesListBox" Height="140" Margin="0,0,0,16"
                                         Background="{DynamicResource InputBackground}" />

                                <TextBlock Text="截图翻译模式" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ComboBox x:Name="ModeComboBox" Height="36" SelectedIndex="0">
                                    <ComboBoxItem Tag="Auto">智能自动 (优先本地 OCR，排版复杂时走视觉模型)</ComboBoxItem>
                                    <ComboBoxItem Tag="LocalOcr">纯本地 OCR + 文本翻译 (最快、最省 Token)</ComboBoxItem>
                                    <ComboBoxItem Tag="VisionDirect">视觉模型直接翻译 (端到端多模态)</ComboBoxItem>
                                </ComboBox>

                                <CheckBox x:Name="AllowImageUploadCheckBox" Margin="0,14,0,0" IsChecked="True"
                                          Content="允许截图在多模态模式下上传至配置的模型服务" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5. History Panel -->
                    <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                        <TextBlock Text="历史记录" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,20" Foreground="{DynamicResource SecondaryText}"
                                   Text="本地保存翻译历史记录，便于查阅和复用。" />

                        <Border Padding="20" CornerRadius="12" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="HistoryEnabledCheckBox" FontSize="15"
                                          Content="保存本地翻译历史" IsChecked="True" />
                                <TextBlock Margin="24,6,0,16" Foreground="{DynamicResource SecondaryText}"
                                           Text="最多 100 条、保留 90 天，所有数据仅存储在本地机器。" />

                                <DockPanel Margin="0,0,0,12">
                                    <TextBox x:Name="HistorySearchBox" Height="34" Width="260" DockPanel.Dock="Left"
                                             Padding="8,4" TextChanged="HistorySearchBox_TextChanged" />
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="12,4"
                                            Click="ClearHistory_Click" Content="清空历史" />
                                </DockPanel>

                                <ListBox x:Name="HistoryListBox" Height="320"
                                         Background="{DynamicResource InputBackground}"
                                         SelectionChanged="HistoryListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding SourceKind}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding CreatedAtText}" Foreground="{DynamicResource TertiaryText}"
                                                                   DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" />
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding SourceText}" Foreground="{DynamicResource PrimaryText}"
                                                               Margin="0,4,0,2" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="2" Text="{Binding TranslatedText}" Foreground="{DynamicResource SecondaryText}"
                                                               TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Bottom Save Bar -->
            <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="36,14">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left"
                               Foreground="{DynamicResource SecondaryText}" FontSize="12"
                               VerticalAlignment="Center" Text="就绪" />
                    <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Padding="20,7" Click="SaveButton_Click" Content="保存更改" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
