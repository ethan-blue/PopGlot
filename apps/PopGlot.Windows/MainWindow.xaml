<Window x:Class="PopGlot.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PopGlot" Width="980" Height="760" MinWidth="860" MinHeight="650"
        Background="{DynamicResource PageBackground}" Foreground="{DynamicResource PrimaryText}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="P" Foreground="{DynamicResource AccentTextBrush}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PopGlot" Margin="11,0,0,0" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TertiaryText}"
                               Text="不离开当前窗口，也能看懂。" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,30,0,0">
                    <Button x:Name="GeneralNavButton" Style="{StaticResource NavButton}"
                            Click="GeneralNavButton_Click" Content="快捷操作" />
                    <Button x:Name="ProviderNavButton" Style="{StaticResource NavButton}"
                            Click="ProviderNavButton_Click" Content="翻译服务" />
                    <Button x:Name="PrivacyNavButton" Style="{StaticResource NavButton}"
                            Click="PrivacyNavButton_Click" Content="隐私与历史" />
                </StackPanel>

                <Border Grid.Row="3" Padding="12" CornerRadius="9" Background="{DynamicResource ElevatedBackground}">
                    <StackPanel>
                        <TextBlock Text="随时唤起" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="ShortcutHintText" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="42,34,42,20">
                <Grid>
                    <StackPanel x:Name="GeneralPanel">
                        <TextBlock Text="快捷操作" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,26" Foreground="{DynamicResource SecondaryText}"
                                   Text="三种动作彼此独立，选中内容后无需切换应用。" />

                        <Border Padding="22" CornerRadius="12" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="全局快捷键" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,20" Foreground="{DynamicResource SecondaryText}"
                                           Text="划词通过短暂的复制事务读取选区，并立即恢复原剪贴板。" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,20,18">
                                        <TextBlock Text="翻译选中文字" FontWeight="SemiBold" />
                                        <TextBlock Text="选中文字后按下" Foreground="{DynamicResource TertiaryText}" FontSize="12" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="SelectionShortcutComboBox" Height="38"
                                              DisplayMemberPath="DisplayName" />
                                    <StackPanel Grid.Row="1" Margin="0,0,20,18">
                                        <TextBlock Text="截图翻译" FontWeight="SemiBold" />
                                        <TextBlock Text="框选屏幕上的图文内容" Foreground="{DynamicResource TertiaryText}" FontSize="12" />
                                    </StackPanel>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ScreenshotShortcutComboBox" Height="38"
                                              DisplayMemberPath="DisplayName" />
                                    <StackPanel Grid.Row="2" Margin="0,0,20,0">
                                        <TextBlock Text="关闭翻译浮窗" FontWeight="SemiBold" />
                                        <TextBlock Text="浮窗内也始终支持 Esc" Foreground="{DynamicResource TertiaryText}" FontSize="12" />
                                    </StackPanel>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CloseShortcutComboBox" Height="38"
                                              DisplayMemberPath="DisplayName" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="22" CornerRadius="12"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="外观" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SecondaryText}"
                                               Text="跟随 Windows，或固定浅色/深色。" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="ThemeComboBox" Height="38" SelectedIndex="0">
                                    <ComboBoxItem Tag="System">跟随系统</ComboBoxItem>
                                    <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                                    <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ProviderPanel" Visibility="Collapsed">
                        <TextBlock Text="翻译服务" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,26" Foreground="{DynamicResource SecondaryText}"
                                   Text="先完成常用项；兼容 endpoint 与请求头收纳在高级设置中。" />

                        <Border Padding="22" CornerRadius="12" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="服务与模型" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="提供商" Margin="0,18,0,6" />
                                <ComboBox x:Name="ProviderTypeComboBox" Height="38"
                                          SelectionChanged="ProviderTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="OpenAiCompatible">OpenAI-compatible</ComboBoxItem>
                                    <ComboBoxItem Tag="OpenAiResponses">OpenAI · Responses API</ComboBoxItem>
                                    <ComboBoxItem Tag="AnthropicMessages">Anthropic · Claude</ComboBoxItem>
                                    <ComboBoxItem Tag="GeminiGenerateContent">Google · Gemini</ComboBoxItem>
                                </ComboBox>
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="文本模型" Margin="0,0,0,6" />
                                        <TextBox x:Name="TextModelTextBox" Height="38" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="视觉模型" Margin="0,0,0,6" />
                                        <TextBox x:Name="VisionModelTextBox" Height="38" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="API Key" Margin="0,15,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyPasswordBox" Height="38" />
                                    <Button Grid.Column="1" Margin="10,0,0,0" Click="ClearApiKey_Click" Content="清除" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <CheckBox x:Name="NetworkEnabledCheckBox" Content="允许模型网络请求" />
                                    <CheckBox x:Name="SafeDevModeCheckBox" Margin="22,0,0,0" IsChecked="True"
                                              Content="安全开发模式" />
                                </StackPanel>
                                <Button x:Name="TestConnectionButton" Margin="0,17,0,0"
                                        HorizontalAlignment="Left" Click="TestConnectionButton_Click"
                                        Content="测试连接（仅发送内置文本）" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="22" CornerRadius="12"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="图片翻译路线" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,16" Foreground="{DynamicResource SecondaryText}"
                                           Text="本地 OCR 不上传图片；视觉直译必须获得截图上传授权。" />
                                <ComboBox x:Name="ModeComboBox" Height="38" SelectedIndex="0">
                                    <ComboBoxItem Tag="Auto">自动选择并解释原因</ComboBoxItem>
                                    <ComboBoxItem Tag="LocalOcr">仅本地 OCR + 文本模型</ComboBoxItem>
                                    <ComboBoxItem Tag="VisionDirect">视觉模型直接翻译</ComboBoxItem>
                                </ComboBox>
                                <CheckBox x:Name="AllowImageUploadCheckBox" Margin="0,14,0,0"
                                          Content="允许自动/视觉模式上传所框选的截图" />
                            </StackPanel>
                        </Border>

                        <Expander Margin="0,16,0,0" Header="兼容性与高级设置">
                            <Border Margin="0,10,0,0" Padding="22" CornerRadius="12"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="API Base URL" Margin="0,0,0,6" />
                                    <TextBox x:Name="BaseUrlTextBox" Height="38" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="文本 endpoint" Margin="0,0,0,6" />
                                            <TextBox x:Name="TextEndpointTextBox" Height="38" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="视觉 endpoint" Margin="0,0,0,6" />
                                            <TextBox x:Name="VisionEndpointTextBox" Height="38" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="自定义请求头（每行 Header: Value）" Margin="0,0,0,6" />
                                            <TextBox x:Name="ExtraHeadersTextBox" Height="72" AcceptsReturn="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Anthropic Version" Margin="0,0,0,6" />
                                            <TextBox x:Name="AnthropicVersionTextBox" Height="38" />
                                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                <CheckBox x:Name="SupportsTextCheckBox" Content="支持文本" IsChecked="True" />
                                                <CheckBox x:Name="SupportsVisionCheckBox" Margin="18,0,0,0"
                                                          Content="支持图片" IsChecked="True" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                        <TextBlock Text="隐私与历史" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,26" Foreground="{DynamicResource SecondaryText}"
                                   Text="历史默认关闭，只保存在本机；疑似密钥和过大文本不会记录。" />
                        <Border Padding="22" CornerRadius="12" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="HistoryEnabledCheckBox" FontSize="16"
                                          Content="保存本地翻译历史" />
                                <TextBlock Margin="24,7,0,0" Foreground="{DynamicResource SecondaryText}"
                                           Text="最多 100 条、保留 90 天、文件上限 2 MiB；截图本身永不入库。" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0" Padding="22" CornerRadius="12"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="最近记录" FontSize="17" FontWeight="SemiBold" />
                                    <Button DockPanel.Dock="Right" Click="ClearHistoryButton_Click" Content="清除全部" />
                                </DockPanel>
                                <TextBlock x:Name="HistoryEmptyText" Margin="0,20,0,0"
                                           Foreground="{DynamicResource TertiaryText}"
                                           Text="还没有本地历史。开启后，合规的小型文本翻译会出现在这里。" />
                                <ListBox x:Name="HistoryListBox" Margin="0,14,0,0" MaxHeight="320"
                                         Background="Transparent" BorderThickness="0" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0" Padding="16" CornerRadius="10"
                                Background="{DynamicResource ElevatedBackground}">
                            <TextBlock Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                                       Text="跨应用划词依赖当前应用的复制能力。对于禁止复制、密码框、管理员隔离窗口或未暴露标准文本选择的界面，PopGlot 会明确失败，不会绕过系统安全边界。真正的全局 hover 取词需要 UI Automation 或 OCR，并不能覆盖所有软件。" />
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1" Padding="42,16" Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left"
                               Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,20,0" Text="设置就绪" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Click="SaveButton_Click" Content="保存更改" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
