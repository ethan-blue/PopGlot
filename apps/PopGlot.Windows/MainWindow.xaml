<Window x:Class="PopGlot.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        xmlns:sections="clr-namespace:PopGlot.Windows.Sections"
        Title="PopGlot" Width="1120" Height="760" MinWidth="920" MinHeight="640"
        Icon="/PopGlot;component/Assets/PopGlot-v3.ico"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Sidebar: compact workstation navigation ==================== -->
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="10,0,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand header aligned with window caption height -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Image Width="20" Height="20" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/PopGlot;component/Assets/popglot-app-avatar-v3.png"
                           AutomationProperties.Name="PopGlot 图标" />
                    <TextBlock Text="PopGlot" Style="{StaticResource PageTitle}" FontSize="15"
                               FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation section with structured group header -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="工作台" Style="{StaticResource Metadata}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11" Margin="10,0,0,8" />
                    <RadioButton x:Name="NavTranslate" Style="{StaticResource NavButton}"
                                 GroupName="Nav" IsChecked="True" Content="翻译"
                                 local:Ui.Icon="{StaticResource IconTranslate}"
                                 Checked="Nav_Checked" Tag="Translate" />
                    <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Content="资料库"
                                 local:Ui.Icon="{StaticResource IconLibrary}"
                                 Checked="Nav_Checked" Tag="Library" />
                </StackPanel>

                <!-- Sidebar bottom settings entry -->
                <Button x:Name="NavSettingsButton" Grid.Row="2"
                        Style="{StaticResource NavActionButton}"
                        Content="设置" Margin="0,8,0,0"
                        local:Ui.Icon="{StaticResource IconSettings}"
                        AutomationProperties.Name="打开设置"
                        ToolTip="设置（引擎、快捷键、隐私）"
                        Click="NavSettingsButton_Click" />
            </Grid>
        </Border>

        <!-- ==================== Content Work Surface ==================== -->
        <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom TitleBar Caption Controls -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMin}"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMax}"
                            AutomationProperties.Name="最大化"
                            ToolTip="最大化" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}"
                            AutomationProperties.Name="关闭到托盘"
                            local:Ui.Icon="{StaticResource IconCaptionClose}"
                            ToolTip="关闭到托盘" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!--
                High-density workstation surface: tight margins maximize editor
                and reader area, avoiding floating cards or landing-page padding.
            -->
            <Grid Grid.Row="1" Margin="14,0,14,10" SizeChanged="ContentGrid_SizeChanged">
                <sections:TranslateSection x:Name="TranslateSection" />
                <sections:LibrarySection x:Name="LibrarySection" Visibility="Collapsed" />
            </Grid>

            <!-- ==================== Status Footer ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Padding="14,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="3.5"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusTextBlock" Margin="8,0,0,0"
                                   Style="{StaticResource Metadata}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="380"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="状态"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="就绪" />
                    </StackPanel>

                    <Button x:Name="EngineHealthButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                            VerticalAlignment="Center"
                            Padding="8,3" AutomationProperties.Name="翻译引擎快速切换"
                            ToolTip="快速切换文字与图片引擎"
                            Click="EngineHealthButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="EngineDot" Width="7" Height="7" CornerRadius="3.5"
                                    Background="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EngineSummary" Margin="6,0,4,0"
                                       Style="{StaticResource Metadata}"
                                       VerticalAlignment="Center" MaxWidth="320"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="内置免费引擎" />
                            <Path Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{DynamicResource TextTertiaryBrush}" Data="{StaticResource IconChevronDown}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
