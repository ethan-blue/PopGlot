<Window x:Class="PopGlot.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopGlot.Windows"
        Title="PopGlot" Width="1120" Height="820" MinWidth="960" MinHeight="680"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Geometry x:Key="IconTranslate">M3,5 H21 V17 H9 L4,21 V17 H3 Z M7,8 H12 V9.5 H10.6 V13 H9.2 V9.5 H7 Z M13.5,9 H18.5 V10.2 H13.5 Z M14.6,11 H17.4 L16,14.5 Z</Geometry>
        <Geometry x:Key="IconKeyboard">M2,6 H22 V18 H2 Z M4,8 H6 V10 H4 Z M8,8 H10 V10 H8 Z M12,8 H14 V10 H12 Z M16,8 H18 V10 H16 Z M4,12 H6 V14 H4 Z M8,12 H16 V14 H8 Z M18,12 H20 V14 H18 Z</Geometry>
        <Geometry x:Key="IconProvider">M6,19 H17 A4.5,4.5 0 0 0 17.6,10.1 A6,6 0 0 0 6,10 A4.5,4.5 0 0 0 6,19 Z M8,13 H16 V14.4 H8 Z</Geometry>
        <Geometry x:Key="IconCapture">M3,7 H7 L9,5 H15 L17,7 H21 V20 H3 Z M12,17.5 A3.6,3.6 0 1 0 12,10.3 A3.6,3.6 0 0 0 12,17.5 Z</Geometry>
        <Geometry x:Key="IconHistory">M12,3 A9,9 0 1 0 21,12 H19 A7,7 0 1 1 12,5 V8 L16.5,4.5 L12,1 Z M11,7 H12.8 V12.2 H16.5 V14 H11 Z</Geometry>
        <Geometry x:Key="IconLibrary">M4,4 H9 A3,3 0 0 1 12,5 A3,3 0 0 1 15,4 H20 V18 H15 A3,3 0 0 0 12,19 A3,3 0 0 0 9,18 H4 Z M12,5 V19</Geometry>

        <!-- Left column of a settings row: title plus explanation. -->
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3,20,0" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </Window.Resources>

        <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Sidebar ==================== -->
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,22,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="6,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="P" Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="19" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PopGlot" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="桌面翻译助手" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,26,0,0">
                    <RadioButton x:Name="NavTranslate" Style="{StaticResource NavButton}"
                                 GroupName="Nav" IsChecked="True" Content="快速翻译"
                                 local:Ui.Icon="{StaticResource IconTranslate}"
                                 Checked="Nav_Checked" Tag="Translate" />
                    <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Content="资料库"
                                 local:Ui.Icon="{StaticResource IconLibrary}"
                                 Checked="Nav_Checked" Tag="Library" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Content="通用"
                                 local:Ui.Icon="{StaticResource IconSettings}"
                                 Checked="Nav_Checked" Tag="General" />
                    <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Content="快捷键"
                                 local:Ui.Icon="{StaticResource IconKeyboard}"
                                 Checked="Nav_Checked" Tag="Shortcuts" />
                    <RadioButton x:Name="NavProvider" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Content="服务"
                                 local:Ui.Icon="{StaticResource IconProvider}"
                                 Checked="Nav_Checked" Tag="Provider" />
                    <RadioButton x:Name="NavCapture" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Content="OCR 与隐私"
                                 local:Ui.Icon="{StaticResource IconCapture}"
                                 Checked="Nav_Checked" Tag="Capture" />
                    <RadioButton x:Name="NavData" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Content="数据与高级"
                                 local:Ui.Icon="{StaticResource IconHistory}"
                                 Checked="Nav_Checked" Tag="Data" />
                </StackPanel>

                <!-- Live picture of what is actually configured. -->
                <Border Grid.Row="2" Style="{StaticResource InlineCard}" Padding="13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border x:Name="EngineDot" Width="7" Height="7" CornerRadius="4"
                                    Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EngineSummary" Margin="8,0,0,0" FontSize="12"
                                       FontWeight="SemiBold" Text="内置免费引擎" />
                        </StackPanel>
                        <TextBlock x:Name="ShortcutHintText" FontSize="11.5" LineHeight="19"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== Content ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom TitleBar Caption Controls -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMin}"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeBtn" Style="{StaticResource CaptionButton}"
                            local:Ui.Icon="{StaticResource IconCaptionMax}"
                            AutomationProperties.Name="最大化"
                            ToolTip="最大化" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}"
                            AutomationProperties.Name="关闭窗口"
                            ToolTip="关闭" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="34,10,30,24">
                <Grid>

                    <!-- ========== 1. Quick translate ========== -->
                    <StackPanel x:Name="TranslateSection">
                        <TextBlock Text="快速翻译" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="直接输入或粘贴内容立即翻译。划词、截图与查词共享同一会话与隐私策略。" />

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="TranslateSourceLang" Width="150" />
                                        <Button x:Name="TranslateSwapButton" Style="{StaticResource IconButton}"
                                                Margin="8,0" ToolTip="交换语言方向"
                                                AutomationProperties.Name="交换语言方向"
                                                Click="TranslateSwap_Click">
                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                  Data="{StaticResource IconSwap}" />
                                        </Button>
                                        <ComboBox x:Name="TranslateTargetLang" Width="150" />
                                    </StackPanel>
                                    <Button x:Name="TranslateButton" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Right" Padding="22,9"
                                            Content="翻译  ·  Enter" Click="Translate_Click" />
                                </Grid>

                                <ProgressBar x:Name="TranslateProgress" Height="2" IsIndeterminate="True"
                                             Visibility="Collapsed" Margin="0,0,0,8" />

                                <TextBox x:Name="TranslateInput" Height="132" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontSize="14"
                                         local:Ui.Placeholder="输入或粘贴要翻译的内容，Enter 翻译，Shift+Enter 换行"
                                         TextChanged="TranslateInput_TextChanged"
                                         KeyDown="TranslateInput_KeyDown" />

                                <Grid Margin="0,8,0,16">
                                    <TextBlock x:Name="TranslateCounter" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Text="0 字符" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="TranslateSourceSpeakBtn" Style="{StaticResource GhostButton}"
                                                Content="朗读" Click="TranslateSourceSpeak_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="复制"
                                                Click="TranslateSourceCopy_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="清空"
                                                Click="TranslateClear_Click" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="翻译结果" Style="{StaticResource SectionTitle}" />
                                        <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0"
                                                Padding="9,3"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource AccentBorderBrush}">
                                            <TextBlock x:Name="TranslateEngineBadge" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="等待输入" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="TranslateResultSpeakBtn" Style="{StaticResource GhostButton}"
                                                Content="朗读译文" Click="TranslateResultSpeak_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="复制译文"
                                                Click="TranslateResultCopy_Click" />
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="TranslateResult" Height="164" AcceptsReturn="True"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontSize="15"
                                         local:Ui.Placeholder="译文将显示在这里…" />

                                <Border x:Name="TranslateExplanationBox" Margin="0,10,0,0" Padding="12,10" CornerRadius="8"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="TranslateExplanation" FontSize="12.5"
                                               LineHeight="20" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>

                                <TextBlock x:Name="TranslateStatus" Margin="2,10,0,0"
                                           Style="{StaticResource Caption}" Text="就绪" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 2. Library: history + vocabulary ========== -->
                    <StackPanel x:Name="LibrarySection" Visibility="Collapsed">
                        <TextBlock Text="资料库" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="历史与生词保存在本机。疑似密钥、过大内容与截图位图不会写入。" />

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="翻译历史" Style="{StaticResource SectionTitle}" />
                                    <Button Grid.Column="1" HorizontalAlignment="Right" Content="清空全部历史"
                                            Style="{StaticResource DangerButton}" Click="ClearHistory_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="HistorySearchBox" Height="36"
                                             local:Ui.Placeholder="搜索原文或译文…"
                                             TextChanged="HistorySearch_TextChanged" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="导出 CSV"
                                                Click="ExportHistoryCsv_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="导出 Markdown"
                                                Margin="6,0,0,0" Click="ExportHistoryMarkdown_Click" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource InputBrush}" CornerRadius="10"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Padding="6" MinHeight="220">
                                    <Grid>
                                        <StackPanel x:Name="HistoryEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Margin="32" Visibility="Collapsed">
                                            <TextBlock Text="暂无历史记录" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="在任意应用中使用划词/截图快捷键，或在此输入翻译，记录将自动保存在本机。"
                                                       Style="{StaticResource Caption}" MaxWidth="400"
                                                       TextAlignment="Center" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <ListBox x:Name="HistoryListBox" MaxHeight="360"
                                                 MouseDoubleClick="HistoryList_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Style="{StaticResource StatusPill}"
                                                                        Padding="7,2"
                                                                        Background="{DynamicResource AccentSoftBrush}"
                                                                        BorderBrush="{DynamicResource AccentBorderBrush}">
                                                                    <TextBlock Text="{Binding Kind}" FontSize="10.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AccentBrush}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding LanguagePair}" FontSize="11"
                                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Timestamp}" FontSize="11"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Text="{Binding Source}"
                                                                   Margin="0,7,0,3" TextWrapping="Wrap"
                                                                   MaxHeight="38" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="12.5" />
                                                        <TextBlock Grid.Row="2" Text="{Binding Translation}"
                                                                   TextWrapping="Wrap" MaxHeight="46"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="13.5" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <TextBlock x:Name="HistoryCountText" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GhostButton}" Content="删除选中 (Del)"
                                                Click="DeleteHistoryEntry_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="复制译文"
                                                Click="CopyHistoryTranslation_Click" />
                                        <Button Content="载入到翻译页" Margin="6,0,0,0"
                                                Click="LoadHistoryEntry_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="生词本" Style="{StaticResource SectionTitle}" />
                                    <Button HorizontalAlignment="Right" Content="导出 Anki (.tsv)"
                                            Style="{StaticResource GhostButton}" Click="ExportAnki_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="VocabularySearchBox" Height="36"
                                             local:Ui.Placeholder="搜索生词或译文…"
                                             TextChanged="VocabularySearch_TextChanged" />
                                    <Button Grid.Column="1" Margin="10,0,0,0" Content="导出 CSV"
                                            Style="{StaticResource GhostButton}" Click="ExportCsv_Click" />
                                </Grid>

                                <Border Background="{DynamicResource InputBrush}" CornerRadius="10"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Padding="6" MinHeight="220">
                                    <Grid>
                                        <StackPanel x:Name="VocabularyEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Margin="32" Visibility="Collapsed">
                                            <TextBlock Text="生词本还是空的" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="在浮窗或查词栏中点击 ★ 即可将单词/句子加入生词本。"
                                                       Style="{StaticResource Caption}" MaxWidth="400"
                                                       TextAlignment="Center" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <ListBox x:Name="VocabularyListBox" MaxHeight="360"
                                                 MouseDoubleClick="VocabularyList_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,3">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Source}" FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding PhoneticDisplay}" FontSize="11"
                                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Timestamp}" FontSize="11"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Text="{Binding Translation}"
                                                                   Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="46"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="13" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <TextBlock x:Name="VocabularyCountText" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GhostButton}" Content="朗读发音"
                                                Click="SpeakVocabulary_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="导出 Markdown"
                                                Click="ExportMarkdown_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="删除选中"
                                                Margin="6,0,0,0" Click="DeleteVocabulary_Click" />
                                        <Button Content="载入到翻译页" Margin="6,0,0,0"
                                                Click="LoadVocabulary_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 3. General ========== -->
                    <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                        <TextBlock Text="通用" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="浮窗行为、主题与启动方式。" />

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="浮窗行为" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,16" />

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="点击别处自动关闭浮窗" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="关闭后浮窗会一直停留，直到手动关闭" />
                                    </StackPanel>
                                    <ToggleButton x:Name="CloseOnFocusLossToggle"
                                                  AutomationProperties.Name="点击别处自动关闭浮窗" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="翻译完成后自动复制译文" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="译文会写入剪贴板，方便直接粘贴" />
                                    </StackPanel>
                                    <ToggleButton x:Name="AutoCopyToggle"
                                                  AutomationProperties.Name="翻译完成后自动复制译文" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="外观与启动" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,16" />

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="主题" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="跟随 Windows 系统配色，或固定浅色 / 深色" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeComboBox" Grid.Column="1" VerticalAlignment="Top"
                                              SelectionChanged="ThemeComboBox_SelectionChanged">
                                        <ComboBoxItem Tag="System">跟随系统</ComboBoxItem>
                                        <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                                        <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="登录 Windows 后自动在托盘常驻" />
                                    </StackPanel>
                                    <ToggleButton x:Name="StartWithWindowsToggle"
                                                  AutomationProperties.Name="开机自动启动" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 4. Shortcuts ========== -->
                    <StackPanel x:Name="ShortcutsSection" Visibility="Collapsed">
                        <TextBlock Text="快捷键" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="点击快捷键按钮后直接按下想要的组合键。组合必须包含 Ctrl、Alt 或 Win；重复组合在保存前会被拒绝。" />

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,16" />

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="划词翻译" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="在任意应用中选中文字后按下，读取选区并翻译" />
                                    </StackPanel>
                                    <local:HotkeyRecorder x:Name="SelectionHotkeyRecorder" Grid.Column="1"
                                                          Height="38" VerticalAlignment="Top" />
                                </Grid>

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="截图翻译" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="框选屏幕任意区域，识别其中文字并翻译" />
                                    </StackPanel>
                                    <local:HotkeyRecorder x:Name="ScreenshotHotkeyRecorder" Grid.Column="1"
                                                          Height="38" VerticalAlignment="Top" />
                                </Grid>

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="关闭浮窗" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="浮窗内始终可以直接按 Esc 关闭" />
                                    </StackPanel>
                                    <local:HotkeyRecorder x:Name="CloseHotkeyRecorder" Grid.Column="1"
                                                          Height="38" VerticalAlignment="Top" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="打开主窗口" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="随时从任何应用呼出 PopGlot 主窗口" />
                                    </StackPanel>
                                    <local:HotkeyRecorder x:Name="ShowWindowHotkeyRecorder" Grid.Column="1"
                                                          Height="38" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 5. Services (profiles) ========== -->
                    <StackPanel x:Name="ProviderSection" Visibility="Collapsed">
                        <TextBlock Text="服务" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="服务列表 → 添加或编辑 → 凭据与模型 → 测试草稿 → 保存。测试不会改动已保存的配置。" />

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="服务列表" Style="{StaticResource SectionTitle}" />
                                    <Button HorizontalAlignment="Right" Content="添加服务"
                                            Style="{StaticResource PrimaryButton}" Padding="16,7"
                                            Click="AddProfile_Click" />
                                </Grid>

                                <Border Background="{DynamicResource InputBrush}" CornerRadius="10"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Padding="6" MinHeight="64">
                                    <Grid>
                                        <StackPanel x:Name="ProfilesEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Margin="24" Visibility="Collapsed">
                                            <TextBlock Text="还没有配置任何服务" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <ListBox x:Name="ProfilesListBox" MaxHeight="200"
                                                 MouseDoubleClick="ProfilesListBox_DoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Protocol}" FontSize="11.5"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <TextBlock Text="{Binding Models}" FontSize="11.5"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Style="{StaticResource StatusPill}" Padding="7,2"
                                                                    Background="{DynamicResource AccentSoftBrush}"
                                                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                                                    Visibility="{Binding IsDefaultBadge}">
                                                                <TextBlock Text="默认" FontSize="10.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource StatusPill}" Padding="7,2"
                                                                    Margin="6,0,0,0"
                                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                                                                <TextBlock Text="{Binding Kind}" FontSize="10.5"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock x:Name="ProfileHintText" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center"
                                               Text="选中新服务后编辑；「设为默认」立即应用到翻译链路。" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GhostButton}" Content="设为默认"
                                                Click="ActivateProfile_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="编辑"
                                                Margin="6,0,0,0" Click="EditProfile_Click" />
                                        <Button Style="{StaticResource DangerButton}" Content="删除服务"
                                                Margin="6,0,0,0" Click="DeleteProfile_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ServiceEditorTitle" Text="编辑服务"
                                           Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                                <StackPanel x:Name="WizardStrip" Orientation="Horizontal" Margin="0,0,0,14"
                                            Visibility="Collapsed">
                                    <Border Style="{StaticResource StatusPill}" Padding="9,3"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}">
                                        <TextBlock x:Name="WizardStepText" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Text="第 1/3 步 · 选择服务类型" />
                                    </Border>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="ServiceNameGroup" Margin="0,0,8,0">
                                        <TextBlock Text="服务名称" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ServiceNameTextBox"
                                                 local:Ui.Placeholder="例如 公司中转 / 我的 Gemini" />
                                    </StackPanel>
                                    <StackPanel x:Name="ProtocolGroup" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="接口协议" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ProviderTypeComboBox"
                                                  SelectionChanged="ProviderTypeComboBox_SelectionChanged">
                                            <ComboBoxItem Tag="OpenAiCompatible">OpenAI 兼容 · Chat Completions（推荐）</ComboBoxItem>
                                            <ComboBoxItem Tag="OpenAiResponses">OpenAI · Responses API</ComboBoxItem>
                                            <ComboBoxItem Tag="AnthropicMessages">Anthropic · Messages</ComboBoxItem>
                                            <ComboBoxItem Tag="GeminiGenerateContent">Google · generateContent</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="ModelsGroup" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="文本模型" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TextModelTextBox"
                                                 local:Ui.Placeholder="例如 gpt-4o-mini" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="视觉模型（可选）" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="VisionModelTextBox"
                                                 local:Ui.Placeholder="留空表示不使用视觉模型" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="CredentialGroup">
                                    <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                                     local:Ui.Placeholder="粘贴密钥；每个服务独立保存" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="清除"
                                                Style="{StaticResource DangerButton}" Click="ClearApiKey_Click" />
                                    </Grid>
                                    <TextBlock x:Name="ApiKeyStateText" Style="{StaticResource Caption}"
                                               Margin="0,7,0,0" />
                                </StackPanel>

                                <Grid Margin="0,18,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TestConnectionButton" Content="测试连接（草稿）"
                                                Click="TestConnection_Click" />
                                        <Button x:Name="SaveServiceButton" Content="保存服务"
                                                Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                                                Padding="18,9" Click="SaveService_Click" />
                                        <Button x:Name="CancelEditButton" Content="取消编辑"
                                                Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                                Click="CancelEdit_Click" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Content="快速预设"
                                            Style="{StaticResource GhostButton}" Click="TogglePresets_Click" />
                                </Grid>

                                <Grid x:Name="WizardNav" Margin="0,18,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="WizardBackButton" Content="上一步"
                                                Style="{StaticResource GhostButton}" Click="WizardBack_Click" />
                                        <Button x:Name="WizardNextButton" Margin="8,0,0,0" Content="下一步"
                                                Style="{StaticResource PrimaryButton}" Padding="18,9"
                                                Click="WizardNext_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="WizardSummary" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="560" />
                                </Grid>

                                <WrapPanel x:Name="PresetsPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Button Style="{StaticResource ChipButton}" Content="OpenAI"
                                            Tag="openai" Click="Preset_Click" />
                                    <Button Style="{StaticResource ChipButton}" Content="DeepSeek"
                                            Tag="deepseek" Click="Preset_Click" />
                                    <Button Style="{StaticResource ChipButton}" Content="Google Gemini"
                                            Tag="gemini" Click="Preset_Click" />
                                    <Button Style="{StaticResource ChipButton}" Content="Anthropic Claude"
                                            Tag="claude" Click="Preset_Click" />
                                    <Button Style="{StaticResource ChipButton}" Content="智谱 GLM"
                                            Tag="zhipu" Click="Preset_Click" />
                                    <Button Style="{StaticResource ChipButton}" Content="Ollama（本地）"
                                            Tag="ollama" Click="Preset_Click" />
                                </WrapPanel>

                                <Expander x:Name="AdvancedGroup" Margin="0,16,0,0" Header="高级：Base URL、Endpoint 与自定义请求头">
                                    <StackPanel>
                                        <TextBlock Text="API Base URL" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="BaseUrlTextBox"
                                                 local:Ui.Placeholder="https://api.openai.com/v1" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                   Text="必须使用 HTTPS；仅 localhost 与局域网地址允许 HTTP。" />

                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="文本 Endpoint" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="TextEndpointTextBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="视觉 Endpoint" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="VisionEndpointTextBox" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="自定义请求头" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="ExtraHeadersTextBox" Height="76" AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         FontFamily="{StaticResource MonoFontFamily}"
                                                         local:Ui.Placeholder="每行一个 Header: Value" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Anthropic Version" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="AnthropicVersionTextBox" />
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <CheckBox x:Name="SupportsTextCheckBox" Content="支持文本" />
                                                    <CheckBox x:Name="SupportsVisionCheckBox" Margin="20,0,0,0"
                                                              Content="支持图片" />
                                                </StackPanel>
                                                <CheckBox x:Name="AllowInsecureTlsCheckBox" Margin="0,12,0,0"
                                                          Content="允许自签名 TLS 证书" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="翻译行为" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,16" />

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="附带用法说明" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="让模型在译文外补充一句语气、歧义或术语提示" />
                                    </StackPanel>
                                    <ToggleButton x:Name="IncludeExplanationToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="保护代码标识符" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="翻译前遮蔽异常名、路径、命令与变量名，逐字节还原" />
                                    </StackPanel>
                                    <ToggleButton x:Name="ProtectTokensToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 6. OCR & privacy ========== -->
                    <StackPanel x:Name="CaptureSection" Visibility="Collapsed">
                        <TextBlock Text="OCR 与隐私" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="截图默认完全在本地识别；这里也是所有出网权限的唯一入口。" />

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="出网策略" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,16" />

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="安全离线模式" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="总开关：开启后无论其他设置如何，都不会有任何外发请求" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SafeModeToggle"
                                                  AutomationProperties.Name="安全离线模式" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="ProviderGate_Changed" Unchecked="ProviderGate_Changed" />
                                </Grid>

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="启用大模型网络翻译" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="关闭后所有模型请求会在发出前被拒绝（本地模型不受影响）" />
                                    </StackPanel>
                                    <ToggleButton x:Name="NetworkEnabledToggle"
                                                  AutomationProperties.Name="启用大模型网络翻译" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="ProviderGate_Changed" Unchecked="ProviderGate_Changed" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="内置免费引擎" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                                   Text="无需配置的备选引擎：会把待翻译文本发送到 Google 公共翻译服务（translate.googleapis.com），不含截图与凭据。" />
                                        <TextBlock x:Name="FreeEngineConsentState" Style="{StaticResource Caption}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="允许" Style="{StaticResource GhostButton}"
                                                Click="AllowFreeEngine_Click" />
                                        <Button Content="拒绝" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                                                Click="DenyFreeEngine_Click" />
                                        <Button Content="恢复询问" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                                                Click="ResetFreeEngineConsent_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="截图处理方式" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,12" />
                                <ComboBox x:Name="ModeComboBox"
                                          SelectionChanged="ModeComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="LocalOcr">本地 OCR + 文本模型（推荐，最快、最省 Token、零截图上传）</ComboBoxItem>
                                    <ComboBoxItem Tag="Auto">本地优先自动（默认本地 OCR，仅在授权后需要时走视觉模型）</ComboBoxItem>
                                    <ComboBoxItem Tag="VisionDirect">视觉模型直译（端到端多模态理解）</ComboBoxItem>
                                </ComboBox>

                                <Grid Style="{StaticResource SettingsRow}" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="允许在自动模式下上传截图" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="关闭后即使切换到视觉模型也不会上传图片" />
                                    </StackPanel>
                                    <ToggleButton x:Name="AllowImageUploadToggle"
                                                  AutomationProperties.Name="允许在自动模式下上传截图" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="ProviderGate_Changed" Unchecked="ProviderGate_Changed" />
                                </Grid>

                                <!-- Shows the route the core would actually take right now. -->
                                <Border Style="{StaticResource InlineCard}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="当前实际线路" Style="{StaticResource FieldLabel}"
                                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <Border x:Name="RouteBadge" Style="{StaticResource StatusPill}"
                                                    Padding="8,2" Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource AccentBorderBrush}">
                                                <TextBlock x:Name="RouteBadgeText" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" Text="本地 OCR" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="RoutePreviewText" TextWrapping="Wrap"
                                                   FontSize="12.5" LineHeight="20"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Windows 本地 OCR" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="OcrStatusText" Margin="0,8,0,14" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                <Border Background="{DynamicResource InputBrush}" CornerRadius="10"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Padding="6">
                                    <ListBox x:Name="OcrLanguagesListBox" MaxHeight="180"
                                             IsHitTestVisible="False" />
                                </Border>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           Text="缺少语言包时：Windows 设置 → 时间和语言 → 语言和区域 → 对应语言的“语言选项” → 添加“光学字符识别”。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 7. Data & advanced ========== -->
                    <StackPanel x:Name="DataSection" Visibility="Collapsed">
                        <TextBlock Text="数据与高级" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="历史与生词只保存在本机；删除操作不可撤销。" />

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="本地数据" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,16" />

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="保存本地翻译历史" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="最多 200 条，保留 90 天；疑似密钥与过大内容不记录" />
                                    </StackPanel>
                                    <ToggleButton x:Name="HistoryEnabledToggle"
                                                  AutomationProperties.Name="保存本地翻译历史" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="清空全部历史记录" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="删除 history.json 中的全部记录，不可恢复" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="清空历史"
                                            Style="{StaticResource DangerButton}" Click="ClearHistory_Click" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="清空生词本" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="删除全部生词与收藏，不可恢复" />
                                    </StackPanel>
                                    <Button Content="清空生词本" Style="{StaticResource DangerButton}"
                                            Click="ClearVocabulary_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="高级" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,12" />
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Base URL、Endpoint、自定义请求头与 TLS 证书选项位于「服务 → 编辑服务 → 高级」中，按服务独立保存。导出入口在「资料库」页。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ==================== Footer ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Padding="34,13">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="4"
                                Background="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusTextBlock" Margin="9,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" MaxWidth="640"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="就绪" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="放弃修改" Style="{StaticResource GhostButton}"
                                Padding="14,9" Click="Revert_Click" />
                        <Button x:Name="SaveButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                                Padding="24,9" Content="保存设置" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
