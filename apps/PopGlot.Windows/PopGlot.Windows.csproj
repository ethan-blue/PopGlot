<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PopGlot</AssemblyName>
    <RootNamespace>PopGlot.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup>
    <RustCargo>$(USERPROFILE)\.cargo\bin\cargo.exe</RustCargo>
    <RustTargetDir>$(MSBuildProjectDirectory)\..\..\target</RustTargetDir>
    <RustProfile>debug</RustProfile>
    <RustProfileArg></RustProfileArg>
    <RustProfile Condition="'$(Configuration)' == 'Release'">release</RustProfile>
    <RustProfileArg Condition="'$(Configuration)' == 'Release'">--release</RustProfileArg>
  </PropertyGroup>

  <Target Name="BuildRustCore" BeforeTargets="Build">
    <Exec Command="&quot;$(RustCargo)&quot; build --locked -p popglot-ffi $(RustProfileArg)" WorkingDirectory="$(MSBuildProjectDirectory)\..\.." />
  </Target>

  <Target Name="CopyRustCore" AfterTargets="BuildRustCore">
    <Copy SourceFiles="$(RustTargetDir)\$(RustProfile)\popglot_ffi.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
