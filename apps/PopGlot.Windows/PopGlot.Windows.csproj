<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PopGlot</AssemblyName>
    <RootNamespace>PopGlot.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/PopGlot-v3.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PopGlot.Windows.LogicTests" />
    <Resource Include="Assets/PopGlot-v3.ico" />
    <Resource Include="Assets/popglot-app-avatar-v3.png" />
    <None Include="Assets/popglot-mark-selected-source.png" />
    <None Include="Assets/popglot-mark-v2.svg" />
  </ItemGroup>

  <PropertyGroup>
    <RustCargo>$(USERPROFILE)\.cargo\bin\cargo.exe</RustCargo>
    <RustTargetDir>$(MSBuildProjectDirectory)\..\..\target</RustTargetDir>
    <RustProfile>debug</RustProfile>
    <RustProfileArg></RustProfileArg>
    <RustProfile Condition="'$(Configuration)' == 'Release'">release</RustProfile>
    <RustProfileArg Condition="'$(Configuration)' == 'Release'">--release</RustProfileArg>
  </PropertyGroup>

  <Target Name="BuildRustCore" BeforeTargets="Build">
    <Exec Command="&quot;$(RustCargo)&quot; build --locked -p popglot-ffi $(RustProfileArg)" WorkingDirectory="$(MSBuildProjectDirectory)\..\.." />
  </Target>

  <Target Name="CopyRustCore" AfterTargets="BuildRustCore">
    <Copy SourceFiles="$(RustTargetDir)\$(RustProfile)\popglot_ffi.dll" DestinationFolder="$(OutDir)" />
  </Target>

  <Target Name="CopyRustCoreToPublish" AfterTargets="Publish"
          Condition="Exists('$(RustTargetDir)\$(RustProfile)\popglot_ffi.dll')">
    <Copy SourceFiles="$(RustTargetDir)\$(RustProfile)\popglot_ffi.dll" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
