<!--
    PopGlot control templates.

    Every stock WPF control that appears in the app is templated here. The
    previous build styled only colours, so ComboBox popups, scroll bars, check
    boxes and expanders kept their Aero look and ignored the palette entirely —
    a ComboBox even hard-coded a light background so its text stayed readable.
    Templates bind to the DynamicResource tokens owned by ThemeService, so a
    theme switch restyles open windows without recreating them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PopGlot.Windows">

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Surface system: controls 6px, panes/cards 10px, floating windows 12px. -->
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="PaneRadius">10</CornerRadius>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- ==================== Window Caption Icons ==================== -->
    <Geometry x:Key="IconCaptionMin">M 0,5 H 10</Geometry>
    <Geometry x:Key="IconCaptionMax">M 1,1 H 9 V 9 H 1 Z</Geometry>
    <Geometry x:Key="IconCaptionRestore">M 3,1 H 9 V 7 H 7 M 1,3 H 7 V 9 H 1 Z</Geometry>
    <Geometry x:Key="IconCaptionClose">M 1.5,1.5 L 8.5,8.5 M 8.5,1.5 L 1.5,8.5</Geometry>

